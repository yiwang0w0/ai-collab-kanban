-		return fmt.Errorf("prepare Improve Kandev contribution destination: canonical provider ID is inconsistent")
-	}
-	if err := p.reconcileProviderRepoID(ctx, repositoryAt(repositories, index), providerRepoID); err != nil {
-		return err
