+func TestPoolProjectionHTTPConfigurationChangesDoNotTurnOldApprovalIntoNewWork(t *testing.T) {
+	for _, change := range []string{"移除池配置", "切换阶段执行者"} {
+		t.Run(change, func(t *testing.T) {
+			f := queuedPoolHistoryFixture(t)
