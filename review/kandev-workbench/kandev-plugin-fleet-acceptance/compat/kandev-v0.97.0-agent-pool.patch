+// GetTask retrieves a task by ID and populates repositories
+func (s *Service) GetTask(ctx context.Context, id string) (*models.Task, error) {
+	if err := s.authorizeTaskID(ctx, id); err != nil {
+		return nil, err
+	}
+	task, err := s.tasks.GetTask(ctx, id)
