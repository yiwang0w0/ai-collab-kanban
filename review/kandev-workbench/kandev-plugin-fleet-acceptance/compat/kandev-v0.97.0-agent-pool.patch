+import { describe, expect, it } from "vitest";
+import { parseStartupPage, mapUserSettingsData } from "./ssr/user-settings";
+import { resolveStartupListingRedirect } from "./startup-page";
+import { resolveHomeHref } from "./navigation/workspace-home";
+import type { StartupPage } from "./types/http-user-settings";
+
+describe("可选原生任务指挥入口", () => {
+  it("原生设置读取保留任务指挥入口和原看板偏好", () => {
+    expect(parseStartupPage("task_pool")).toBe("task_pool");
+    const settings = mapUserSettingsData({ startup_page: "task_pool", kanban_view_mode: "kanban" });
+    expect(settings.startupPage).toBe("task_pool");
+    expect(settings.kanbanViewMode).toBe("kanban");
+  });
+  it("已有工作区可直达任务指挥，但保留显式任务及概览意图", () => {
+    const input = {
+      startupPage: "task_pool" as StartupPage,
+      preferredView: "kanban" as const,
+      workspaceId: "workspace",
+      searchParams: new URLSearchParams(),
+    };
+    expect(resolveStartupListingRedirect(input)).toBe("/task-pool");
+    expect(
+      resolveHomeHref({
+        workspaceId: "workspace",
+        inOffice: false,
+        startupPage: "task_pool" as StartupPage,
+      }),
+    ).toBe("/task-pool");
+    for (const query of ["taskId=task", "sessionId=session", "workflowId=flow", "home=overview"])
+      expect(
+        resolveStartupListingRedirect({ ...input, searchParams: new URLSearchParams(query) }),
+      ).toBeNull();
+    expect(resolveStartupListingRedirect({ ...input, workspaceId: undefined })).toBeNull();
+    expect(
+      resolveHomeHref({
+        workspaceId: "office",
+        inOffice: true,
+        startupPage: "task_pool" as StartupPage,
+      }),
+    ).not.toBe("/task-pool");
+  });
+});
diff --git b/apps/web/lib/task-pool-view-model.test.ts b/apps/web/lib/task-pool-view-model.test.ts
new file mode 100644
index 0000000..2321d39
--- /dev/null
+++ b/apps/web/lib/task-pool-view-model.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from "vitest";
+import type { PoolCard, PoolExecution } from "./types/task-pool";
+import {
+  poolCategory,
+  poolTimeline,
+  poolCardTimes,
+  poolFreshness,
+  poolReasonGroup,
+  poolPageChildren,
+} from "./task-pool-view-model";
+
+function card(state?: PoolExecution["state"], reason = "") {
+  return {
+    task_id: "task",
+    title: "修复回调",
+    workflow_id: "flow",
+    workflow_step_id: "step",
+    stage: "实施",
+    task_state: "IN_PROGRESS",
+    eligibility: { state: "occupied", reason },
+    relations: { parent_id: "", child_count: 0, depends_on_count: 0, blocks_count: 0 },
+    pool_execution: state ? { state, current: true } : null,
+  } as PoolCard;
+}
+
+describe("任务池只呈现已核实的原生事实", () => {
+  it("撤回归待处理，回执时刻不显示成停止或验收完成", () => {
+    const value = card("withdrawn");
+    value.pool_execution!.ended_at = "2026-10-20T00:00:03Z";
+    expect(poolCategory(value)).toBe("attention");
+    expect(poolTimeline(value.pool_execution).map((point) => point.kind)).toEqual(["withdrawn"]);
+    expect(poolReasonGroup("pool_withdrawn")).toBe("withdrawn");
+  });
+  it("复用当前有界页面的直接子卡，不把其他父卡或自身当作子卡", () => {
+    const child = {
+      ...card(),
+      task_id: "child",
+      relations: { ...card().relations, parent_id: "parent" },
+    };
+    expect(poolPageChildren([child, { ...child, task_id: "parent" }, card()], "parent")).toEqual([
+      child,
+    ]);
+  });
+  it("未批准和未知证据归待处理，不把阶段当执行状态", () => {
+    expect(poolCategory(card())).toBe("attention");
+    expect(poolCategory(card("unknown"))).toBe("attention");
+    expect(poolCategory(card("queued"))).toBe("pool");
+    expect(poolCategory(card("claimed"))).toBe("running");
+    expect(poolCategory(card("started"))).toBe("running");
+  });
+  it("回合结束与运行结束不等于主卡完成", () => {
+    expect(poolCategory(card("turn_ended"))).toBe("review");
+    expect(poolCategory(card("ended"))).toBe("review");
+    expect(poolCategory(card("turn_failed"))).toBe("attention");
+    expect(poolCategory(card("stopped"))).toBe("attention");
+  });
+  it("只使用本次尝试已存在的有效时间，不以领取或任务活动补造开工", () => {
+    const execution = {
+      ...card("claimed").pool_execution!,
+      released_at: "2026-10-20T01:00:00Z",
+      queued_at: "2026-10-20T01:00:01Z",
+      claimed_at: "2026-10-20T01:00:02.123456789Z",
+      started_at: null,
+      ended_at: "bad",
+    };
+    expect(poolTimeline(execution).map((point) => point.kind)).toEqual([
+      "released",
+      "queued",
+      "claimed",
+    ]);
+    expect(poolCardTimes(execution).map((point) => point.kind)).toEqual(["queued", "claimed"]);
+    expect(poolTimeline(null)).toEqual([]);
+  });
+  it("请求错误、断线和超过三十秒的旧快照均不等于空池", () => {
+    expect(poolFreshness(null, 50_000, false, false)).toBe("loading");
+    expect(poolFreshness(null, 50_000, false, true)).toBe("unavailable");
+    expect(poolFreshness(10_000, 39_999, true, false)).toBe("fresh");
+    expect(poolFreshness(10_000, 40_000, true, false)).toBe("stale");
+    expect(poolFreshness(39_000, 40_000, false, false)).toBe("stale");
+    expect(poolFreshness(39_000, 40_000, true, true)).toBe("stale");
+  });
+  it("未知原因失败关闭，依赖与消耗确认给出不同说明", () => {
+    expect(poolReasonGroup("dependencies_unresolved")).toBe("dependencies");
+    expect(poolReasonGroup("cli_quota_confirmation_required")).toBe("approval");
+    expect(poolReasonGroup("new_reason_from_server")).toBe("evidence");
+    expect(poolReasonGroup("history_cleaned")).toBe("history");
+  });
+});
diff --git b/apps/web/lib/task-pool-view-model.ts b/apps/web/lib/task-pool-view-model.ts
new file mode 100644
index 0000000..88a961a
--- /dev/null
+++ b/apps/web/lib/task-pool-view-model.ts
@@ -0,0 +1,85 @@
+import type { PoolCard, PoolExecution } from "./types/task-pool";
+
+export function poolPageChildren(cards: PoolCard[], parentId: string): PoolCard[] {
+  return cards.filter((card) => card.task_id !== parentId && card.relations.parent_id === parentId);
+}
+import { parseTurnTimestamp } from "@/lib/state/slices/session/turn-actions";
+
+export type PoolCategory = "attention" | "pool" | "running" | "review";
+export type PoolFilters = { query: string; workflow: string; agent: string };
+export type PoolTimelinePoint = { kind: string; at: string };
+
+export const POOL_CATEGORIES: PoolCategory[] = ["attention", "pool", "running", "review"];
+
+export function poolCategory(card: PoolCard): PoolCategory {
+  const execution = card.pool_execution;
+  if (!execution || execution.state === "unknown") return "attention";
+  if (["turn_ended", "ended"].includes(execution.state)) return "review";
+  if (!execution.current) return "attention";
+  if (["released", "queued"].includes(execution.state)) return "pool";
+  if (["claimed", "started"].includes(execution.state)) return "running";
+  return "attention";
+}
+
+const TIMELINE_FIELDS = [
+  ["released", "released_at"],
+  ["queued", "queued_at"],
+  ["claimed", "claimed_at"],
+  ["started", "started_at"],
+  ["turn_ended", "turn_ended_at"],
+  ["stopped", "stopped_at"],
+  ["ended", "ended_at"],
+] as const;
+
+export function poolTimeline(execution: PoolExecution | null): PoolTimelinePoint[] {
+  if (!execution) return [];
+  return TIMELINE_FIELDS.flatMap(([kind, field]) => {
+    const at = execution[field];
+    const label = kind === "ended" && execution.state === "withdrawn" ? "withdrawn" : kind;
+    return at && parseTurnTimestamp(at) !== null ? [{ kind: label, at }] : [];
+  });
+}
+
+export function poolCardTimes(execution: PoolExecution | null): PoolTimelinePoint[] {
+  return poolTimeline(execution).slice(-2);
+}
+
+export function poolFreshness(
+  confirmed: number | null,
+  now: number,
+  connected: boolean,
+  error: boolean,
+) {
+  if (confirmed === null) return error ? "unavailable" : "loading";
+  if (error || !connected || now - confirmed >= 30_000) return "stale";
+  return "fresh";
+}
+
+const REASON_GROUPS: Record<string, string> = {
+  pool_withdrawn: "withdrawn",
+  dependencies_unresolved: "dependencies",
+  cli_quota_confirmation_required: "approval",
+  pool_execution_capability_unavailable: "capability",
+  pool_stage_not_configured: "configuration",
+  pool_step_configuration_invalid: "configuration",
+  pool_stage_configuration_changed: "configuration",
+  task_not_admitted: "admission",
+  release_not_queued: "dispatch",
+  pool_execution_pending: "occupied",
+  native_admission_required: "revalidation",
+  history_cleaned: "history",
+};
+
+export function poolReasonGroup(reason: string) {
+  return REASON_GROUPS[reason] ?? "evidence";
+}
+
+export function matchesPoolFilters(card: PoolCard, filters: PoolFilters) {
+  return (
+    card.title.toLocaleLowerCase().includes(filters.query.trim().toLocaleLowerCase()) &&
+    (filters.workflow === "all" || card.workflow_id === filters.workflow) &&
+    (filters.agent === "all" ||
+      card.pool_execution?.claimed_agent_profile_id === filters.agent ||
+      card.pool_execution?.planned_agent_profile_id === filters.agent)
+  );
+}
