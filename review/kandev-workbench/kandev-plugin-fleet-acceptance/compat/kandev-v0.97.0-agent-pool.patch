+++ b/apps/backend/internal/task/poolhistory/work_evidence.go
@@ -0,0 +1,41 @@
+package poolhistory
+
+import runsmodels "github.com/kandev/kandev/internal/runs/models"
+
+func readWorkEvidence(group receiptGroup, evidence *executionEvidence) error {
+	allocation := *evidence.Allocation
+	bound, _, err := uniqueReceipt(group[runsmodels.PoolExecutionBound], func(identity runsmodels.PoolExecutionIdentity) bool {
+		expected, valid := receiptActivity(identity, allocation.AgentType, "").TurnEndIdentity(allocation)
+		return valid && expected == identity
+	})
+	if err != nil {
+		return err
+	}
+	evidence.Bound = bound
+	work, event, err := uniqueReceipt(group[runsmodels.PoolWorkObserved], func(receipt runsmodels.PoolWorkReceipt) bool {
+		expected, valid := receiptActivity(receipt.PoolExecutionIdentity, allocation.AgentType, receipt.StartedSource).ReceiptIdentity(allocation)
+		return bound != nil && valid && expected == receipt.PoolExecutionIdentity && *bound == expected
+	})
+	if err != nil {
+		return err
+	}
+	evidence.Work, evidence.WorkEvent = work, event
+	return nil
+}
+
+func readTurnEvidence(group receiptGroup, evidence *executionEvidence) error {
+	allocation := *evidence.Allocation
+	turn, event, err := uniqueReceipt(group[runsmodels.PoolTurnEnded], func(receipt runsmodels.PoolTurnEndReceipt) bool {
+		expected, valid := receiptActivity(receipt.PoolExecutionIdentity, allocation.AgentType, "").TurnEndIdentity(allocation)
+		if !valid || expected != receipt.PoolExecutionIdentity ||
+			(receipt.Outcome != runsmodels.PoolTurnCompleted && receipt.Outcome != runsmodels.PoolTurnFailed) {
+			return false
+		}
+		return evidence.Bound == nil || *evidence.Bound == expected
+	})
+	if err != nil {
+		return err
+	}
+	evidence.Turn, evidence.TurnEvent = turn, event
+	return nil
+}
diff --git b/apps/backend/internal/task/poolview/eligibility.go b/apps/backend/internal/task/poolview/eligibility.go
new file mode 100644
index 0000000..d592fa6
--- /dev/null
+++ b/apps/backend/internal/task/poolview/eligibility.go
@@ -0,0 +1,42 @@
+package poolview
+
+func projectEligibility(card Card, context CardContext) Eligibility {
+	if card.PoolExecution != nil && card.PoolExecution.State == stateUnknown {
+		return Eligibility{State: stateUnknown, Reason: card.PoolExecution.Reason}
+	}
+	if context.DependenciesBlocked {
+		return Eligibility{State: stateBlocked, Reason: "dependencies_unresolved"}
+	}
+	if !context.StepExists {
+		return Eligibility{State: stateUnknown, Reason: "workflow_step_unavailable"}
+	}
+	if context.InvalidPoolConfig {
+		return Eligibility{State: stateBlocked, Reason: "pool_step_configuration_invalid"}
+	}
+	if card.PoolExecution != nil && card.PoolExecution.ReleasedAt != nil &&
+		context.StepUpdatedAt.After(*card.PoolExecution.ReleasedAt) {
+		return Eligibility{State: "requires_revalidation", Reason: "pool_stage_configuration_changed"}
+	}
+	if !context.PoolConfigured {
+		return Eligibility{State: "not_applicable", Reason: "pool_stage_not_configured"}
+	}
+	if !context.WIPAdmitted || context.QueuedForStep {
+		return Eligibility{State: stateBlocked, Reason: "task_not_admitted"}
+	}
+	if context.Profile.ValidateProfile() != nil {
+		return Eligibility{State: stateBlocked, Reason: "pool_execution_capability_unavailable"}
+	}
+	if card.PoolExecution == nil {
+		return Eligibility{State: "approval_required", Reason: "cli_quota_confirmation_required"}
+	}
+	switch card.PoolExecution.State {
+	case "withdrawn":
+		return Eligibility{State: "requires_revalidation", Reason: "pool_withdrawn"}
+	case "released":
+		return Eligibility{State: "dispatch_pending", Reason: "release_not_queued"}
+	case "ended":
+		return Eligibility{State: "requires_revalidation", Reason: "native_admission_required"}
+	default:
+		return Eligibility{State: "occupied", Reason: "pool_execution_pending"}
+	}
+}
diff --git b/apps/backend/internal/task/poolview/model.go b/apps/backend/internal/task/poolview/model.go
new file mode 100644
index 0000000..724a549
--- /dev/null
+++ b/apps/backend/internal/task/poolview/model.go
@@ -0,0 +1,83 @@
+// Package poolview 提供工作区任务池的有界只读视图，不拥有执行状态或调度权。
+package poolview
+
+import (
+	"errors"
+	"time"
+
+	"github.com/kandev/kandev/internal/task/models"
+	"github.com/kandev/kandev/internal/task/poolhistory"
+)
+
+const (
+	stateUnknown = "unknown"
+	stateBlocked = "blocked"
+)
+
+var (
+	ErrInvalidQuery = errors.New("pool_projection_invalid_query")
+	ErrUnavailable  = errors.New("pool_projection_unavailable")
+)
+
+type Query struct {
+	Limit int
+	After string
+}
+
+type Cursor struct {
+	Version     int    `json:"version"`
+	WorkspaceID string `json:"workspace_id"`
+	AfterTaskID string `json:"after_task_id"`
+}
+
+type Card struct {
+	WorkspaceID    string            `json:"-" db:"workspace_id"`
+	TaskID         string            `json:"task_id" db:"task_id"`
+	Title          string            `json:"title" db:"title"`
+	WorkflowID     string            `json:"workflow_id" db:"workflow_id"`
+	WorkflowStepID string            `json:"workflow_step_id" db:"workflow_step_id"`
+	Stage          string            `json:"stage" db:"stage"`
+	TaskState      string            `json:"task_state" db:"task_state"`
+	PoolExecution  *poolhistory.Item `json:"pool_execution" db:"-"`
+	Eligibility    Eligibility       `json:"eligibility" db:"-"`
+	Relations      Relations         `json:"relations" db:"-"`
+}
+
+type Eligibility struct {
+	State  string `json:"state"`
+	Reason string `json:"reason"`
+}
+
+type Relations struct {
+	ParentID       string `json:"parent_id" db:"parent_id"`
+	ChildCount     int    `json:"child_count" db:"child_count"`
+	DependsOnCount int    `json:"depends_on_count" db:"depends_on_count"`
+	BlocksCount    int    `json:"blocks_count" db:"blocks_count"`
+}
+
+type CardContext struct {
+	Relations           Relations
+	DependenciesBlocked bool
+	StepExists          bool
+	StepUpdatedAt       time.Time
+	PoolConfigured      bool
+	InvalidPoolConfig   bool
+	WIPAdmitted         bool
+	QueuedForStep       bool
+	Profile             models.PoolExecutionCandidate
+}
+
+type Snapshot struct {
+	WorkspaceID string
+	Cards       []Card
+	Histories   map[string]*poolhistory.Snapshot
+	Contexts    map[string]CardContext
+	HasMore     bool
+}
+
+type Page struct {
+	WorkspaceID     string `json:"workspace_id"`
+	SnapshotVersion string `json:"snapshot_version"`
+	Items           []Card `json:"items"`
+	NextCursor      string `json:"next_cursor"`
+}
diff --git b/apps/backend/internal/task/poolview/project.go b/apps/backend/internal/task/poolview/project.go
new file mode 100644
index 0000000..54c0993
--- /dev/null
+++ b/apps/backend/internal/task/poolview/project.go
@@ -0,0 +1,64 @@
+package poolview
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+
+	"github.com/kandev/kandev/internal/task/poolhistory"
+)
+
+func Project(snapshot *Snapshot) (*Page, error) {
+	if snapshot == nil {
+		return nil, ErrUnavailable
+	}
+	page := &Page{WorkspaceID: snapshot.WorkspaceID, Items: make([]Card, 0, len(snapshot.Cards))}
+	for _, card := range snapshot.Cards {
+		projected, err := projectCard(snapshot, card)
+		if err != nil {
+			return nil, err
+		}
+		page.Items = append(page.Items, projected)
+	}
+	if snapshot.HasMore && len(page.Items) != 0 {
+		encoded, err := json.Marshal(Cursor{Version: 1, WorkspaceID: snapshot.WorkspaceID,
+			AfterTaskID: page.Items[len(page.Items)-1].TaskID})
+		if err != nil {
+			return nil, err
+		}
+		page.NextCursor = base64.RawURLEncoding.EncodeToString(encoded)
+	}
+	encoded, err := json.Marshal(page)
+	if err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256(encoded)
+	page.SnapshotVersion = hex.EncodeToString(digest[:])
+	return page, nil
+}
+
+func projectCard(snapshot *Snapshot, card Card) (Card, error) {
+	card.PoolExecution = nil
+	if history := snapshot.Histories[card.TaskID]; history != nil {
+		if history.TaskID != card.TaskID || history.WorkspaceID != snapshot.WorkspaceID {
+			return Card{}, ErrUnavailable
+		}
+		projected, err := poolhistory.Project(history)
+		if err != nil || len(projected.Items) != 1 || len(history.Entries) != 1 {
+			return Card{}, ErrUnavailable
+		}
+		card.PoolExecution = &projected.Items[0]
+		entry := history.Entries[0]
+		if entry.ID != history.LatestEntryID || entry.WorkflowID != card.WorkflowID || entry.StepID != card.WorkflowStepID {
+			card.PoolExecution.State, card.PoolExecution.Reason, card.PoolExecution.Current = stateUnknown, "current_stage_unverified", false
+		}
+	}
+	context, ok := snapshot.Contexts[card.TaskID]
+	if !ok {
+		card.Eligibility = Eligibility{State: stateUnknown, Reason: "context_unavailable"}
+		return card, nil
+	}
+	card.Relations, card.Eligibility = context.Relations, projectEligibility(card, context)
+	return card, nil
+}
diff --git b/apps/backend/internal/task/poolview/query.go b/apps/backend/internal/task/poolview/query.go
new file mode 100644
index 0000000..166c09a
--- /dev/null
+++ b/apps/backend/internal/task/poolview/query.go
@@ -0,0 +1,41 @@
+package poolview
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+
+	"github.com/kandev/kandev/internal/task/poolhistory"
+)
+
+func ParseQuery(workspaceID string, limit int, cursor string) (Query, error) {
+	query := Query{Limit: limit}
+	if workspaceID == "" || len(workspaceID) > 256 || limit < 0 || limit > poolhistory.MaxItems || len(cursor) > 1024 {
+		return Query{}, ErrInvalidQuery
+	}
+	if query.Limit == 0 {
+		query.Limit = poolhistory.MaxItems
+	}
+	if cursor == "" {
+		return query, nil
+	}
+	encoded, err := base64.RawURLEncoding.DecodeString(cursor)
+	if err != nil {
+		return Query{}, ErrInvalidQuery
+	}
+	var position Cursor
+	if json.Unmarshal(encoded, &position) != nil || !position.validFor(workspaceID) {
+		return Query{}, ErrInvalidQuery
+	}
+	canonical, err := json.Marshal(position)
+	if err != nil || !bytes.Equal(encoded, canonical) {
+		return Query{}, ErrInvalidQuery
+	}
+	query.After = position.AfterTaskID
+	return query, nil
+}
+
+func (position Cursor) validFor(workspaceID string) bool {
+	return position.Version == 1 && position.WorkspaceID == workspaceID &&
+		position.AfterTaskID != "" && len(position.AfterTaskID) <= 256
+}
