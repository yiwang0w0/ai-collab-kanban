+	agentClient, releaseClient := execution.AcquireAgentCtlClient()
+	defer releaseClient()
+	if agentClient == nil {
+		return nil, nil
+	}
+	return agentClient.GitLog(ctx, baseCommit, limit, targetBranch, "")
