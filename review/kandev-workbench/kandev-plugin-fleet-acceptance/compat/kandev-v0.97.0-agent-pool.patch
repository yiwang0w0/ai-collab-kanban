+	stored, err := f.repo.GetTask(context.Background(), f.task.ID)
+	if err != nil || stored.WorkflowStepID != f.step.ID || stored.Title != f.task.Title || stored.Metadata["sentinel"] != "keep" {
+		t.Fatalf("应该保留同一张原生主卡: %+v %v", stored, err)
