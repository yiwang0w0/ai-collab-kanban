-type ActorKind string
-
-const (
-	ActorHuman       ActorKind = "human"
-	ActorAgent       ActorKind = "agent"
-	ActorSystem      ActorKind = "system"
-	ActorIntegration ActorKind = "integration"
-	ActorUnknown     ActorKind = "unknown"
-)
-
