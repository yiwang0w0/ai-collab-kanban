index 0000000..6253369
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_causal_events.go
@@ -0,0 +1,15 @@
+package sqlite
+
+// 选中领取的完整凭证，加首轮准入、最后池事件及每次准入前的排队原因。
+// 每个因果边只取一个原生事件，不能按时间戳猜轮次或加载全部历史日志。
+const poolCausalEventScopeSQL = `(
+	CASE WHEN json_valid(e.payload) THEN
+		(json_type(e.payload,'$.claim_id') IS NOT 'text' OR json_extract(e.payload,'$.claim_id')='' OR json_extract(e.payload,'$.claim_id') IN (?))
+		ELSE 1 END
+	OR e.seq=(SELECT first.seq FROM run_events first WHERE first.run_id=e.run_id AND first.event_type='pool.launch-admitted.v1' ORDER BY first.seq LIMIT 1)
+	OR e.seq=(SELECT last.seq FROM run_events last WHERE last.run_id=e.run_id AND last.event_type LIKE 'pool.%' ORDER BY last.seq DESC LIMIT 1)
+	OR e.seq IN (SELECT (SELECT prior.seq FROM run_events prior WHERE prior.run_id=e.run_id
+		AND prior.event_type LIKE 'pool.%' AND prior.seq<intent.seq ORDER BY prior.seq DESC LIMIT 1)
+		FROM run_events intent WHERE intent.run_id=e.run_id AND intent.event_type='pool.launch-admitted.v1'
+		AND CASE WHEN json_valid(intent.payload) THEN json_extract(intent.payload,'$.claim_id') IN (?) ELSE 0 END)
+)`
diff --git b/apps/backend/internal/task/repository/sqlite/pool_creation.go b/apps/backend/internal/task/repository/sqlite/pool_creation.go
new file mode 100644
index 0000000..74f2278
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_creation.go
@@ -0,0 +1,94 @@
+package sqlite
+
+import (
+	"context"
+	"time"
+
+	"github.com/jmoiron/sqlx"
+	"github.com/kandev/kandev/internal/db/dialect"
+	"github.com/kandev/kandev/internal/task/models"
+	"github.com/kandev/kandev/internal/task/repository/repoerrors"
+)
+
+// CommitPoolTaskCreation 在原生创建收尾后原子提交批准和外部身份结算，不补造中断请求的批准。
+func (r *Repository) CommitPoolTaskCreation(ctx context.Context, taskID string, version time.Time, externalID string) (bool, error) {
+	intent, ok := models.PoolReleaseIntentFromContext(ctx)
+	if !ok || !intent.Creating || intent.DeferCreation || intent.TaskID != taskID {
+		return false, repoerrors.ErrPoolReleaseConfirmationRequired
+	}
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return false, repoerrors.ErrPoolStorageUnsupported
+	}
+	tx, err := r.db.BeginTxx(ctx, nil)
+	if err != nil {
+		return false, err
+	}
+	defer func() { _ = tx.Rollback() }()
+	if err := r.lockTaskRepositoryReplacement(ctx, tx, taskID); err != nil {
+		return false, err
+	}
+	matched, err := r.checkPoolCreationSnapshot(ctx, tx, intent, version, externalID)
+	if err != nil || !matched {
+		return false, err
+	}
+	now := time.Now().UTC()
+	entryID, err := r.recordStepTransition(ctx, tx, stepTransitionInput{taskID: taskID,
+		toWorkflowID: intent.WorkflowID, toWorkflowStepID: intent.StepID, occurredAt: now})
+	if err != nil {
+		return false, err
+	}
+	if err := r.settlePoolCreationTx(ctx, tx, taskID, externalID, now); err != nil {
+		return false, err
+	}
+	if err := tx.Commit(); err != nil {
+		return false, err
+	}
+	r.dispatchStepEntry(ctx, taskID, intent.WorkflowID, intent.StepID, formatEntryID(entryID), 0)
+	return true, nil
+}
+
+func (r *Repository) settlePoolCreationTx(ctx context.Context, tx *sqlx.Tx, taskID, externalID string, now time.Time) error {
+	if externalID == "" {
+		return nil
+	}
+	settlement, err := tx.ExecContext(ctx, r.db.Rebind(`UPDATE tasks SET external_id_settled_at = ?
+		WHERE id = ? AND external_id = ? AND external_id_settled_at IS NULL`), now, taskID, externalID)
+	if err != nil {
+		return err
+	}
+	written, err := settlement.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if written != 1 {
+		return repoerrors.ErrTaskVersionConflict
+	}
+	return nil
+}
+
+func (r *Repository) checkPoolCreationSnapshot(ctx context.Context, tx *sqlx.Tx, intent models.PoolReleaseIntent,
+	version time.Time, externalID string) (bool, error) {
+	var workflowID, stepID, currentExternalID string
+	var currentVersion time.Time
+	var unsettled bool
+	err := tx.QueryRowContext(ctx, r.db.Rebind(`SELECT workflow_id, workflow_step_id, updated_at,
+		COALESCE(external_id, ''), external_id_settled_at IS NULL FROM tasks WHERE id = ?`), intent.TaskID).
+		Scan(&workflowID, &stepID, &currentVersion, &currentExternalID, &unsettled)
+	if err != nil {
+		return false, err
+	}
+	if currentExternalID != externalID {
+		return false, nil
+	}
+	if !version.Equal(currentVersion) || workflowID != intent.WorkflowID || stepID != intent.StepID || !unsettled {
+		return false, repoerrors.ErrTaskVersionConflict
+	}
+	var entered bool
+	if err := tx.QueryRowContext(ctx, r.db.Rebind(`SELECT EXISTS (SELECT 1 FROM task_step_transitions WHERE task_id = ?)`), intent.TaskID).Scan(&entered); err != nil {
+		return false, err
+	}
+	if entered {
+		return false, repoerrors.ErrPoolReleaseConfirmationRequired
+	}
+	return true, nil
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_dispatch_ready.go b/apps/backend/internal/task/repository/sqlite/pool_dispatch_ready.go
new file mode 100644
index 0000000..694d040
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_dispatch_ready.go
@@ -0,0 +1,99 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+	"github.com/kandev/kandev/internal/task/repository/repoerrors"
+	v1 "github.com/kandev/kandev/pkg/api/v1"
+)
+
+// CheckPoolReleaseReadyTx 不清理缺失的依赖；未知前置必须保留为阻塞事实。
+func (r *Repository) CheckPoolReleaseReadyTx(ctx context.Context, tx *sqlx.Tx, release runsmodels.PoolReleaseSnapshot) error {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return repoerrors.ErrPoolStorageUnsupported
+	}
+	return r.checkPoolTaskReadyTx(ctx, tx, release.TaskID, release.WorkspaceID, release.AgentProfileID, "")
+}
+
+// CheckPoolClaimReadyTx 仅在已验证领取的共享事务内排除当前运行，不排除会话或回合。
+func (r *Repository) CheckPoolClaimReadyTx(ctx context.Context, tx *sqlx.Tx, release runsmodels.PoolReleaseSnapshot, runID string) error {
+	if dialect.IsPostgres(r.db.DriverName()) || runID == "" {
+		return repoerrors.ErrPoolStorageUnsupported
+	}
+	return r.checkPoolTaskReadyTx(ctx, tx, release.TaskID, release.WorkspaceID, release.AgentProfileID, runID)
+}
+
+// CheckPoolRetryReadyTx 仅供已证明停止或已核对原生重试回执的协调器使用，不改主卡状态。
+func (r *Repository) CheckPoolRetryReadyTx(ctx context.Context, tx *sqlx.Tx, release runsmodels.PoolReleaseSnapshot, runID string) error {
+	if dialect.IsPostgres(r.db.DriverName()) || runID == "" {
+		return repoerrors.ErrPoolStorageUnsupported
+	}
+	if err := r.checkPoolDependenciesTx(ctx, tx, release.TaskID); err != nil {
+		return err
+	}
+	if err := r.checkPoolTaskInactiveTx(ctx, tx, release.TaskID, runID); err != nil {
+		return err
+	}
+	return r.checkPoolExecutionCandidateForRetryTx(ctx, tx, release.TaskID, release.WorkspaceID, release.AgentProfileID, true)
+}
+
+func (r *Repository) checkPoolTaskReadyTx(ctx context.Context, tx stepTransitionTx, taskID, workspaceID, profileID, allowedRunID string) error {
+	if err := r.checkPoolDependenciesTx(ctx, tx, taskID); err != nil {
+		return err
+	}
+	if err := r.checkPoolTaskInactiveTx(ctx, tx, taskID, allowedRunID); err != nil {
+		return err
+	}
+	return r.checkPoolExecutionCandidateTx(ctx, tx, taskID, workspaceID, profileID)
+}
+
+func (r *Repository) checkPoolDependenciesTx(ctx context.Context, tx stepTransitionTx, taskID string) error {
+	var blocked bool
+	err := tx.QueryRowContext(ctx, r.db.Rebind(`SELECT EXISTS (SELECT 1 FROM task_blockers b
+		LEFT JOIN tasks predecessor ON predecessor.id = b.blocker_task_id
+		WHERE b.task_id = ? AND (predecessor.id IS NULL OR predecessor.archived_at IS NOT NULL
+		OR predecessor.state <> ?))`), taskID, v1.TaskStateCompleted).Scan(&blocked)
+	if err != nil {
+		return err
+	}
+	if blocked {
+		return repoerrors.ErrPoolTaskNotAdmitted
+	}
+	return nil
+}
+
+func (r *Repository) checkPoolTaskInactiveTx(ctx context.Context, tx stepTransitionTx, taskID, allowedRunID string) error {
+	return r.checkPoolTaskActivityTx(ctx, tx, taskID, allowedRunID, "", "")
+}
+
+func (r *Repository) checkPoolTaskActivityTx(ctx context.Context, tx stepTransitionTx, taskID, allowedRunID, allowedSessionID, allowedTurnID string) error {
+	var runID string
+	err := tx.QueryRowContext(ctx, r.db.Rebind(`SELECT id FROM runs WHERE status IN ('queued', 'claimed')
+		AND idempotency_key LIKE ? AND json_extract(payload, '$.task_id') = ? AND id <> ? ORDER BY requested_at, id LIMIT 1`),
+		runsmodels.PoolDispatchKeyPrefix+"%", taskID, allowedRunID).Scan(&runID)
+	if err == nil {
+		return &runsmodels.PoolTaskBusyError{RunID: runID}
+	}
+	if !errors.Is(err, sql.ErrNoRows) {
+		return err
+	}
+	var active bool
+	err = tx.QueryRowContext(ctx, r.db.Rebind(`SELECT
+		EXISTS (SELECT 1 FROM task_sessions WHERE task_id = ? AND (? = '' OR id <> ?) AND COALESCE(state, '') NOT IN
+		  ('CREATED', 'IDLE', 'WAITING_FOR_INPUT', 'COMPLETED', 'FAILED', 'CANCELLED'))
+		OR EXISTS (SELECT 1 FROM task_session_turns WHERE task_id = ? AND (? = '' OR id <> ?) AND completed_at IS NULL)`),
+		taskID, allowedSessionID, allowedSessionID, taskID, allowedTurnID, allowedTurnID).Scan(&active)
+	if err != nil {
+		return err
+	}
+	if active {
+		return repoerrors.ErrPoolTaskNotAdmitted
+	}
+	return nil
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_execution_allocation.go b/apps/backend/internal/task/repository/sqlite/pool_execution_allocation.go
new file mode 100644
index 0000000..ae3e91c
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_execution_allocation.go
@@ -0,0 +1,63 @@
+package sqlite
+
+import (
+	"context"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+	"github.com/kandev/kandev/internal/task/models"
+	"github.com/kandev/kandev/internal/task/repository/repoerrors"
+	v1 "github.com/kandev/kandev/pkg/api/v1"
+)
+
+// CheckPoolExecutionAllocationTx 只排除这次实际分配的会话与回合，其他占用仍阻塞。
+func (r *Repository) CheckPoolExecutionAllocationTx(ctx context.Context, tx *sqlx.Tx, release runsmodels.PoolReleaseSnapshot, identity runsmodels.PoolExecutionIdentity) (string, error) {
+	if dialect.IsPostgres(r.db.DriverName()) || identity.TaskID != release.TaskID || identity.AgentProfileID != release.AgentProfileID {
+		return "", models.ErrPoolExecutionUnavailable
+	}
+	if err := r.checkPoolDependenciesTx(ctx, tx, identity.TaskID); err != nil {
+		return "", err
+	}
+	if err := r.checkPoolTaskActivityTx(ctx, tx, identity.TaskID, identity.RunID, identity.SessionID, identity.TurnID); err != nil {
+		return "", err
+	}
+	choice, err := r.poolProfileCandidateTx(ctx, tx, release.WorkspaceID, identity.AgentProfileID)
+	if err != nil {
+		return "", err
+	}
+	if err := r.loadPoolAllocatedExecutorTx(ctx, tx, identity, &choice); err != nil {
+		return "", err
+	}
+	if err := choice.Validate(); err != nil {
+		return "", err
+	}
+	var state v1.TaskState
+	if err := tx.GetContext(ctx, &state, tx.Rebind(`SELECT state FROM tasks WHERE id = ?`), identity.TaskID); err != nil {
+		return "", err
+	}
+	switch state {
+	case v1.TaskStateTODO, v1.TaskStateCreated, v1.TaskStateScheduling, v1.TaskStateReview, v1.TaskStateBlocked, v1.TaskStateWaitingForInput:
+		return choice.AgentFamily, nil
+	default:
+		return "", repoerrors.ErrPoolTaskNotAdmitted
+	}
+}
+
+func (r *Repository) loadPoolAllocatedExecutorTx(ctx context.Context, tx *sqlx.Tx, i runsmodels.PoolExecutionIdentity, choice *models.PoolExecutionCandidate) error {
+	err := tx.QueryRowContext(ctx, tx.Rebind(`SELECT e.type, e.status
+		FROM task_sessions s JOIN task_session_turns t ON t.task_session_id = s.id
+		JOIN executors_running er ON er.session_id = s.id AND er.task_id = s.task_id
+		JOIN executors e ON e.id = s.executor_id
+		WHERE s.id = ? AND t.id = ? AND s.task_id = ? AND t.task_id = ? AND s.agent_profile_id = ?
+		AND COALESCE(s.execution_profile_id, '') IN ('', ?) AND COALESCE(t.execution_profile_id, '') IN ('', ?)
+		AND er.agent_execution_id = ? AND er.execution_profile_id = ? AND er.executor_id = s.executor_id AND t.completed_at IS NULL
+		AND s.state IN ('CREATED', 'STARTING', 'WAITING_FOR_INPUT') AND e.deleted_at IS NULL`),
+		i.SessionID, i.TurnID, i.TaskID, i.TaskID, i.AgentProfileID, i.ExecutionProfileID, i.ExecutionProfileID, i.ExecutionID, i.ExecutionProfileID).Scan(
+		&choice.ExecutorType, &choice.ExecutorStatus)
+	if err != nil {
+		return models.ErrPoolExecutionUnavailable
+	}
+	return nil
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_execution_candidate.go b/apps/backend/internal/task/repository/sqlite/pool_execution_candidate.go
new file mode 100644
index 0000000..09370c5
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_execution_candidate.go
@@ -0,0 +1,108 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"strings"
+
+	"github.com/kandev/kandev/internal/task/models"
+	"github.com/kandev/kandev/internal/task/repository/repoerrors"
+	v1 "github.com/kandev/kandev/pkg/api/v1"
+)
+
+func (r *Repository) checkPoolExecutionCandidateTx(ctx context.Context, tx stepTransitionTx, taskID, workspaceID, profileID string) error {
+	return r.checkPoolExecutionCandidateForRetryTx(ctx, tx, taskID, workspaceID, profileID, false)
+}
+
+func (r *Repository) checkPoolExecutionCandidateForRetryTx(ctx context.Context, tx stepTransitionTx, taskID, workspaceID, profileID string, verifiedRetry bool) error {
+	choice, err := r.poolProfileCandidateTx(ctx, tx, workspaceID, profileID)
+	if err != nil {
+		return err
+	}
+	executorID, err := r.poolTaskExecutorIDTx(ctx, tx, taskID, workspaceID, profileID, verifiedRetry)
+	if err != nil {
+		return err
+	}
+	var deleted bool
+	err = tx.QueryRowContext(ctx, r.db.Rebind(`SELECT type, status, deleted_at IS NOT NULL FROM executors WHERE id = ?`),
+		executorID).Scan(&choice.ExecutorType, &choice.ExecutorStatus, &deleted)
+	if err != nil || deleted {
+		return models.ErrPoolExecutionUnavailable
+	}
+	return choice.Validate()
+}
+
+func (r *Repository) poolProfileCandidateTx(ctx context.Context, tx stepTransitionTx, workspaceID, profileID string) (models.PoolExecutionCandidate, error) {
+	choice := models.PoolExecutionCandidate{WorkspaceID: workspaceID}
+	var tuiConfig string
+	err := tx.QueryRowContext(ctx, r.db.Rebind(`SELECT p.id, p.agent_id, a.id, a.name,
+		COALESCE(p.workspace_id, ''), COALESCE(a.workspace_id, ''), COALESCE(p.enabled, 0), p.deleted_at IS NOT NULL,
+		COALESCE(p.provider_kind, ''), COALESCE(p.auto_fallback, 1), COALESCE(p.fallback_model, ''),
+		COALESCE(p.cli_passthrough, 0), COALESCE(p.execution_agent_profile_id, ''), COALESCE(a.tui_config, '')
+		FROM agent_profiles p JOIN agents a ON a.id = p.agent_id WHERE p.id = ?`), profileID).Scan(
+		&choice.AgentProfileID, &choice.ProfileAgentRecordID, &choice.AgentRecordID, &choice.AgentFamily,
+		&choice.ProfileWorkspaceID, &choice.AgentWorkspaceID, &choice.Enabled, &choice.Deleted, &choice.ProviderKind,
+		&choice.AutoFallback, &choice.FallbackModel, &choice.CLIPassthrough, &choice.ExecutionAgentProfileID, &tuiConfig)
+	if err != nil {
+		return choice, models.ErrPoolExecutionUnavailable
+	}
+	tuiConfig = strings.TrimSpace(tuiConfig)
+	choice.CustomTUI = tuiConfig != "" && tuiConfig != "null"
+	return choice, nil
+}
+
+func (r *Repository) poolTaskExecutorIDTx(ctx context.Context, tx stepTransitionTx, taskID, workspaceID, profileID string, verifiedRetry bool) (string, error) {
+	var rawMetadata, rawOverrides, workflowID, stepID, defaultExecutor string
+	var state v1.TaskState
+	err := tx.QueryRowContext(ctx, r.db.Rebind(`SELECT t.metadata, COALESCE(t.workflow_agent_overrides, ''),
+		t.workflow_id, t.workflow_step_id, t.state, COALESCE(w.default_executor_id, '')
+		FROM tasks t JOIN workspaces w ON w.id = t.workspace_id WHERE t.id = ? AND t.workspace_id = ?`), taskID, workspaceID).Scan(
+		&rawMetadata, &rawOverrides, &workflowID, &stepID, &state, &defaultExecutor)
+	if err != nil {
+		return "", repoerrors.ErrPoolTaskNotAdmitted
+	}
+	if state != v1.TaskStateTODO && state != v1.TaskStateCreated && state != v1.TaskStateReview &&
+		state != v1.TaskStateBlocked && state != v1.TaskStateWaitingForInput && !(verifiedRetry && state == v1.TaskStateInProgress) {
+		return "", repoerrors.ErrPoolTaskNotAdmitted
+	}
+	var metadata map[string]any
+	if json.Unmarshal([]byte(rawMetadata), &metadata) != nil || metadata[models.MetaKeyDeferredLaunch] != nil {
+		return "", repoerrors.ErrPoolTaskNotAdmitted
+	}
+	overrides, err := models.DecodeWorkflowAgentOverrides(rawOverrides)
+	if err != nil {
+		return "", models.ErrPoolExecutionUnavailable
+	}
+	if replacement, bound := overrides.ReplacementFor(workflowID, stepID); bound && replacement != profileID {
+		return "", models.ErrPoolExecutionUnavailable
+	}
+	return r.poolExecutorSelectionTx(ctx, tx, metadata, defaultExecutor)
+}
+
+func (r *Repository) poolExecutorSelectionTx(ctx context.Context, tx stepTransitionTx, metadata map[string]any, defaultExecutor string) (string, error) {
+	for _, key := range []string{models.MetaKeyExecutorID, models.MetaKeyExecutorProfileID} {
+		if value := metadata[key]; value != nil {
+			if _, ok := value.(string); !ok {
+				return "", models.ErrPoolExecutionUnavailable
+			}
+		}
+	}
+	executorID := strings.TrimSpace(models.StringFromAny(metadata[models.MetaKeyExecutorID]))
+	profileID := strings.TrimSpace(models.StringFromAny(metadata[models.MetaKeyExecutorProfileID]))
+	if profileID != "" {
+		var profileExecutorID string
+		if err := tx.QueryRowContext(ctx, r.db.Rebind(`SELECT executor_id FROM executor_profiles WHERE id = ?`), profileID).Scan(&profileExecutorID); err != nil ||
+			profileExecutorID == "" || (executorID != "" && executorID != profileExecutorID) {
+			return "", models.ErrPoolExecutionUnavailable
+		}
+		executorID = profileExecutorID
+	}
+	if executorID == "" {
+		executorID = strings.TrimSpace(defaultExecutor)
+	}
+	if executorID == "" {
+		return "", sql.ErrNoRows
+	}
+	return executorID, nil
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_execution_quiescent.go b/apps/backend/internal/task/repository/sqlite/pool_execution_quiescent.go
new file mode 100644
index 0000000..6ab45f7
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_execution_quiescent.go
@@ -0,0 +1,52 @@
+package sqlite
+
+import (
+	"context"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+	"github.com/kandev/kandev/internal/task/models"
+	"github.com/kandev/kandev/internal/task/repository/repoerrors"
+)
+
+// CheckPoolExecutionQuiescentTx 只核对原生数据库占用；调用者仍须证明本次执行已停止及宿主活动已释放。
+func (r *Repository) CheckPoolExecutionQuiescentTx(ctx context.Context, tx *sqlx.Tx, i runsmodels.PoolExecutionIdentity) error {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return repoerrors.ErrPoolStorageUnsupported
+	}
+	if i.PromptGeneration != 1 || i.AgentProfileID == "" || i.ExecutionProfileID != i.AgentProfileID {
+		return repoerrors.ErrPoolTaskNotAdmitted
+	}
+	var matched bool
+	err := tx.GetContext(ctx, &matched, tx.Rebind(`SELECT EXISTS (SELECT 1 FROM task_sessions s
+		JOIN task_session_turns t ON t.task_session_id = s.id JOIN tasks task ON task.id = s.task_id
+		WHERE s.id = ? AND t.id = ? AND s.task_id = ? AND t.task_id = ? AND s.agent_profile_id = ?
+		AND COALESCE(s.execution_profile_id, '') IN ('', ?) AND COALESCE(t.execution_profile_id, '') IN ('', ?)
+		AND s.executor_id = ? AND t.completed_at IS NOT NULL
+		AND s.state IN ('IDLE', 'WAITING_FOR_INPUT', 'COMPLETED', 'FAILED', 'CANCELLED'))`),
+		i.SessionID, i.TurnID, i.TaskID, i.TaskID, i.AgentProfileID, i.ExecutionProfileID, i.ExecutionProfileID, models.ExecutorIDWorktree)
+	if err != nil {
+		return err
+	}
+	if !matched {
+		return repoerrors.ErrPoolTaskNotAdmitted
+	}
+	if err := r.checkPoolStoppedInventoryTx(ctx, tx, i); err != nil {
+		return err
+	}
+	if err := r.checkPoolTaskActivityTx(ctx, tx, i.TaskID, i.RunID, i.SessionID, i.TurnID); err != nil {
+		return err
+	}
+	// checkout 字段由 Office 的原生 schema 所有；缺列或矛盾状态都是未知，不在此清理或补列。
+	var checkoutFree bool
+	if err := tx.GetContext(ctx, &checkoutFree, tx.Rebind(`SELECT COALESCE(checkout_agent_id, '') = ''
+		AND COALESCE(checkout_run_id, '') = '' AND checkout_at IS NULL FROM tasks WHERE id = ?`), i.TaskID); err != nil {
+		return err
+	}
+	if !checkoutFree {
+		return repoerrors.ErrPoolTaskNotAdmitted
+	}
+	return nil
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_history.go b/apps/backend/internal/task/repository/sqlite/pool_history.go
new file mode 100644
index 0000000..0574617
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_history.go
@@ -0,0 +1,87 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"time"
+
+	"github.com/jmoiron/sqlx"
+	"github.com/kandev/kandev/internal/db/dialect"
+	"github.com/kandev/kandev/internal/steptelemetry"
+	"github.com/kandev/kandev/internal/task/poolhistory"
+	"github.com/kandev/kandev/internal/task/repository/repoerrors"
+)
+
+// PoolHistoryWorkspace 只读取权限定位所需的字段，不水合任务正文或会话。
+func (r *Repository) PoolHistoryWorkspace(ctx context.Context, taskID string) (string, error) {
+	var workspaceID string
+	err := r.ro.GetContext(ctx, &workspaceID, r.ro.Rebind(`SELECT workspace_id FROM tasks WHERE id=?`), taskID)
+	if err == sql.ErrNoRows {
+		return "", repoerrors.ErrTaskNotFound
+	}
+	return workspaceID, err
+}
+
+func (r *Repository) ReadPoolHistorySnapshot(ctx context.Context, taskID, workspaceID string, query poolhistory.Query) (*poolhistory.Snapshot, error) {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return nil, repoerrors.ErrPoolStorageUnsupported
+	}
+	if query.Limit < 1 || query.Limit > poolhistory.MaxItems || query.Before < 0 {
+		return nil, poolhistory.ErrInvalidQuery
+	}
+	tx, err := r.ro.BeginTxx(ctx, &sql.TxOptions{ReadOnly: true})
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = tx.Rollback() }()
+	var header struct {
+		LatestEntryID int64     `db:"latest_entry_id"`
+		WorkflowID    string    `db:"workflow_id"`
+		StepID        string    `db:"step_id"`
+		ActivatedAt   time.Time `db:"activated_at"`
+	}
+	if err := tx.GetContext(ctx, &header, tx.Rebind(`SELECT COALESCE((SELECT MAX(id) FROM task_step_transitions WHERE task_id=t.id),0) AS latest_entry_id,
+		COALESCE(t.workflow_id,'') AS workflow_id,COALESCE(t.workflow_step_id,'') AS step_id,
+		(SELECT activated_at FROM run_pool_history_policy WHERE version=1) AS activated_at
+		FROM tasks t WHERE t.id=? AND t.workspace_id=?`), taskID, workspaceID); err != nil {
+		if err == sql.ErrNoRows {
+			return nil, repoerrors.ErrTaskNotFound
+		}
+		return nil, err
+	}
+	snapshot := &poolhistory.Snapshot{TaskID: taskID, WorkspaceID: workspaceID, LatestEntryID: header.LatestEntryID,
+		CurrentWorkflowID: header.WorkflowID, CurrentStepID: header.StepID, PolicyActivatedAt: header.ActivatedAt}
+	if err := r.loadPoolHistoryEntries(ctx, tx, snapshot, query); err != nil {
+		return nil, err
+	}
+	if len(snapshot.Entries) != 0 {
+		if err := r.loadPoolHistoryRuns(ctx, tx, snapshot); err != nil {
+			return nil, err
+		}
+		if err := r.loadPoolHistorySelections(ctx, tx, snapshot, query); err != nil {
+			return nil, err
+		}
+		if err := r.loadPoolHistoryEvents(ctx, tx, snapshot); err != nil {
+			return nil, err
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	return snapshot, nil
+}
+
+func (r *Repository) loadPoolHistoryEntries(ctx context.Context, tx *sqlx.Tx, snapshot *poolhistory.Snapshot, query poolhistory.Query) error {
+	err := tx.SelectContext(ctx, &snapshot.Entries, tx.Rebind(`SELECT l.id,
+		COALESCE(l.to_workflow_id,'') AS workflow_id, COALESCE(l.to_workflow_step_id,'') AS step_id,
+		l.actor_kind, COALESCE(l.actor_id,'') AS actor_id, l.contract_version, l.occurred_at,
+		CASE WHEN s.updated_at<=l.occurred_at AND length(COALESCE(s.agent_profile_id,''))<=256
+			THEN COALESCE(s.agent_profile_id,'') ELSE '' END AS planned_profile
+		FROM task_step_transitions l LEFT JOIN workflow_steps s ON s.id=l.to_workflow_step_id AND s.workflow_id=l.to_workflow_id
+		WHERE l.task_id=? AND l.trigger=? AND (?=0 OR l.id<=?) ORDER BY l.id DESC LIMIT ?`),
+		snapshot.TaskID, steptelemetry.TriggerPoolRelease, query.Before, query.Before, poolhistory.MaxItems+2)
+	if err != nil {
+		return err
+	}
+	return nil
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_history_clearances.go b/apps/backend/internal/task/repository/sqlite/pool_history_clearances.go
new file mode 100644
index 0000000..7dbd071
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_history_clearances.go
@@ -0,0 +1,23 @@
+package sqlite
+
+import (
+	"context"
+
+	"github.com/jmoiron/sqlx"
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+)
+
+func readPoolHistoryClearances(ctx context.Context, tx *sqlx.Tx, keys []string) ([]runsmodels.PoolHistoryClearance, error) {
+	if len(keys) == 0 {
+		return nil, nil
+	}
+	query, args, err := sqlx.In(`SELECT dispatch_key,run_id,format_version,workspace_id,task_id,entry_id,
+		CASE WHEN length(CAST(release_json AS BLOB))<=16384 THEN release_json ELSE '' END AS release_json,
+		requested_at,cleared_at FROM run_pool_history_clearances WHERE dispatch_key IN (?) LIMIT ?`, keys, len(keys))
+	if err != nil {
+		return nil, err
+	}
+	var rows []runsmodels.PoolHistoryClearance
+	err = tx.SelectContext(ctx, &rows, tx.Rebind(query), args...)
+	return rows, err
+}
