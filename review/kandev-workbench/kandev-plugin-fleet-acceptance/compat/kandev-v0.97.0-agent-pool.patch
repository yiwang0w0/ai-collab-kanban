@@ -0,0 +1,54 @@
+package sqlite
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/jmoiron/sqlx"
+	"github.com/kandev/kandev/internal/task/poolhistory"
+)
+
+func (r *Repository) loadPoolHistorySelections(ctx context.Context, tx *sqlx.Tx, snapshot *poolhistory.Snapshot, query poolhistory.Query) error {
+	seeds := poolhistory.SelectionSeeds(snapshot)
+	encoded, err := json.Marshal(seeds)
+	if err != nil {
+		return err
+	}
+	var position poolhistory.Cursor
+	if query.Position != nil {
+		position = *query.Position
+	}
+	var claimedAt any
+	if position.ClaimedAt != nil {
+		claimedAt = position.ClaimedAt.UTC()
+	}
+	err = tx.SelectContext(ctx, &snapshot.Selections, tx.Rebind(`WITH selected AS (
+		SELECT json_extract(value,'$.entry_id') AS entry_id,json_extract(value,'$.run_id') AS run_id FROM json_each(?)
+	), attempts AS (
+	SELECT s.entry_id,s.run_id,COALESCE(l.id,'') AS claim_id,
+		COALESCE(l.workspace_id,'') AS workspace_id,l.claimed_at
+	FROM selected s
+	LEFT JOIN office_launch_ledger l ON l.run_id=s.run_id AND l.workspace_id=? AND l.id<>'' AND length(l.id)<=256
+	UNION ALL SELECT s.entry_id,s.run_id,'' AS claim_id,r.workspace_id,NULL AS claimed_at
+	FROM selected s JOIN runs r ON r.id=s.run_id AND r.workspace_id=? AND r.status='queued'
+	WHERE EXISTS (SELECT 1 FROM office_launch_ledger prior WHERE prior.run_id=s.run_id AND prior.workspace_id=r.workspace_id)
+	)
+	SELECT l.entry_id,l.run_id,l.claim_id,l.workspace_id,native.claimed_at AS claimed_at FROM attempts l
+	LEFT JOIN office_launch_ledger native ON native.id=l.claim_id AND native.run_id=l.run_id AND native.workspace_id=l.workspace_id
+	WHERE ?=0 OR l.entry_id<? OR (l.entry_id=? AND (
+		(?=1 AND l.claimed_at IS NULL) OR l.claimed_at<? OR
+		((l.claimed_at=? OR (?=0 AND l.claimed_at IS NULL)) AND
+		(l.run_id<? OR (l.run_id=? AND l.claim_id<?)))
+	))
+	ORDER BY l.entry_id DESC,l.claimed_at DESC,l.run_id DESC,l.claim_id DESC LIMIT ?`),
+		string(encoded), snapshot.WorkspaceID, snapshot.WorkspaceID, query.Before, query.Before, query.Before,
+		position.ClaimedAt != nil, claimedAt, claimedAt, position.ClaimedAt != nil, position.RunID, position.RunID, position.ClaimID, query.Limit+1)
+	if err != nil {
+		return err
+	}
+	if len(snapshot.Selections) > query.Limit {
+		snapshot.HasMore = true
+		snapshot.Selections = snapshot.Selections[:query.Limit]
+	}
+	return r.loadPoolHistoryClaimCounts(ctx, tx, snapshot, seeds)
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_projection.go b/apps/backend/internal/task/repository/sqlite/pool_projection.go
new file mode 100644
index 0000000..69faac4
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_projection.go
@@ -0,0 +1,56 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	"github.com/kandev/kandev/internal/task/poolhistory"
+	"github.com/kandev/kandev/internal/task/poolview"
+	"github.com/kandev/kandev/internal/task/repository/repoerrors"
+)
+
+func (r *Repository) ReadPoolProjectionSnapshot(ctx context.Context, workspaceID string, query poolview.Query) (*poolview.Snapshot, error) {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return nil, repoerrors.ErrPoolStorageUnsupported
+	}
+	if workspaceID == "" || query.Limit < 1 || query.Limit > poolhistory.MaxItems || len(query.After) > 256 {
+		return nil, poolview.ErrInvalidQuery
+	}
+	tx, err := r.ro.BeginTxx(ctx, &sql.TxOptions{ReadOnly: true})
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = tx.Rollback() }()
+	var found string
+	if err := tx.GetContext(ctx, &found, tx.Rebind(`SELECT id FROM workspaces WHERE id=?`), workspaceID); err != nil {
+		if err == sql.ErrNoRows {
+			return nil, repoerrors.ErrWorkspaceNotFound
+		}
+		return nil, err
+	}
+	snapshot := &poolview.Snapshot{WorkspaceID: found}
+	err = tx.SelectContext(ctx, &snapshot.Cards, tx.Rebind(poolProjectionCardSQL+`
+		WHERE t.workspace_id=? AND t.archived_at IS NULL AND t.is_ephemeral=0 AND t.id>?
+		ORDER BY t.id LIMIT ?`), workspaceID, query.After, query.Limit+1)
+	if err != nil {
+		return nil, err
+	}
+	if len(snapshot.Cards) > query.Limit {
+		snapshot.HasMore = true
+		snapshot.Cards = snapshot.Cards[:query.Limit]
+	}
+	if err := r.loadPoolProjectionFacts(ctx, tx, snapshot); err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	return snapshot, nil
+}
+
+const poolProjectionCardSQL = `SELECT t.id AS task_id,t.workspace_id,substr(t.title,1,256) AS title,
+	COALESCE(w.id,'') AS workflow_id,COALESCE(s.id,'') AS workflow_step_id,
+	COALESCE(substr(s.name,1,128),'') AS stage,t.state AS task_state
+	FROM tasks t LEFT JOIN workflows w ON w.id=t.workflow_id AND w.workspace_id=t.workspace_id
+	LEFT JOIN workflow_steps s ON s.id=t.workflow_step_id AND s.workflow_id=w.id`
diff --git b/apps/backend/internal/task/repository/sqlite/pool_projection_claims.go b/apps/backend/internal/task/repository/sqlite/pool_projection_claims.go
new file mode 100644
index 0000000..24e3071
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_projection_claims.go
@@ -0,0 +1,66 @@
+package sqlite
+
+import (
+	"context"
+
+	"github.com/jmoiron/sqlx"
+	"github.com/kandev/kandev/internal/task/poolhistory"
+	"github.com/kandev/kandev/internal/task/poolview"
+)
+
+func (r *Repository) loadPoolProjectionClaims(ctx context.Context, tx *sqlx.Tx, snapshot *poolview.Snapshot) error {
+	seeds, owners := make([]poolhistory.Seed, 0, len(snapshot.Histories)), make(map[string]*poolhistory.Snapshot, len(snapshot.Histories))
+	for _, history := range snapshot.Histories {
+		for _, seed := range poolhistory.SelectionSeeds(history) {
+			history.Selections = []poolhistory.Selection{{EntryID: seed.EntryID, RunID: seed.RunID}}
+			if seed.RunID != "" {
+				seeds, owners[seed.RunID] = append(seeds, seed), history
+			}
+		}
+	}
+	combined := &poolhistory.Snapshot{}
+	if err := r.loadPoolHistoryClaimCounts(ctx, tx, combined, seeds); err != nil {
+		return err
+	}
+	for _, count := range combined.ClaimCounts {
+		owners[count.RunID].ClaimCounts = []poolhistory.ClaimCount{count}
+	}
+	ids := make([]string, 0, len(owners))
+	for id := range owners {
+		ids = append(ids, id)
+	}
+	return loadPoolProjectionCurrentClaims(ctx, tx, ids, owners)
+}
+
+func loadPoolProjectionCurrentClaims(ctx context.Context, tx *sqlx.Tx, ids []string, owners map[string]*poolhistory.Snapshot) error {
+	if len(ids) == 0 {
+		return nil
+	}
+	query, args, err := sqlx.In(`WITH matching AS (
+		SELECT l.run_id,l.id AS claim_id,l.workspace_id,l.claimed_at,
+		ROW_NUMBER() OVER (PARTITION BY l.run_id ORDER BY l.claimed_at DESC,l.id DESC) AS ordinal
+		FROM office_launch_ledger l LEFT JOIN runs r ON r.id=l.run_id AND r.workspace_id=l.workspace_id
+		WHERE l.run_id IN (?) AND (l.claimed_at=r.claimed_at OR r.id IS NULL) AND l.id<>'' AND length(l.id)<=256
+	) SELECT run_id,claim_id,workspace_id,claimed_at FROM matching WHERE ordinal<=2 ORDER BY run_id,claim_id`, ids)
+	if err != nil {
+		return err
+	}
+	var rows []poolhistory.Selection
+	if err := tx.SelectContext(ctx, &rows, tx.Rebind(query), args...); err != nil {
+		return err
+	}
+	for _, row := range rows {
+		history := owners[row.RunID]
+		cleared := len(history.Clearances) == 1 && len(history.Runs) == 0
+		if row.WorkspaceID != history.WorkspaceID || (!cleared &&
+			(len(history.ClaimCounts) != 1 || history.ClaimCounts[0].CurrentMatches != 1)) {
+			continue
+		}
+		if cleared && history.Selections[0].ClaimID != "" {
+			continue
+		}
+		row.EntryID = history.Selections[0].EntryID
+		history.Selections = []poolhistory.Selection{row}
+	}
+	return nil
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_projection_context.go b/apps/backend/internal/task/repository/sqlite/pool_projection_context.go
new file mode 100644
index 0000000..757b5e9
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_projection_context.go
@@ -0,0 +1,84 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"strings"
+
+	"github.com/jmoiron/sqlx"
+	"github.com/kandev/kandev/internal/task/models"
+	"github.com/kandev/kandev/internal/task/poolview"
+	wfmodels "github.com/kandev/kandev/internal/workflow/models"
+	v1 "github.com/kandev/kandev/pkg/api/v1"
+)
+
+type poolProjectionContextRow struct {
+	poolview.Relations
+	TaskID                  string         `db:"task_id"`
+	DependenciesBlocked     bool           `db:"dependencies_blocked"`
+	WIPAdmitted             bool           `db:"wip_admitted"`
+	QueuedForStep           bool           `db:"queued_for_step"`
+	StepID                  string         `db:"step_id"`
+	StepUpdatedAt           sql.NullTime   `db:"step_updated_at"`
+	StepProfileID           string         `db:"step_profile_id"`
+	StepEvents              string         `db:"step_events"`
+	SessionTarget           sql.NullString `db:"session_target"`
+	CompleteTaskOnEnter     bool           `db:"complete_task_on_enter"`
+	ProfileID               string         `db:"profile_id"`
+	ProfileAgentID          string         `db:"profile_agent_id"`
+	AgentID                 string         `db:"agent_id"`
+	AgentFamily             string         `db:"agent_family"`
+	ProfileWorkspaceID      string         `db:"profile_workspace_id"`
+	AgentWorkspaceID        string         `db:"agent_workspace_id"`
+	Enabled                 bool           `db:"enabled"`
+	Deleted                 bool           `db:"deleted"`
+	ProviderKind            string         `db:"provider_kind"`
+	AutoFallback            bool           `db:"auto_fallback"`
+	FallbackModel           string         `db:"fallback_model"`
+	CLIPassthrough          bool           `db:"cli_passthrough"`
+	ExecutionAgentProfileID string         `db:"execution_agent_profile_id"`
+	TUIConfig               string         `db:"tui_config"`
+}
+
+func loadPoolProjectionContexts(ctx context.Context, tx *sqlx.Tx, snapshot *poolview.Snapshot) error {
+	ids := make([]string, 0, len(snapshot.Cards))
+	for _, card := range snapshot.Cards {
+		ids = append(ids, card.TaskID)
+	}
+	query, args, err := sqlx.In(poolProjectionContextSQL, v1.TaskStateCompleted, ids, snapshot.WorkspaceID)
+	if err != nil {
+		return err
+	}
+	var rows []poolProjectionContextRow
+	if err := tx.SelectContext(ctx, &rows, tx.Rebind(query), args...); err != nil {
+		return err
+	}
+	snapshot.Contexts = make(map[string]poolview.CardContext, len(rows))
+	for _, row := range rows {
+		snapshot.Contexts[row.TaskID] = row.context(snapshot.WorkspaceID)
+	}
+	return nil
+}
+
+func (row poolProjectionContextRow) context(workspaceID string) poolview.CardContext {
+	step := &wfmodels.WorkflowStep{ID: row.StepID, AgentProfileID: row.StepProfileID, CompleteTaskOnEnter: row.CompleteTaskOnEnter}
+	if row.SessionTarget.Valid && row.SessionTarget.String != "" && row.SessionTarget.String != "null" {
+		step.SessionTarget = &wfmodels.WorkflowSessionTarget{}
+	}
+	var decodeError error
+	if row.StepEvents != "" {
+		decodeError = json.Unmarshal([]byte(row.StepEvents), &step.Events)
+	}
+	_, configured, configError := step.PoolExecutionProfile()
+	tui := strings.TrimSpace(row.TUIConfig)
+	return poolview.CardContext{Relations: row.Relations, DependenciesBlocked: row.DependenciesBlocked,
+		StepExists: row.StepID != "", StepUpdatedAt: row.StepUpdatedAt.Time,
+		PoolConfigured: configured, InvalidPoolConfig: decodeError != nil || configError != nil,
+		WIPAdmitted: row.WIPAdmitted, QueuedForStep: row.QueuedForStep,
+		Profile: models.PoolExecutionCandidate{WorkspaceID: workspaceID, AgentProfileID: row.ProfileID,
+			ProfileAgentRecordID: row.ProfileAgentID, AgentRecordID: row.AgentID, AgentFamily: row.AgentFamily,
+			ProfileWorkspaceID: row.ProfileWorkspaceID, AgentWorkspaceID: row.AgentWorkspaceID, Enabled: row.Enabled,
+			Deleted: row.Deleted, ProviderKind: row.ProviderKind, AutoFallback: row.AutoFallback, FallbackModel: row.FallbackModel,
+			CLIPassthrough: row.CLIPassthrough, ExecutionAgentProfileID: row.ExecutionAgentProfileID, CustomTUI: tui != "" && tui != "null"}}
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_projection_context_sql.go b/apps/backend/internal/task/repository/sqlite/pool_projection_context_sql.go
new file mode 100644
index 0000000..4c15561
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_projection_context_sql.go
@@ -0,0 +1,36 @@
+package sqlite
+
+// 关系只计同工作区的原生可见主卡；缺失、已归档或异域前置仍保留为阻塞。
+const poolProjectionContextSQL = `SELECT t.id AS task_id,
+	COALESCE(parent.id,'') AS parent_id,
+	(SELECT COUNT(*) FROM tasks child WHERE child.parent_id=t.id AND child.workspace_id=t.workspace_id
+		AND child.archived_at IS NULL AND child.is_ephemeral=0) AS child_count,
+	(SELECT COUNT(*) FROM task_blockers edge JOIN tasks target ON target.id=edge.blocker_task_id
+		AND target.workspace_id=t.workspace_id AND target.archived_at IS NULL AND target.is_ephemeral=0
+		WHERE edge.task_id=t.id) AS depends_on_count,
+	(SELECT COUNT(*) FROM task_blockers edge JOIN tasks target ON target.id=edge.task_id
+		AND target.workspace_id=t.workspace_id AND target.archived_at IS NULL AND target.is_ephemeral=0
+		WHERE edge.blocker_task_id=t.id) AS blocks_count,
+	EXISTS (SELECT 1 FROM task_blockers edge LEFT JOIN tasks target ON target.id=edge.blocker_task_id
+		WHERE edge.task_id=t.id AND (target.id IS NULL OR target.workspace_id<>t.workspace_id
+		OR target.archived_at IS NOT NULL OR target.state<>?)) AS dependencies_blocked,
+	t.wip_admitted,COALESCE(t.queued_for_step_id,'')<>'' AS queued_for_step,
+	COALESCE(s.id,'') AS step_id,s.updated_at AS step_updated_at,COALESCE(s.agent_profile_id,'') AS step_profile_id,
+	CASE WHEN length(CAST(COALESCE(s.events,'') AS BLOB))<=16384
+		THEN COALESCE(s.events,'') ELSE 'unmeasurable' END AS step_events,
+	s.session_target,COALESCE(s.complete_task_on_enter,0) AS complete_task_on_enter,
+	COALESCE(p.id,'') AS profile_id,COALESCE(p.agent_id,'') AS profile_agent_id,
+	COALESCE(a.id,'') AS agent_id,COALESCE(a.name,'') AS agent_family,
+	COALESCE(p.workspace_id,'') AS profile_workspace_id,COALESCE(a.workspace_id,'') AS agent_workspace_id,
+	COALESCE(p.enabled,0) AS enabled,p.deleted_at IS NOT NULL AS deleted,
+	COALESCE(p.provider_kind,'') AS provider_kind,COALESCE(p.auto_fallback,1) AS auto_fallback,
+	COALESCE(p.fallback_model,'') AS fallback_model,COALESCE(p.cli_passthrough,0) AS cli_passthrough,
+	COALESCE(p.execution_agent_profile_id,'') AS execution_agent_profile_id,
+	CASE WHEN length(CAST(COALESCE(a.tui_config,'') AS BLOB))<=16384
+		THEN COALESCE(a.tui_config,'') ELSE 'unmeasurable' END AS tui_config
+	FROM tasks t LEFT JOIN tasks parent ON parent.id=t.parent_id AND parent.workspace_id=t.workspace_id
+		AND parent.archived_at IS NULL AND parent.is_ephemeral=0
+	LEFT JOIN workflows w ON w.id=t.workflow_id AND w.workspace_id=t.workspace_id
+	LEFT JOIN workflow_steps s ON s.id=t.workflow_step_id AND s.workflow_id=w.id
+	LEFT JOIN agent_profiles p ON p.id=s.agent_profile_id LEFT JOIN agents a ON a.id=p.agent_id
+	WHERE t.id IN (?) AND t.workspace_id=?`
diff --git b/apps/backend/internal/task/repository/sqlite/pool_projection_events.go b/apps/backend/internal/task/repository/sqlite/pool_projection_events.go
new file mode 100644
index 0000000..8f40bf5
--- /dev/null
+++ b/apps/backend/internal/task/repository/sqlite/pool_projection_events.go
@@ -0,0 +1,49 @@
+package sqlite
+
+import (
+	"context"
+
+	"github.com/jmoiron/sqlx"
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+	"github.com/kandev/kandev/internal/task/poolhistory"
+	"github.com/kandev/kandev/internal/task/poolview"
+)
+
+func loadPoolProjectionEvents(ctx context.Context, tx *sqlx.Tx, snapshot *poolview.Snapshot) error {
+	runs, claims, owners := poolProjectionEventScopes(snapshot)
+	if len(runs) == 0 {
+		return nil
+	}
+	query, args, err := sqlx.In(`WITH evidence AS (
+		SELECT e.run_id,e.seq,e.event_type,e.created_at,
+		CASE WHEN length(CAST(payload AS BLOB))<=16384 THEN payload ELSE '' END AS payload,
+		ROW_NUMBER() OVER (PARTITION BY e.run_id ORDER BY e.seq) AS ordinal
+		FROM run_events e WHERE e.run_id IN (?) AND e.event_type LIKE 'pool.%' AND `+
+		poolCausalEventScopeSQL+`
+	) SELECT run_id,seq,event_type,created_at,payload FROM evidence WHERE ordinal<=17 ORDER BY run_id,seq`, runs, claims, claims)
+	if err != nil {
+		return err
+	}
+	var rows []*runsmodels.RunEvent
+	if err := tx.SelectContext(ctx, &rows, tx.Rebind(query), args...); err != nil {
+		return err
+	}
+	for _, row := range rows {
+		history := owners[row.RunID]
+		history.Events = append(history.Events, row)
+		history.EvidenceIncomplete = len(history.Events) > 16
+	}
+	return nil
+}
+
+func poolProjectionEventScopes(snapshot *poolview.Snapshot) ([]string, []string, map[string]*poolhistory.Snapshot) {
+	runs, claims, owners := make([]string, 0), make([]string, 0), make(map[string]*poolhistory.Snapshot)
+	for _, history := range snapshot.Histories {
+		for _, selection := range history.Selections {
+			if selection.RunID != "" {
+				runs, claims, owners[selection.RunID] = append(runs, selection.RunID), append(claims, selection.ClaimID), history
+			}
+		}
+	}
+	return runs, claims, owners
+}
diff --git b/apps/backend/internal/task/repository/sqlite/pool_projection_facts.go b/apps/backend/internal/task/repository/sqlite/pool_projection_facts.go
new file mode 100644
