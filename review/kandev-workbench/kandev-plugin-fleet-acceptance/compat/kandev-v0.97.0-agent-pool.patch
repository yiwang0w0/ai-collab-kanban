+}
+
+// PoolTaskBusyError 携带占用本任务的原生运行，供已授权动作链接到已有工作。
+type PoolTaskBusyError struct{ RunID string }
+
+func (e *PoolTaskBusyError) Error() string { return "pool_task_busy: " + e.RunID }
