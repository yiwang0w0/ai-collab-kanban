--- /dev/null
+++ b/apps/backend/internal/runs/models/pool_dispatch.go
@@ -0,0 +1,64 @@
+package models
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+)
+
+const PoolDispatchReason = "pool_dispatch"
+
+// DispatchKey 的摘要只依赖不可变阶段身份，JSON 数组保留字段边界。
+func (r PoolReleaseSnapshot) DispatchKey() (string, error) {
+	identity, err := json.Marshal([]any{r.WorkspaceID, r.TaskID, r.EntryID})
+	if err != nil {
+		return "", err
+	}
+	digest := sha256.Sum256(identity)
+	return PoolDispatchKeyPrefix + hex.EncodeToString(digest[:]), nil
+}
+
+type poolRunEnvelope struct {
+	TaskID         string              `json:"task_id"`
+	WorkflowStepID string              `json:"workflow_step_id"`
+	AgentProfileID string              `json:"agent_profile_id"`
+	PoolRelease    PoolReleaseSnapshot `json:"pool_release"`
+}
+
+// MatchesRun 验证队列结果仍属于同一批准，不以非空行或同键字符串代替绑定。
+func (r PoolReleaseSnapshot) MatchesRun(row *Run) bool {
+	if row == nil || row.ID == "" || row.IdempotencyKey == nil || !knownPoolRunStatus(row.Status) {
+		return false
+	}
+	key, err := r.DispatchKey()
+	if err != nil || *row.IdempotencyKey != key || !r.matchesRunColumns(row) {
+		return false
+	}
+	var envelope poolRunEnvelope
+	if json.Unmarshal([]byte(row.Payload), &envelope) != nil {
+		return false
+	}
+	return envelope.TaskID == r.TaskID && envelope.WorkflowStepID == r.WorkflowStepID &&
+		envelope.AgentProfileID == r.AgentProfileID && r.sameBinding(envelope.PoolRelease)
+}
+
+func (r PoolReleaseSnapshot) matchesRunColumns(row *Run) bool {
+	return row.AgentProfileID == r.AgentProfileID && row.WorkspaceID == r.WorkspaceID &&
+		row.Reason == PoolDispatchReason && row.ActorKind == ActorKindUser && row.ActorID == r.ActorID &&
+		row.CoalescedCount == 1 && row.WakeWaveKey == "" && row.WakeWaveString == ""
+}
+
+func (r PoolReleaseSnapshot) sameBinding(other PoolReleaseSnapshot) bool {
+	return r.TaskID == other.TaskID && r.WorkspaceID == other.WorkspaceID && r.WorkflowID == other.WorkflowID &&
+		r.WorkflowStepID == other.WorkflowStepID && r.EntryID == other.EntryID && r.AgentProfileID == other.AgentProfileID &&
+		r.ActorID == other.ActorID && r.ReleasedAt.Equal(other.ReleasedAt)
+}
+
+func knownPoolRunStatus(status RunStatus) bool {
+	switch status {
+	case "queued", "claimed", "finished", "failed", "cancelled":
+		return true
+	default:
+		return false
+	}
+}
diff --git b/apps/backend/internal/runs/models/pool_execution_allocation.go b/apps/backend/internal/runs/models/pool_execution_allocation.go
new file mode 100644
index 0000000..50e25a7
--- /dev/null
+++ b/apps/backend/internal/runs/models/pool_execution_allocation.go
@@ -0,0 +1,76 @@
+package models
+
+import "strings"
+
+// ValidAllocationFor 限定首次新执行的宿主身份，不补造尚未产生的提供商 operation。
+func (i PoolExecutionIdentity) ValidAllocationFor(request PoolClaimStart) bool {
+	if !request.Valid() || !i.matchesPoolRequest(request) || i.OperationID != "" || i.OperationSource != "" || i.PromptGeneration != 1 {
+		return false
+	}
+	for _, id := range []string{i.SessionID, i.ExecutionID, i.TurnID} {
+		if id == "" || len(id) > 256 || strings.TrimSpace(id) != id {
+			return false
+		}
+	}
+	return true
+}
+
+func (i PoolExecutionIdentity) matchesPoolRequest(request PoolClaimStart) bool {
+	return i.RunID == request.RunID && i.ClaimID == request.ClaimID && i.TaskID == request.Release.TaskID &&
+		i.AgentProfileID == request.Release.AgentProfileID && i.ExecutionProfileID == i.AgentProfileID
+}
+
+// ReceiptIdentity 只把匹配的首轮可信活动关联到已持久化分配，明确 operation 的来源。
+func (a PoolExecutionActivity) ReceiptIdentity(allocation PoolExecutionAllocation) (PoolExecutionIdentity, bool) {
+	if !a.validSource() {
+		return PoolExecutionIdentity{}, false
+	}
+	return a.receiptIdentity(allocation)
+}
+
+// TurnEndIdentity 不借用开工来源；完成通知必须独立匹配同一宿主分配。
+func (a PoolExecutionActivity) TurnEndIdentity(allocation PoolExecutionAllocation) (PoolExecutionIdentity, bool) {
+	if a.StartedSource != "" {
+		return PoolExecutionIdentity{}, false
+	}
+	return a.receiptIdentity(allocation)
+}
+
+func (a PoolExecutionActivity) receiptIdentity(allocation PoolExecutionAllocation) (PoolExecutionIdentity, bool) {
+	i := allocation.PoolExecutionIdentity
+	if !a.matchesAllocation(allocation) {
+		return PoolExecutionIdentity{}, false
+	}
+	switch a.AgentType {
+	case "codex-app-server":
+		if a.OperationID == "" || len(a.OperationID) > 256 || strings.TrimSpace(a.OperationID) != a.OperationID {
+			return PoolExecutionIdentity{}, false
+		}
+		i.OperationID, i.OperationSource = a.OperationID, PoolOperationProvider
+	case "claude-acp", "codex-acp":
+		if a.OperationID != "" {
+			return PoolExecutionIdentity{}, false
+		}
+		i.OperationID, i.OperationSource = i.TurnID, PoolOperationHostTurn
+	default:
+		return PoolExecutionIdentity{}, false
+	}
+	return i, true
+}
+
+func (a PoolExecutionActivity) matchesAllocation(allocation PoolExecutionAllocation) bool {
+	i := allocation.PoolExecutionIdentity
+	return a.TaskID == i.TaskID && a.AgentProfileID == i.AgentProfileID && a.SessionID == i.SessionID &&
+		a.ExecutionID == i.ExecutionID && a.TurnID == i.TurnID && a.PromptGeneration == i.PromptGeneration && a.AgentType == allocation.AgentType
+}
+
+func (a PoolExecutionActivity) validSource() bool {
+	switch a.StartedSource {
+	case PoolStartCodexProvider:
+		return a.AgentType == "codex-app-server"
+	case PoolStartAssistant, PoolStartTool:
+		return true
+	default:
+		return false
+	}
+}
