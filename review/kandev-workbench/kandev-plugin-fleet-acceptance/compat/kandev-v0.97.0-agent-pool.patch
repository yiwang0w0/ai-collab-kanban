+++ b/apps/web/components/task-pool/task-pool-browser.tsx
@@ -0,0 +1,81 @@
+"use client";
+
+import { useLayoutEffect, useRef } from "react";
+import { useTranslation } from "react-i18next";
+import { Button } from "@kandev/ui/button";
+import type { TaskPoolPageState } from "@/hooks/domains/task/use-task-pool-page";
+import { cn } from "@/lib/utils";
+import { poolPageChildren } from "@/lib/task-pool-view-model";
+import { TaskPoolCard } from "./task-pool-card";
+import { TaskPoolDetail } from "./task-pool-detail";
+
+export function TaskPoolBrowser({ view }: { view: TaskPoolPageState }) {
+  const { t } = useTranslation();
+  if (!view.workspaceId) return <p className="p-4">{t("taskPool:chooseWorkspace")}</p>;
+  return (
+    <div className="flex min-h-0 min-w-0 flex-1">
+      {(view.desktop || !view.selectedId) && <PoolCardList view={view} />}
+      {(view.desktop || view.selectedId) && (
+        <section
+          className={cn("flex min-h-0 min-w-0 flex-1", view.desktop && "border-l")}
+          data-testid="pool-detail-surface"
+        >
+          {view.selected ? (
+            <TaskPoolDetail
+              key={view.selected.task_id}
+              card={view.selected}
+              children={poolPageChildren(view.cards, view.selected.task_id)}
+              workspaceId={view.workspaceId}
+              fresh={view.freshness === "fresh"}
+              onRefresh={() => {
+                void view.read.refresh();
+              }}
+              onBack={view.desktop ? undefined : () => view.select("")}
+            />
+          ) : (
+            <div className="space-y-3 p-4 text-sm text-muted-foreground">
+              <p>{t(view.selectedId ? "taskPool:missingSelection" : "taskPool:selectTask")}</p>
+              {view.selectedId && (
+                <Button variant="outline" onClick={() => view.select("")}>
+                  {t("taskPool:back")}
+                </Button>
+              )}
+            </div>
+          )}
+        </section>
+      )}
+    </div>
+  );
+}
+
+function PoolCardList({ view }: { view: TaskPoolPageState }) {
+  const { t } = useTranslation();
+  const scroll = useRef<HTMLDivElement>(null);
+  useLayoutEffect(() => {
+    if (scroll.current) scroll.current.scrollTop = view.position.current;
+  }, [view.position]);
+  return (
+    <div
+      ref={scroll}
+      onScroll={(event) => {
+        view.position.current = event.currentTarget.scrollTop;
+      }}
+      className="min-h-0 min-w-0 flex-1 space-y-3 overflow-y-auto overscroll-contain p-3"
+      data-testid="pool-card-list"
+    >
+      {view.read.data && view.visible.length === 0 && (
+        <p className="p-4 text-sm text-muted-foreground" data-testid="pool-empty">
+          {t(view.cards.length === 0 ? "taskPool:empty" : "taskPool:noMatches")}
+        </p>
+      )}
+      {view.visible.map((card) => (
+        <TaskPoolCard
+          key={card.task_id}
+          card={card}
+          selected={card.task_id === view.selected?.task_id}
+          onSelect={() => view.select(card.task_id)}
+        />
+      ))}
+    </div>
+  );
+}
diff --git b/apps/web/components/task-pool/task-pool-card.tsx b/apps/web/components/task-pool/task-pool-card.tsx
new file mode 100644
index 0000000..77a5a09
--- /dev/null
+++ b/apps/web/components/task-pool/task-pool-card.tsx
@@ -0,0 +1,71 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { poolCardTimes, poolReasonGroup } from "@/lib/task-pool-view-model";
+import type { PoolCard } from "@/lib/types/task-pool";
+import { cn } from "@/lib/utils";
+import { PoolAgent, PoolState, PoolTime } from "./task-pool-facts";
+
+export function TaskPoolCard({
+  card,
+  selected,
+  onSelect,
+}: {
+  card: PoolCard;
+  selected: boolean;
+  onSelect: () => void;
+}) {
+  const { t } = useTranslation();
+  const execution = card.pool_execution;
+  return (
+    <button
+      type="button"
+      onClick={onSelect}
+      aria-pressed={selected}
+      data-testid={`pool-card-${card.task_id}`}
+      className={cn(
+        "w-full cursor-pointer rounded-xl border bg-card p-4 text-left transition-colors hover:bg-accent/40 focus-visible:outline-2 focus-visible:outline-primary",
+        selected && "border-primary bg-accent/30",
+      )}
+    >
+      <h2 className="break-words text-sm font-semibold">{card.title}</h2>
+      <div className="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
+        <span>
+          {t("taskPool:stage")}: {card.stage}
+        </span>
+        <PoolState execution={execution} />
+      </div>
+      <p className="mt-3 text-xs">
+        <span className="text-muted-foreground">{t("taskPool:actualAgent")}: </span>
+        <PoolAgent profileId={execution?.claimed_agent_profile_id} />
+      </p>
+      <div className="mt-2 space-y-1 text-xs text-muted-foreground">
+        {poolCardTimes(execution).map((point) => (
+          <p key={point.kind}>
+            {t(`taskPool:states.${point.kind}`)} · <PoolTime at={point.at} />
+          </p>
+        ))}
+      </div>
+      <p className="mt-3 break-words text-xs text-muted-foreground">
+        {t(`taskPool:reasons.${poolReasonGroup(card.eligibility.reason)}`)}
+      </p>
+      {(card.relations.parent_id ||
+        card.relations.depends_on_count > 0 ||
+        card.relations.child_count > 0) && (
+        <div className="mt-3 flex flex-wrap gap-3 border-t pt-2 text-xs text-muted-foreground">
+          {card.relations.parent_id && <span>{t("taskPool:parent")}</span>}
+          {card.relations.child_count > 0 && (
+            <span>
+              {t("taskPool:children")}: {card.relations.child_count}
+            </span>
+          )}
+          {card.relations.depends_on_count > 0 && (
+            <span>
+              {t("taskPool:dependsOn")}: {card.relations.depends_on_count}
+            </span>
+          )}
+        </div>
+      )}
+    </button>
+  );
+}
diff --git b/apps/web/components/task-pool/task-pool-detail.tsx b/apps/web/components/task-pool/task-pool-detail.tsx
new file mode 100644
index 0000000..3f27f2a
--- /dev/null
+++ b/apps/web/components/task-pool/task-pool-detail.tsx
@@ -0,0 +1,161 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Button } from "@kandev/ui/button";
+import TaskLink from "@/components/routing/task-link";
+import { useTaskPoolHistory } from "@/hooks/domains/task/use-task-pool";
+import { poolReasonGroup } from "@/lib/task-pool-view-model";
+import type { PoolCard } from "@/lib/types/task-pool";
+import { PoolAgent, PoolState, PoolTimeline, PoolTechnicalDetails } from "./task-pool-facts";
+import { TaskPoolRelations } from "./task-pool-relations";
+import { TaskPoolRelease } from "./task-pool-release";
+import { TaskPoolRecovery } from "./task-pool-recovery";
+
+export function TaskPoolDetail({
+  card,
+  children,
+  workspaceId,
+  fresh,
+  onRefresh,
+  onBack,
+}: {
+  card: PoolCard;
+  children: PoolCard[];
+  workspaceId: string;
+  fresh: boolean;
+  onRefresh: () => void;
+  onBack?: () => void;
+}) {
+  const { t } = useTranslation();
+  const execution = card.pool_execution;
+  return (
+    <div
+      className="min-h-0 min-w-0 flex-1 overflow-y-auto overscroll-contain p-4 pb-[calc(1rem+env(safe-area-inset-bottom))]"
+      data-testid="pool-detail"
+    >
+      <div className="mx-auto max-w-2xl space-y-6">
+        <header className="space-y-3">
+          {onBack && (
+            <Button variant="outline" onClick={onBack} data-testid="pool-back">
+              {t("taskPool:back")}
+            </Button>
+          )}
+          <h2 className="break-words text-lg font-semibold">{card.title}</h2>
+          <div className="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
+            <span>
+              {t("taskPool:stage")}: {card.stage}
+            </span>
+            <PoolState execution={execution} />
+          </div>
+          <p className="text-sm">
+            {t("taskPool:actualAgent")}:{" "}
+            <PoolAgent profileId={execution?.claimed_agent_profile_id} />
+          </p>
+          {execution?.planned_agent_profile_id && (
+            <p className="text-xs text-muted-foreground">
+              {t("taskPool:plannedAgent")}:{" "}
+              <PoolAgent profileId={execution.planned_agent_profile_id} />
+            </p>
+          )}
+          <p className="text-sm text-muted-foreground">
+            {t(`taskPool:reasons.${poolReasonGroup(card.eligibility.reason)}`)}
+          </p>
+          <Button asChild className="max-w-full">
+            <TaskLink taskId={card.task_id} sessionId={execution?.session_id || undefined}>
+              {t("taskPool:nativeWorkbench")}
+            </TaskLink>
+          </Button>
+        </header>
+        {!execution && (
+          <TaskPoolRelease
+            card={card}
+            workspaceId={workspaceId}
+            fresh={fresh}
+            onRefresh={onRefresh}
+          />
+        )}
+        <section className="space-y-3" data-testid="pool-current-timeline">
+          <h3 className="text-sm font-semibold">{t("taskPool:timeline")}</h3>
+          <PoolTimeline execution={execution} />
+        </section>
+        <p className="rounded-lg border border-amber-500/30 bg-amber-500/5 p-3 text-xs text-muted-foreground">
+          {t("taskPool:terminalNote")}
+        </p>
+        <TaskPoolRelations card={card} children={children} />
+        <PoolHistory taskId={card.task_id} />
+        <section className="space-y-2">
+          {execution?.run_id && (
+            <TaskPoolRecovery
+              taskId={card.task_id}
+              runId={execution.run_id}
+              workspaceId={workspaceId}
+              title={card.title}
+              fresh={fresh}
+              executionVersion={JSON.stringify(execution)}
+              onRefresh={onRefresh}
+            />
+          )}
+          <Button asChild variant="outline">
+            <TaskLink taskId={card.task_id}>{t("taskPool:moveInWorkbench")}</TaskLink>
+          </Button>
+        </section>
+        <PoolTechnicalDetails execution={execution} />
+      </div>
+    </div>
+  );
+}
+
+function PoolHistory({ taskId }: { taskId: string }) {
+  const { t } = useTranslation();
+  const [cursors, setCursors] = useState<string[]>([""]);
+  const read = useTaskPoolHistory(taskId, cursors[cursors.length - 1]);
+  return (
+    <section className="space-y-3" data-testid="pool-history">
+      <h3 className="text-sm font-semibold">{t("taskPool:history")}</h3>
+      <p className="text-xs text-muted-foreground">{t("taskPool:historyPage")}</p>
+      {read.error ? (
+        <p role="alert" className="text-sm text-destructive">
+          {t("taskPool:unavailable")}
+        </p>
+      ) : null}
+      {read.loading && !read.data && <p role="status">{t("taskPool:loading")}</p>}
+      {read.data?.items.length === 0 && (
+        <p className="text-xs text-muted-foreground">{t("taskPool:noHistory")}</p>
+      )}
+      {read.data?.items.map((execution) => (
+        <details
+          key={`${execution.entry_id}:${execution.run_id}:${execution.claim_id}`}
+          className="rounded-lg border p-3"
+        >
+          <summary className="flex min-h-7 cursor-pointer flex-wrap items-center gap-2 max-md:min-h-11 [@media(pointer:coarse)]:min-h-11">
+            <PoolState execution={execution} />
+            {execution.current && (
+              <span className="text-xs text-muted-foreground">{t("taskPool:current")}</span>
+            )}
+          </summary>
+          <div className="mt-3 space-y-3">
+            <PoolTimeline execution={execution} />
+            <PoolTechnicalDetails execution={execution} />
+          </div>
+        </details>
+      ))}
+      <div className="flex gap-2">
+        <Button
+          variant="outline"
+          disabled={cursors.length === 1 || read.loading}
+          onClick={() => setCursors((items) => items.slice(0, -1))}
+        >
+          {t("taskPool:previous")}
+        </Button>
+        <Button
+          variant="outline"
+          disabled={!read.data?.next_cursor || read.loading}
+          onClick={() => setCursors((items) => [...items, read.data!.next_cursor])}
+        >
+          {t("taskPool:next")}
+        </Button>
+      </div>
+    </section>
+  );
+}
