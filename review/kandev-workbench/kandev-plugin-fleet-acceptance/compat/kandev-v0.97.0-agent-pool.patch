diff --git b/apps/backend/internal/agent/runtime/lifecycle/execution_quiescent.go b/apps/backend/internal/agent/runtime/lifecycle/execution_quiescent.go
new file mode 100644
index 0000000..766c0bc
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/lifecycle/execution_quiescent.go
@@ -0,0 +1,41 @@
+package lifecycle
+
+import (
+	"context"
+	"errors"
+	"strings"
+)
+
+var ErrExecutionResourcesUnconfirmed = errors.New("execution_resources_unconfirmed")
+
+// CheckExecutionQuiescent 只读核验当前登记和所有权，必须与已提交的本次停止证明配合；缺登记本身不是停止证明。
+func (m *Manager) CheckExecutionQuiescent(ctx context.Context, executionID, taskID, sessionID string) error {
+	if m == nil || m.executionStore == nil {
+		return ErrExecutionResourcesUnconfirmed
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	for _, id := range []string{executionID, taskID, sessionID} {
+		if id == "" || len(id) > 256 || strings.TrimSpace(id) != id {
+			return ErrExecutionResourcesUnconfirmed
+		}
+	}
+	if m.executionStore.hasExecutionOccupancy(executionID, taskID, sessionID) || !m.executionActivityReleased(executionID) {
+		return ErrExecutionResourcesUnconfirmed
+	}
+	return nil
+}
+
+// 缺少 session 索引的原生任务执行也算占用，不能借用面向正常引用的过滤列表证明清空。
+func (s *ExecutionStore) hasExecutionOccupancy(executionID, taskID, sessionID string) bool {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	for storedID, execution := range s.executions {
+		if storedID == executionID || execution == nil || execution.TaskID == taskID || execution.SessionID == sessionID {
+			return true
+		}
+	}
+	_, indexed := s.bySession[sessionID]
+	return indexed
+}
diff --git b/apps/backend/internal/agent/runtime/lifecycle/executor_standalone_stop_confirmation.go b/apps/backend/internal/agent/runtime/lifecycle/executor_standalone_stop_confirmation.go
new file mode 100644
index 0000000..4054ffd
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/lifecycle/executor_standalone_stop_confirmation.go
@@ -0,0 +1,35 @@
+package lifecycle
+
+import (
+	"context"
+	"errors"
+	"strings"
+
+	agentctl "github.com/kandev/kandev/internal/agent/runtime/agentctl"
+)
+
+var ErrExecutionStopUnconfirmed = errors.New("execution_stop_unconfirmed")
+
+// StopInstanceConfirmed 不把空实例或一次成功返回当作停止证明；只确认同范围实例的删除后置条件。
+func (r *StandaloneExecutor) StopInstanceConfirmed(ctx context.Context, instance *ExecutorInstance, force bool) (bool, error) {
+	if r == nil || r.ctl == nil || instance == nil {
+		return false, ErrExecutionStopUnconfirmed
+	}
+	for _, id := range []string{instance.InstanceID, instance.TaskID, instance.SessionID, instance.StandaloneInstanceID} {
+		if id == "" || len(id) > 256 || strings.TrimSpace(id) != id {
+			return false, ErrExecutionStopUnconfirmed
+		}
+	}
+	before, err := r.ctl.GetInstance(ctx, instance.StandaloneInstanceID)
+	if err != nil || before == nil || before.ID != instance.StandaloneInstanceID || before.TaskID != instance.TaskID || before.SessionID != instance.SessionID {
+		return false, errors.Join(ErrExecutionStopUnconfirmed, err)
+	}
+	if err := r.StopInstance(ctx, instance, force); err != nil {
+		return false, errors.Join(ErrExecutionStopUnconfirmed, err)
+	}
+	_, err = r.ctl.GetInstance(ctx, instance.StandaloneInstanceID)
+	if !errors.Is(err, agentctl.ErrInstanceNotFound) {
+		return false, errors.Join(ErrExecutionStopUnconfirmed, err)
+	}
+	return true, nil
+}
