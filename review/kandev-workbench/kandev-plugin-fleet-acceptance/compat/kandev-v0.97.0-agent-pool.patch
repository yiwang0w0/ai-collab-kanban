+    identity = JSON.parse(fs.readFileSync(path.resolve(identityPath), "utf8")) as E2EBuildIdentity;
+  } catch (error) {
+    throw new Error(`Cannot read E2E build identity ${identityPath}`, { cause: error });
+  }
