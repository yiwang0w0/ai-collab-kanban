@@ -0,0 +1,76 @@
+package sqlite
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+// AppendPoolLaunchAdmissionTx 的同 claim 唯一性由原生写事务保护，不可重放签发。
+func (r *Repository) AppendPoolLaunchAdmissionTx(ctx context.Context, tx *sqlx.Tx, request models.PoolClaimStart) (*models.RunEvent, error) {
+	run, err := r.lockPoolClaimStartTx(ctx, tx, request)
+	if err != nil {
+		return nil, err
+	}
+	var previous []models.RunEvent
+	if err := tx.SelectContext(ctx, &previous, tx.Rebind(`SELECT * FROM run_events
+		WHERE run_id = ? AND event_type = ? AND json_extract(payload, '$.claim_id') = ? ORDER BY seq LIMIT 2`),
+		request.RunID, models.PoolLaunchAdmitted, request.ClaimID); err != nil {
+		return nil, err
+	}
+	if len(previous) > 1 {
+		return nil, ErrPoolReceiptUnknown
+	}
+	if len(previous) == 1 {
+		var stored models.PoolClaimStart
+		if json.Unmarshal([]byte(previous[0].Payload), &stored) != nil || stored.RunID != request.RunID ||
+			stored.ClaimID != request.ClaimID || !stored.Release.MatchesRun(run) {
+			return nil, ErrPoolReceiptUnknown
+		}
+		return nil, models.ErrPoolLaunchAlreadyAdmitted
+	}
+	if err := checkPoolClaimQueueCauseTx(ctx, tx, run, request); err != nil {
+		return nil, err
+	}
+	encoded, err := json.Marshal(request)
+	if err != nil {
+		return nil, err
+	}
+	return insertPoolEvent(ctx, tx, request.RunID, models.PoolLaunchAdmitted, string(encoded))
+}
+
+func (r *Repository) lockPoolClaimStartTx(ctx context.Context, tx *sqlx.Tx, request models.PoolClaimStart) (*models.Run, error) {
+	if dialect.IsPostgres(r.db.DriverName()) || !request.Valid() {
+		return nil, models.ErrPoolClaimStartConflict
+	}
+	result, err := tx.ExecContext(ctx, tx.Rebind(`UPDATE runs SET id = id WHERE id = ? AND status = 'claimed'`), request.RunID)
+	if err != nil {
+		return nil, err
+	}
+	count, err := result.RowsAffected()
+	if err != nil {
+		return nil, err
+	}
+	if count != 1 {
+		return nil, models.ErrPoolClaimStartConflict
+	}
+	run, err := r.GetRunByIDTx(ctx, tx, request.RunID)
+	if err != nil {
+		return nil, err
+	}
+	if !request.Release.MatchesRun(run) || run.SessionID != "" {
+		return nil, models.ErrPoolClaimStartConflict
+	}
+	claimID, err := currentPoolClaimID(ctx, tx, run)
+	if err != nil {
+		return nil, err
+	}
+	if claimID != request.ClaimID {
+		return nil, models.ErrPoolClaimStartConflict
+	}
+	return run, nil
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_mutation_isolation_test.go b/apps/backend/internal/runs/repository/sqlite/pool_mutation_isolation_test.go
new file mode 100644
index 0000000..dee03be
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_mutation_isolation_test.go
@@ -0,0 +1,62 @@
+package sqlite_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/kandev/kandev/internal/runs/models"
+	runssqlite "github.com/kandev/kandev/internal/runs/repository/sqlite"
+)
+
+// @covers AC-TASKS-AGENT-POOL-001.3 AC-TASKS-AGENT-POOL-002.3
+func TestPoolMutationIsolation(t *testing.T) {
+	t.Run("coalesce", func(t *testing.T) { assertPoolCoalesceIsolation(t, newTestRepo(t)) })
+	t.Run("session", func(t *testing.T) { assertPoolSessionBindingIsolation(t, newTestRepo(t)) })
+}
+
+func TestPoolMutationIsolationPostgres(t *testing.T) {
+	t.Run("coalesce", func(t *testing.T) { assertPoolCoalesceIsolation(t, newTestRepoPostgres(t)) })
+	t.Run("session", func(t *testing.T) { assertPoolSessionBindingIsolation(t, newTestRepoPostgres(t)) })
+}
+
+func assertPoolCoalesceIsolation(t *testing.T, repo *runssqlite.Repository) {
+	t.Helper()
+	ordinary := mustCreateRun(t, repo, &models.Run{
+		ID: "ordinary", AgentProfileID: "fixed-cli", Reason: "explicit_queue",
+		Payload: `{"task_id":"task","original":"ordinary"}`, Status: "queued", CoalescedCount: 1,
+	})
+	setRequestedAt(t, repo, ordinary.ID, time.Now().UTC().Add(-time.Minute))
+	key := models.PoolDispatchKeyPrefix + "trusted-entry"
+	pool := mustCreateRun(t, repo, &models.Run{
+		ID: "pool", AgentProfileID: "fixed-cli", Reason: "explicit_queue", IdempotencyKey: &key,
+		Payload: `{"task_id":"task","original":"pool"}`, Status: "queued", CoalescedCount: 1,
+	})
+	merged, err := repo.CoalesceRun(context.Background(), "fixed-cli", "explicit_queue", 3600, `{"task_id":"task","updated":true}`)
+	if err != nil || !merged {
+		t.Fatalf("普通合并应继续可用: %v, %v", merged, err)
+	}
+	storedPool := mustGetRun(t, repo, pool.ID)
+	storedOrdinary := mustGetRun(t, repo, ordinary.ID)
+	if storedPool.Payload != pool.Payload || storedPool.CoalescedCount != 1 || storedOrdinary.CoalescedCount != 2 {
+		t.Fatalf("普通唤醒不得覆盖池发布快照: pool=%+v ordinary=%+v", storedPool, storedOrdinary)
+	}
+}
+
+func assertPoolSessionBindingIsolation(t *testing.T, repo *runssqlite.Repository) {
+	t.Helper()
+	key := models.PoolDispatchKeyPrefix + "trusted-entry"
+	pool := mustCreateRun(t, repo, &models.Run{ID: "pool-session", AgentProfileID: "fixed-cli",
+		Status: "claimed", IdempotencyKey: &key, SessionID: "current-session"})
+	ctx := context.Background()
+	if wrote, err := repo.SetRunSessionID(ctx, pool.ID, "late-unfenced-session"); err != nil || wrote {
+		t.Fatalf("无领取身份的旧回调不得写入池会话: %v, %v", wrote, err)
+	}
+	if current := mustGetRun(t, repo, pool.ID); current.SessionID != "current-session" {
+		t.Fatalf("旧回调覆盖了当前池会话: %+v", current)
+	}
+	ordinary := mustCreateRun(t, repo, &models.Run{ID: "ordinary-session", AgentProfileID: "fixed-cli", Status: "claimed"})
+	if wrote, err := repo.SetRunSessionID(ctx, ordinary.ID, "ordinary-session-id"); err != nil || !wrote {
+		t.Fatalf("普通运行的会话写入应保持原行为: %v, %v", wrote, err)
+	}
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_publish.go b/apps/backend/internal/runs/repository/sqlite/pool_publish.go
new file mode 100644
index 0000000..58144ec
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_publish.go
@@ -0,0 +1,63 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+var ErrPoolDispatchAmbiguous = errors.New("pool_dispatch_identity_ambiguous")
+
+// LockPoolTaskTx 只预留 SQLite 写权，不更改任务版本或伪造任务事件。
+func (r *Repository) LockPoolTaskTx(ctx context.Context, tx *sqlx.Tx, taskID string) error {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return errors.New("pool_dispatch_unsupported_storage")
+	}
+	result, err := tx.ExecContext(ctx, tx.Rebind(`UPDATE tasks SET id = id WHERE id = ?`), taskID)
+	if err != nil {
+		return err
+	}
+	count, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if count != 1 {
+		return sql.ErrNoRows
+	}
+	return nil
+}
+
+// FindPoolRunByKeyTx 使用持久唯一键，不以通用通知的时间窗限制去重。
+func (r *Repository) FindPoolRunByKeyTx(ctx context.Context, tx *sqlx.Tx, key string) (*models.Run, error) {
+	var runs []*models.Run
+	if err := tx.SelectContext(ctx, &runs, tx.Rebind(`SELECT * FROM runs WHERE idempotency_key = ? LIMIT 2`), key); err != nil {
+		return nil, err
+	}
+	if len(runs) > 1 {
+		return nil, ErrPoolDispatchAmbiguous
+	}
+	if len(runs) == 0 {
+		return nil, nil
+	}
+	return runs[0], nil
+}
+
+// FindActivePoolRunForTaskTx 不按 Profile 分桶；同一主卡不能同时拥有两份池执行权。
+func (r *Repository) FindActivePoolRunForTaskTx(ctx context.Context, tx *sqlx.Tx, taskID string) (string, error) {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return "", errors.New("pool_dispatch_unsupported_storage")
+	}
+	var runID string
+	err := tx.QueryRowContext(ctx, tx.Rebind(`SELECT id FROM runs WHERE status IN ('queued', 'claimed')
+		AND idempotency_key LIKE ? AND json_extract(payload, '$.task_id') = ?
+		ORDER BY requested_at, id LIMIT 1`), models.PoolDispatchKeyPrefix+"%", taskID).Scan(&runID)
+	if errors.Is(err, sql.ErrNoRows) {
+		return "", nil
+	}
+	return runID, err
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_receipts.go b/apps/backend/internal/runs/repository/sqlite/pool_receipts.go
new file mode 100644
index 0000000..859f377
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_receipts.go
@@ -0,0 +1,190 @@
+package sqlite
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+var (
+	ErrPoolReceiptConflict = errors.New("pool_receipt_identity_conflict")
+	ErrPoolReceiptUnknown  = errors.New("pool_receipt_evidence_unknown")
+)
+
+func (r *Repository) AppendPoolExecutionBinding(ctx context.Context, identity models.PoolExecutionIdentity) (*models.RunEvent, error) {
+	return r.appendPoolReceipt(ctx, identity, "")
+}
+
+func (r *Repository) AppendPoolWorkObserved(
+	ctx context.Context, identity models.PoolExecutionIdentity, source models.PoolStartSource,
+) (*models.RunEvent, error) {
+	switch source {
+	case models.PoolStartCodexProvider, models.PoolStartAssistant, models.PoolStartTool:
+		return r.appendPoolReceipt(ctx, identity, source)
+	default:
+		return nil, ErrPoolReceiptConflict
+	}
+}
+
+func validPoolIdentity(identity models.PoolExecutionIdentity) bool {
+	ids := []string{identity.RunID, identity.ClaimID, identity.TaskID, identity.AgentProfileID,
+		identity.ExecutionProfileID, identity.SessionID, identity.ExecutionID, identity.TurnID, identity.OperationID}
+	for _, id := range ids {
+		if strings.TrimSpace(id) != id || id == "" || len(id) > 256 {
+			return false
+		}
+	}
+	if identity.OperationSource != "" && identity.OperationSource != models.PoolOperationProvider &&
+		identity.OperationSource != models.PoolOperationHostTurn {
+		return false
+	}
+	return identity.PromptGeneration > 0 && identity.ExecutionProfileID == identity.AgentProfileID &&
+		(identity.OperationSource != models.PoolOperationHostTurn || identity.OperationID == identity.TurnID)
+}
+
+func (r *Repository) appendPoolReceipt(
+	ctx context.Context, identity models.PoolExecutionIdentity, source models.PoolStartSource,
+) (*models.RunEvent, error) {
+	if !validPoolIdentity(identity) {
+		return nil, ErrPoolReceiptConflict
+	}
+	// 首版只支持 SQLite；不能把未验收的存储行为当作已支持能力。
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return nil, errors.New("pool_receipts_unsupported_storage")
+	}
+	tx, err := r.db.BeginTxx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = tx.Rollback() }()
+	if err := r.lockPoolClaim(ctx, tx, identity); err != nil {
+		return nil, err
+	}
+	event, err := r.writePoolReceipt(ctx, tx, identity, source)
+	if err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	return event, nil
+}
+
+func (r *Repository) lockPoolClaim(ctx context.Context, tx *sqlx.Tx, identity models.PoolExecutionIdentity) error {
+	// 先取得写锁再读取身份，避免从过期读快照升级事务。
+	res, err := tx.ExecContext(ctx, tx.Rebind(`UPDATE runs SET id = id WHERE id = ? AND status = 'claimed'`), identity.RunID)
+	if err != nil {
+		return err
+	}
+	n, err := res.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return ErrPoolReceiptConflict
+	}
+	run, err := r.GetRunByIDTx(ctx, tx, identity.RunID)
+	if err != nil {
+		return err
+	}
+	var envelope struct {
+		TaskID string `json:"task_id"`
+	}
+	if run.IdempotencyKey == nil || !strings.HasPrefix(*run.IdempotencyKey, models.PoolDispatchKeyPrefix) ||
+		run.AgentProfileID != identity.AgentProfileID || run.ClaimedAt == nil ||
+		json.Unmarshal([]byte(run.Payload), &envelope) != nil || envelope.TaskID != identity.TaskID {
+		return ErrPoolReceiptConflict
+	}
+	claimID, err := currentPoolClaimID(ctx, tx, run)
+	if err != nil {
+		return err
+	}
+	if claimID != identity.ClaimID {
+		return ErrPoolReceiptConflict
+	}
+	return nil
+}
+
+func (r *Repository) writePoolReceipt(
+	ctx context.Context, tx *sqlx.Tx, identity models.PoolExecutionIdentity, source models.PoolStartSource,
+) (*models.RunEvent, error) {
+	bound, err := findPoolReceipt(ctx, tx, identity, models.PoolExecutionBound)
+	if err != nil {
+		return nil, err
+	}
+	if source == "" && bound != nil {
+		return bound, nil
+	}
+	if source != "" {
+		if bound == nil {
+			return nil, ErrPoolReceiptUnknown
+		}
+		previous, err := findPoolReceipt(ctx, tx, identity, models.PoolWorkObserved)
+		if err != nil || previous != nil {
+			return previous, err
+		}
+	}
+	if _, err := tx.ExecContext(ctx, tx.Rebind(`UPDATE runs SET session_id = ? WHERE id = ?`), identity.SessionID, identity.RunID); err != nil {
+		return nil, err
+	}
+	kind := models.PoolExecutionBound
+	var payload any = identity
+	if source != "" {
+		kind = models.PoolWorkObserved
+		payload = models.PoolWorkReceipt{PoolExecutionIdentity: identity, StartedSource: source}
+	}
+	encoded, err := json.Marshal(payload)
+	if err != nil {
+		return nil, err
+	}
+	return insertPoolEvent(ctx, tx, identity.RunID, kind, string(encoded))
+}
+
+func findPoolReceipt(
+	ctx context.Context, tx *sqlx.Tx, identity models.PoolExecutionIdentity, kind string,
+) (*models.RunEvent, error) {
+	var events []models.RunEvent
+	if err := tx.SelectContext(ctx, &events, tx.Rebind(`
+		SELECT run_id, seq, event_type, level, payload, created_at FROM run_events
+		WHERE run_id = ? AND event_type = ? AND json_extract(payload, '$.claim_id') = ?
+			ORDER BY seq LIMIT 2`), identity.RunID, kind, identity.ClaimID); err != nil {
+		return nil, err
+	}
+	if len(events) > 1 {
+		return nil, ErrPoolReceiptUnknown
+	}
+	if len(events) == 0 {
+		return nil, nil
+	}
+	var stored models.PoolExecutionIdentity
+	if err := json.Unmarshal([]byte(events[0].Payload), &stored); err != nil {
+		return nil, fmt.Errorf("%w: invalid binding", ErrPoolReceiptUnknown)
+	}
+	if stored != identity {
+		return nil, ErrPoolReceiptConflict
+	}
+	return &events[0], nil
+}
+
+func insertPoolEvent(ctx context.Context, tx *sqlx.Tx, runID, kind, payload string) (*models.RunEvent, error) {
+	var seq int
+	if err := tx.GetContext(ctx, &seq, tx.Rebind(`SELECT COALESCE(MAX(seq) + 1, 0) FROM run_events WHERE run_id = ?`), runID); err != nil {
+		return nil, err
+	}
+	observed := time.Now().UTC()
+	if _, err := tx.ExecContext(ctx, tx.Rebind(`
+		INSERT INTO run_events (run_id, seq, event_type, level, payload, created_at)
+		VALUES (?, ?, ?, 'info', ?, ?)`), runID, seq, kind, payload, observed); err != nil {
+		return nil, err
+	}
+	return &models.RunEvent{RunID: runID, Seq: seq, EventType: models.RunEventType(kind),
+		Level: models.RunEventLevelInfo, Payload: payload, CreatedAt: observed}, nil
+}
