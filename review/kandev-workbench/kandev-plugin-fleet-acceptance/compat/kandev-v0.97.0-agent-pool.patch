+      workspaceId,
+      cursors: next ? [...cursors, read.data!.next_cursor] : cursors.slice(0, -1),
+    });
+    if (selectedId) select("");
+  };
+  return {
+    workspaceId,
+    workflowId,
+    desktop,
+    filters,
+    setFilters,
+    category,
+    setCategory,
+    filterOpen,
+    setFilterOpen,
+    createOpen,
+    setCreateOpen,
+    cursors,
+    read,
+    cards,
+    filtered,
+    visible,
+    selectedId,
+    selected,
+    freshness,
+    select,
+    changePage,
+    position,
+  };
+}
+
+export type TaskPoolPageState = ReturnType<typeof useTaskPoolPage>;
