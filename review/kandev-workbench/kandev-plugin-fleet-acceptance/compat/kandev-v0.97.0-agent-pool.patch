+}
+
+func (m *poolCaptureManagerFake) EnableWorkActivity(_ context.Context, executionID, turnID string) error {
+	m.called++
+	if executionID != "actual-execution" || turnID != "actual-turn" {
+		return runsmodels.ErrPoolClaimStartConflict
+	}
+	return nil
+}
+
+// @covers AC-TASKS-AGENT-POOL-002.1 AC-TASKS-AGENT-POOL-005.4
+func TestPoolExecutionAdmissionRejectsMissingCapabilityOrUnboundAcknowledgement(t *testing.T) {
+	for _, kind := range []string{"valid", "no-binder", "no-capture", "nil-event", "wrong-run", "wrong-execution", "wrong-type", "malformed"} {
+		t.Run(kind, func(t *testing.T) {
+			request, err := poolStartShape(t).PoolStartRequest()
+			require.NoError(t, err)
+			capture := &poolCaptureManagerFake{}
+			svc := &Service{agentManager: capture}
+			guard := poolExecutionGuardFake{bind: func(_ context.Context, _ runsmodels.PoolClaimStart, identity runsmodels.PoolExecutionIdentity) (*runsmodels.RunEvent, error) {
+				stored := identity
+				if kind == "wrong-execution" {
+					stored.ExecutionID = "unbound-execution"
+				}
+				payload, err := json.Marshal(runsmodels.PoolExecutionAllocation{PoolExecutionIdentity: stored, AgentType: "claude-acp"})
+				require.NoError(t, err)
+				event := &runsmodels.RunEvent{RunID: request.RunID, EventType: runsmodels.PoolExecutionAllocated, Payload: string(payload)}
+				switch kind {
+				case "nil-event":
+					return nil, nil
+				case "wrong-run":
+					event.RunID = "other-run"
+				case "wrong-type":
+					event.EventType = "step"
+				case "malformed":
+					event.Payload = "broken-json"
+				}
+				return event, nil
+			}}
+			svc.poolTaskStartGuard = guard
+			if kind == "no-binder" {
+				svc.poolTaskStartGuard = poolStartGuardFunc(func(context.Context, string) error { return nil })
+			}
+			if kind == "no-capture" {
+				svc.agentManager = nil
+			}
+			admit := svc.poolExecutionStartAdmission(context.Background(), &request, "actual-session", "actual-turn", request.Release.AgentProfileID)
+			err = admit("actual-execution")
+			if kind == "valid" {
+				require.NoError(t, err)
+				require.Equal(t, 1, capture.called)
+			} else {
+				require.Error(t, err)
+				require.Zero(t, capture.called, "未得到同一执行的持久分配时不能开启原生活动捕获")
+			}
+		})
+	}
+}
diff --git b/apps/backend/internal/orchestrator/pool_projection.go b/apps/backend/internal/orchestrator/pool_projection.go
new file mode 100644
index 0000000..2c4c6d8
--- /dev/null
+++ b/apps/backend/internal/orchestrator/pool_projection.go
@@ -0,0 +1,61 @@
+package orchestrator
+
+import (
+	"context"
+
+	"go.uber.org/zap"
+
+	"github.com/kandev/kandev/internal/events"
+	"github.com/kandev/kandev/internal/events/bus"
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+)
+
+const maxPoolProjectionStamps = 128
+
+type poolProjectionKey struct {
+	TaskID  string
+	RunID   string
+	ClaimID string
+	Domain  string
+}
+
+// ObservePoolCommit 复用已有原生后续工作所有者，避免在执行回调锁内重建摘要。
+func (s *Service) ObservePoolCommit(change runsmodels.PoolProjectionCommit) {
+	if s.eventBus == nil || change.TaskID == "" || change.RunID == "" || len(change.TaskID) > 256 ||
+		len(change.RunID) > 256 || len(change.ClaimID) > 256 || !s.acceptPoolProjectionStamp(change) {
+		return
+	}
+	s.startOwnedLifecycleFollowup(func(ctx context.Context) {
+		event := bus.NewEvent(events.TaskPoolExecutionCommitted, "native-pool", map[string]any{"task_id": change.TaskID})
+		if err := s.eventBus.Publish(ctx, events.TaskPoolExecutionCommitted, event); err != nil {
+			s.logger.Warn("池摘要提交后通知未确认", zap.String("task_id", change.TaskID), zap.Error(err))
+		}
+	})
+}
+
+func (s *Service) acceptPoolProjectionStamp(change runsmodels.PoolProjectionCommit) bool {
+	key := poolProjectionKey{TaskID: change.TaskID, RunID: change.RunID, ClaimID: change.ClaimID}
+	if change.Kind == runsmodels.PoolProjectionHistoryCleaned {
+		key.Domain = runsmodels.PoolProjectionHistoryCleaned
+	}
+	if change.Kind == runsmodels.PoolProjectionRecovery {
+		key.Domain = runsmodels.PoolProjectionRecovery
+	}
+	s.poolProjectionMu.Lock()
+	defer s.poolProjectionMu.Unlock()
+	if s.poolProjectionSeen == nil {
+		s.poolProjectionSeen = make(map[poolProjectionKey]int)
+	}
+	if previous, found := s.poolProjectionSeen[key]; found && previous >= change.Sequence {
+		return false
+	}
+	if _, found := s.poolProjectionSeen[key]; !found {
+		if len(s.poolProjectionOrder) == maxPoolProjectionStamps {
+			delete(s.poolProjectionSeen, s.poolProjectionOrder[0])
+			s.poolProjectionOrder = s.poolProjectionOrder[1:]
+		}
+		s.poolProjectionOrder = append(s.poolProjectionOrder, key)
+	}
+	s.poolProjectionSeen[key] = change.Sequence
+	return true
+}
