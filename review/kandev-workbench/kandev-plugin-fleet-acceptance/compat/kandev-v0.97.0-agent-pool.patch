-		}
-	}
-	if agentErr, aok := agentErrorPayload(in.Payload); aok {
-		if agentErr.FailedAgentID != "" {
-			out["failed_agent_id"] = agentErr.FailedAgentID
-		}
-		if agentErr.FailedSessionID != "" {
-			out["failed_session_id"] = agentErr.FailedSessionID
