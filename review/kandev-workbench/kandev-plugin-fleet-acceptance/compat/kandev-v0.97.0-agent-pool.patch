@@ -0,0 +1,53 @@
+import { beforeEach, expect, it } from "vitest";
+import {
+  forgetPendingPoolRecovery,
+  readPendingPoolRecovery,
+  savePendingPoolRecovery,
+} from "./task-pool-recovery-pending";
+import type { PoolRecoveryCommand } from "./types/task-pool-recovery";
+
+function command(index = 1): PoolRecoveryCommand {
+  return {
+    action: "withdraw",
+    operation_id: `00000000-0000-4000-8000-${index.toString().padStart(12, "0")}`,
+    run_id: "run",
+    expected_claim_id: "",
+    expected_task_version: "2026-10-20T00:00:00.123456789Z",
+    expected_run_version: "a".repeat(64),
+    expected_management_version: "",
+    confirm: true,
+    confirm_cli_quota: false,
+  };
+}
+beforeEach(() => sessionStorage.clear());
+
+it("待查询凭据按宿主、用户和任务作用域隔离，不跨运行借用", () => {
+  savePendingPoolRecovery("host:user:task", command());
+  expect(readPendingPoolRecovery("host:other-user:task", "run")).toBeNull();
+  expect(readPendingPoolRecovery("other-host:user:task", "run")).toBeNull();
+  expect(readPendingPoolRecovery("host:user:task", "run")).toEqual(command());
+  expect(() => readPendingPoolRecovery("host:user:task", "other-run")).toThrow();
+});
+
+it("未解决的同作用域凭据不能被新操作覆盖，旧响应不能删除新凭据", () => {
+  savePendingPoolRecovery("scope", command());
+  expect(() => savePendingPoolRecovery("scope", command(2))).toThrow();
+  forgetPendingPoolRecovery("scope", command(2).operation_id);
+  expect(readPendingPoolRecovery("scope", "run")).toEqual(command());
+  forgetPendingPoolRecovery("scope", command().operation_id);
+  expect(readPendingPoolRecovery("scope", "run")).toBeNull();
+});
+
+it("最多保存三十二项，满额不丢弃未知凭据来允许新写入", () => {
+  for (let index = 1; index <= 32; index++)
+    savePendingPoolRecovery(`scope:${index}`, command(index));
+  expect(() => savePendingPoolRecovery("scope:33", command(33))).toThrow();
+  expect(readPendingPoolRecovery("scope:1", "run")).toEqual(command(1));
+});
+
+it("损坏或过量会话存储失败关闭，不能被解释成没有待确认操作", () => {
+  for (const raw of ["{", "{}", "x".repeat(65537)]) {
+    sessionStorage.setItem("kandev.pool-recovery-pending.v1", raw);
+    expect(() => readPendingPoolRecovery("scope", "run")).toThrow();
+  }
+});
diff --git b/apps/web/lib/task-pool-recovery-pending.ts b/apps/web/lib/task-pool-recovery-pending.ts
new file mode 100644
index 0000000..fd160a7
--- /dev/null
+++ b/apps/web/lib/task-pool-recovery-pending.ts
@@ -0,0 +1,56 @@
+import { validPoolRecoveryOperationId } from "./task-pool-recovery";
+import type { PoolRecoveryCommand } from "./types/task-pool-recovery";
+
+const storageKey = "kandev.pool-recovery-pending.v1";
+type Entry = { scope: string; command: PoolRecoveryCommand };
+
+function validEntry(item: Entry) {
+  return (
+    !!item &&
+    typeof item.scope === "string" &&
+    item.scope.length <= 2048 &&
+    !!item.command &&
+    validPoolRecoveryOperationId(item.command.operation_id) &&
+    ["withdraw", "stop", "retry"].includes(item.command.action) &&
+    typeof item.command.run_id === "string" &&
+    item.command.run_id.length <= 256 &&
+    typeof item.command.expected_claim_id === "string" &&
+    item.command.expected_claim_id.length <= 256
+  );
+}
+
+// 只保留当前标签页待查询的操作凭据；不是任务、执行或成功事实的来源。
+function entries(): Entry[] {
+  const raw = sessionStorage.getItem(storageKey);
+  if (!raw) return [];
+  if (raw.length > 65536) throw new Error("pool_recovery_pending_unavailable");
+  const value: unknown = JSON.parse(raw);
+  if (!Array.isArray(value) || value.length > 32)
+    throw new Error("pool_recovery_pending_unavailable");
+  if (!value.every(validEntry)) throw new Error("pool_recovery_pending_unavailable");
+  return value;
+}
+
+export function readPendingPoolRecovery(scope: string, runId: string) {
+  const command = entries().find((item) => item.scope === scope)?.command ?? null;
+  if (command && command.run_id !== runId) throw new Error("pool_recovery_pending_unavailable");
+  return command;
+}
+
+export function savePendingPoolRecovery(scope: string, command: PoolRecoveryCommand) {
+  const previous = entries();
+  if (previous.some((item) => item.scope === scope))
+    throw new Error("pool_recovery_pending_unresolved");
+  if (previous.length >= 32 || scope.length > 2048)
+    throw new Error("pool_recovery_pending_unavailable");
+  const encoded = JSON.stringify([...previous, { scope, command }]);
+  if (encoded.length > 65536) throw new Error("pool_recovery_pending_unavailable");
+  sessionStorage.setItem(storageKey, encoded);
+}
+
+export function forgetPendingPoolRecovery(scope: string, operationId: string) {
+  const remaining = entries().filter(
+    (item) => item.scope !== scope || item.command.operation_id !== operationId,
+  );
+  sessionStorage.setItem(storageKey, JSON.stringify(remaining));
+}
