+describe("工作台作用域和失效读取", () => {
+  it("自动读取失败后退避三十秒，期间不反复请求", async () => {
+    vi.useFakeTimers();
+    const loader = vi
+      .fn()
+      .mockRejectedValueOnce(new Error("临时不可用"))
+      .mockResolvedValue("恢复后的快照");
+    const { result } = renderHook(() => usePoolRead("A", loader));
+    await act(async () => {});
+    expect(result.current.error).toBeTruthy();
+    await act(async () => vi.advanceTimersByTimeAsync(10_000));
+    expect(loader).toHaveBeenCalledOnce();
+    await act(async () => vi.advanceTimersByTimeAsync(20_000));
+    expect(loader).toHaveBeenCalledTimes(2);
+    expect(result.current.data).toBe("恢复后的快照");
+  });
+  it("隐藏页面不发起新读取，重新可见后才核实状态", async () => {
+    const visibility = vi.spyOn(document, "visibilityState", "get").mockReturnValue("hidden");
+    const loader = vi.fn().mockResolvedValue("恢复可见后的快照");
+    const { result } = renderHook(() => usePoolRead("A", loader));
+    await act(async () => {});
+    expect(loader).not.toHaveBeenCalled();
+    visibility.mockReturnValue("visible");
+    act(() => document.dispatchEvent(new Event("visibilitychange")));
+    await waitFor(() => expect(result.current.data).toBe("恢复可见后的快照"));
+  });
+  it("切换工作区后拒绝迟到数据和旧错误，不显示上一个工作区", async () => {
+    let resolveFirst!: (value: string) => void;
+    const loader = vi
+      .fn()
+      .mockImplementationOnce(
+        () =>
+          new Promise<string>((resolve) => {
+            resolveFirst = resolve;
+          }),
+      )
+      .mockResolvedValueOnce("B 的记录");
+    const { result, rerender } = renderHook(({ scope }) => usePoolRead(scope, loader), {
+      initialProps: { scope: "A" },
+    });
+    await waitFor(() => expect(loader).toHaveBeenCalledOnce());
+    rerender({ scope: "B" });
+    expect(result.current.data).toBeNull();
+    await waitFor(() => expect(result.current.data).toBe("B 的记录"));
+    await act(async () => resolveFirst("A 的旧记录"));
+    expect(result.current.data).toBe("B 的记录");
+  });
+  it("刷新失败保留最后确认数据和时刻，但明确记录错误", async () => {
+    const loader = vi.fn().mockResolvedValueOnce("已领取").mockRejectedValueOnce(new Error("断线"));
+    const { result } = renderHook(() => usePoolRead("A", loader));
+    await waitFor(() => expect(result.current.data).toBe("已领取"));
+    const confirmed = result.current.confirmedAt;
+    await act(async () => result.current.refresh());
+    expect(result.current.data).toBe("已领取");
+    expect(result.current.confirmedAt).toBe(confirmed);
+    expect(result.current.error).toBeTruthy();
+  });
+  it("同作用域的旧读取不能覆盖手动刷新后的结果", async () => {
+    let resolveFirst!: (value: string) => void;
+    const loader = vi
+      .fn()
+      .mockImplementationOnce(
+        () =>
+          new Promise<string>((resolve) => {
+            resolveFirst = resolve;
+          }),
+      )
+      .mockResolvedValueOnce("新快照");
+    const { result } = renderHook(() => usePoolRead("A", loader));
+    await waitFor(() => expect(loader).toHaveBeenCalledOnce());
+    await act(async () => result.current.refresh());
+    await act(async () => resolveFirst("旧快照"));
+    expect(result.current.data).toBe("新快照");
+  });
+});
diff --git b/apps/web/hooks/domains/task/use-task-pool.ts b/apps/web/hooks/domains/task/use-task-pool.ts
new file mode 100644
index 0000000..1b80c57
--- /dev/null
+++ b/apps/web/hooks/domains/task/use-task-pool.ts
@@ -0,0 +1,119 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useAppStore } from "@/components/state-provider";
+import { fetchTaskPool, fetchTaskPoolHistory } from "@/lib/api/domains/task-pool-api";
+
+type ReadState<T> = {
+  scope: string;
+  data: T | null;
+  confirmedAt: number | null;
+  error: unknown;
+  loading: boolean;
+};
+
+export function usePoolRead<T>(
+  scope: string,
+  load: (signal: AbortSignal) => Promise<T>,
+  invalidation?: unknown,
+) {
+  const loader = useRef(load);
+  const currentScope = useRef(scope);
+  loader.current = load;
+  currentScope.current = scope;
+  const request = useRef({ sequence: 0, controller: null as AbortController | null });
+  const retryAfter = useRef({ scope: "", until: 0 });
+  const [state, setState] = useState<ReadState<T>>({
+    scope,
+    data: null,
+    confirmedAt: null,
+    error: null,
+    loading: true,
+  });
+  const refresh = useCallback(async () => {
+    if (!scope || currentScope.current !== scope || document.visibilityState !== "visible") return;
+    request.current.controller?.abort();
+    const controller = new AbortController();
+    const sequence = ++request.current.sequence;
+    request.current.controller = controller;
+    const isCurrent = () =>
+      !controller.signal.aborted &&
+      request.current.sequence === sequence &&
+      currentScope.current === scope;
+    setState((previous) =>
+      previous.scope === scope
+        ? { ...previous, loading: true }
+        : { scope, data: null, confirmedAt: null, error: null, loading: true },
+    );
+    try {
+      const data = await loader.current(controller.signal);
+      if (isCurrent()) {
+        retryAfter.current = { scope, until: 0 };
+        setState({ scope, data, confirmedAt: Date.now(), error: null, loading: false });
+      }
+    } catch (error) {
+      if (isCurrent()) {
+        retryAfter.current = { scope, until: Date.now() + 30_000 };
+        setState((previous) => ({ ...previous, error, loading: false }));
+      }
+    }
+  }, [scope]);
+  useEffect(() => {
+    if (retryAfter.current.scope !== scope || Date.now() >= retryAfter.current.until)
+      void refresh();
+    return () => {
+      request.current.controller?.abort();
+      request.current.sequence++;
+    };
+  }, [refresh, scope, invalidation]);
+  useEffect(() => {
+    const refreshVisible = () => {
+      if (
+        document.visibilityState === "visible" &&
+        (retryAfter.current.scope !== scope || Date.now() >= retryAfter.current.until)
+      )
+        void refresh();
+    };
+    const interval = setInterval(refreshVisible, 10_000);
+    window.addEventListener("online", refreshVisible);
+    window.addEventListener("focus", refreshVisible);
+    document.addEventListener("visibilitychange", refreshVisible);
+    return () => {
+      clearInterval(interval);
+      window.removeEventListener("online", refreshVisible);
+      window.removeEventListener("focus", refreshVisible);
+      document.removeEventListener("visibilitychange", refreshVisible);
+    };
+  }, [refresh, scope]);
+  const visible =
+    state.scope === scope
+      ? state
+      : { scope, data: null, confirmedAt: null, error: null, loading: true };
+  return { ...visible, refresh };
+}
+
+export function useTaskPool(workspaceId: string | null, cursor: string) {
+  const generation = useAppStore((state) => state.workspaceContextGeneration);
+  const invalidation = useAppStore((state) =>
+    workspaceId ? state.sidebarStatusSummaryByWorkspaceId?.[workspaceId] : undefined,
+  );
+  return usePoolRead(
+    workspaceId ? `${workspaceId}:${generation}:${cursor}` : "",
+    async (signal) => {
+      const page = await fetchTaskPool(workspaceId!, cursor, { init: { signal } });
+      if (page.workspace_id !== workspaceId || page.items.length > 50)
+        throw new Error("pool_projection_unavailable");
+      return page;
+    },
+    invalidation,
+  );
+}
+
+export function useTaskPoolHistory(taskId: string, cursor: string) {
+  return usePoolRead(`${taskId}:${cursor}`, async (signal) => {
+    const page = await fetchTaskPoolHistory(taskId, cursor, { init: { signal } });
+    if (page.task_id !== taskId || page.items.length > 50)
+      throw new Error("pool_history_unavailable");
+    return page;
+  });
+}
