@@ -0,0 +1,32 @@
+package poolhistory
+
+import runsmodels "github.com/kandev/kandev/internal/runs/models"
+
+func clearanceForEntry(snapshot *Snapshot, entry Entry) (*runsmodels.PoolHistoryClearance, bool) {
+	key, _ := (runsmodels.PoolReleaseSnapshot{WorkspaceID: snapshot.WorkspaceID, TaskID: snapshot.TaskID, EntryID: entry.ID}).DispatchKey()
+	var match *runsmodels.PoolHistoryClearance
+	present := false
+	for i := range snapshot.Clearances {
+		candidate := &snapshot.Clearances[i]
+		if candidate.DispatchKey != key {
+			continue
+		}
+		if present {
+			return nil, true
+		}
+		present = true
+		release, valid := candidate.Release()
+		if valid && candidate.WorkspaceID == snapshot.WorkspaceID && releaseMatchesEntry(release, snapshot.TaskID, entry) {
+			match = candidate
+		}
+	}
+	return match, present
+}
+
+func projectClearance(item Item, clearance *runsmodels.PoolHistoryClearance) Item {
+	release, _ := clearance.Release()
+	item.RunID, item.PlannedAgentProfileID = clearance.RunID, release.AgentProfileID
+	item.QueuedAt = &clearance.RequestedAt
+	item.State, item.Reason, item.Current = stateUnknown, "history_cleaned", false
+	return item
+}
diff --git b/apps/backend/internal/task/poolhistory/evidence_test.go b/apps/backend/internal/task/poolhistory/evidence_test.go
new file mode 100644
index 0000000..9bc193a
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/evidence_test.go
@@ -0,0 +1,163 @@
+package poolhistory
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+	"github.com/kandev/kandev/internal/steptelemetry"
+	"github.com/stretchr/testify/require"
+)
+
+// 此夹具复用原生序列化类型及身份工厂，仅证明消费者契约，不冒充实际模型或宿主执行。
+func receiptSnapshot(t *testing.T, finished bool) *Snapshot {
+	t.Helper()
+	at := time.Date(2026, 10, 19, 0, 0, 0, 0, time.UTC)
+	release := runsmodels.PoolReleaseSnapshot{TaskID: "task", WorkspaceID: "workspace", WorkflowID: "workflow",
+		WorkflowStepID: "step", EntryID: 1, AgentProfileID: "profile", ActorID: "human", ReleasedAt: at}
+	key, err := release.DispatchKey()
+	require.NoError(t, err)
+	payload, err := json.Marshal(map[string]any{"task_id": release.TaskID, "workflow_step_id": release.WorkflowStepID,
+		"agent_profile_id": release.AgentProfileID, "pool_release": release})
+	require.NoError(t, err)
+	claimedAt := at.Add(2 * time.Second)
+	run := &runsmodels.Run{ID: "run", WorkspaceID: release.WorkspaceID, AgentProfileID: release.AgentProfileID,
+		Reason: runsmodels.PoolDispatchReason, Status: runsmodels.RunStatusClaimed, IdempotencyKey: &key, Payload: string(payload),
+		ActorKind: runsmodels.ActorKindUser, ActorID: release.ActorID, CoalescedCount: 1, RequestedAt: at.Add(time.Second),
+		ClaimedAt: &claimedAt, SessionID: "session"}
+	request, err := (&runsmodels.ClaimedRun{Run: run, ClaimID: "claim"}).PoolStartRequest()
+	require.NoError(t, err)
+	allocation := runsmodels.PoolExecutionAllocation{PoolExecutionIdentity: runsmodels.PoolExecutionIdentity{
+		RunID: run.ID, ClaimID: "claim", TaskID: release.TaskID, AgentProfileID: release.AgentProfileID, ExecutionProfileID: release.AgentProfileID,
+		SessionID: "session", ExecutionID: "execution", TurnID: "turn", PromptGeneration: 1}, AgentType: "claude-acp"}
+	require.True(t, allocation.ValidAllocationFor(request))
+	activity := runsmodels.PoolExecutionActivity{TaskID: "task", AgentProfileID: "profile", SessionID: "session",
+		ExecutionID: "execution", TurnID: "turn", PromptGeneration: 1, AgentType: "claude-acp", StartedSource: runsmodels.PoolStartAssistant}
+	bound, ok := activity.ReceiptIdentity(allocation)
+	require.True(t, ok)
+	snapshot := &Snapshot{TaskID: "task", WorkspaceID: "workspace", LatestEntryID: 1, CurrentWorkflowID: "workflow", CurrentStepID: "step",
+		Entries: []Entry{{ID: 1, WorkflowID: "workflow", StepID: "step", ActorKind: "human", ActorID: "human",
+			ContractVersion: steptelemetry.ContractVersion, OccurredAt: at, PlannedProfile: "profile"}},
+		Runs: []*runsmodels.Run{run}, Selections: []Selection{{EntryID: 1, RunID: "run", ClaimID: "claim", WorkspaceID: "workspace", ClaimedAt: &claimedAt}},
+		ClaimCounts: []ClaimCount{{RunID: "run", Total: 1, CurrentMatches: 1}}}
+	appendReceiptFixture(t, snapshot, runsmodels.PoolLaunchAdmitted, request, at)
+	appendReceiptFixture(t, snapshot, runsmodels.PoolExecutionAllocated, allocation, at)
+	appendReceiptFixture(t, snapshot, runsmodels.PoolExecutionBound, bound, at)
+	appendReceiptFixture(t, snapshot, runsmodels.PoolWorkObserved, runsmodels.PoolWorkReceipt{PoolExecutionIdentity: bound, StartedSource: activity.StartedSource}, at)
+	if finished {
+		activity.StartedSource = ""
+		turn, ok := activity.TurnEndIdentity(allocation)
+		require.True(t, ok)
+		appendReceiptFixture(t, snapshot, runsmodels.PoolTurnEnded, runsmodels.PoolTurnEndReceipt{PoolExecutionIdentity: turn, Outcome: runsmodels.PoolTurnCompleted}, at)
+		stop, ok := activity.StoppedReceipt(allocation, runsmodels.PoolStopStandaloneControl, "fixture-control", true)
+		require.True(t, ok)
+		stopped := appendReceiptFixture(t, snapshot, runsmodels.PoolExecutionStopped, stop, at)
+		ended := appendReceiptFixture(t, snapshot, runsmodels.PoolExecutionFinished, runsmodels.PoolExecutionFinishReceipt{
+			PoolExecutionIdentity: allocation.PoolExecutionIdentity, StoppedSeq: stopped.Seq}, at)
+		run.Status, run.FinishedAt = runsmodels.RunStatusFinished, &ended.CreatedAt
+		outcome := runsmodels.PoolOutcomeExecutionStopped
+		run.Outcome = &outcome
+	}
+	return snapshot
+}
+
+func appendReceiptFixture(t *testing.T, snapshot *Snapshot, kind string, value any, at time.Time) *runsmodels.RunEvent {
+	t.Helper()
+	payload, err := json.Marshal(value)
+	require.NoError(t, err)
+	event := &runsmodels.RunEvent{RunID: "run", Seq: len(snapshot.Events), EventType: runsmodels.RunEventType(kind),
+		Payload: string(payload), CreatedAt: at.Add(time.Duration(len(snapshot.Events)+3) * time.Second)}
+	snapshot.Events = append(snapshot.Events, event)
+	return event
+}
+
+func mutateWorkReceipt(t *testing.T, snapshot *Snapshot, mutate func(*runsmodels.PoolWorkReceipt)) {
+	t.Helper()
+	for _, event := range snapshot.Events {
+		if event.EventType != runsmodels.PoolWorkObserved {
+			continue
+		}
+		var value runsmodels.PoolWorkReceipt
+		require.NoError(t, json.Unmarshal([]byte(event.Payload), &value))
+		mutate(&value)
+		payload, err := json.Marshal(value)
+		require.NoError(t, err)
+		event.Payload = string(payload)
+		return
+	}
+	t.Fatal("缺少实际形状的工作回执夹具")
+}
+
+// @covers AC-TASKS-AGENT-POOL-002.2 AC-TASKS-AGENT-POOL-002.3
+func TestPoolHistoryReceiptRejectsMismatchedOrUnsupportedWork(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		mutate func(*runsmodels.PoolWorkReceipt)
+	}{
+		{"其他任务", func(value *runsmodels.PoolWorkReceipt) { value.TaskID = "foreign" }},
+		{"其他会话", func(value *runsmodels.PoolWorkReceipt) { value.SessionID = "old-session" }},
+		{"其他执行", func(value *runsmodels.PoolWorkReceipt) { value.ExecutionID = "old-execution" }},
+		{"旧回合", func(value *runsmodels.PoolWorkReceipt) { value.TurnID = "old-turn" }},
+		{"后继 generation", func(value *runsmodels.PoolWorkReceipt) { value.PromptGeneration = 2 }},
+		{"欢迎消息不是工作", func(value *runsmodels.PoolWorkReceipt) { value.StartedSource = "welcome" }},
+		{"错误 operation", func(value *runsmodels.PoolWorkReceipt) { value.OperationID = "other-operation" }},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			snapshot := receiptSnapshot(t, false)
+			mutateWorkReceipt(t, snapshot, test.mutate)
+			page, err := Project(snapshot)
+			require.NoError(t, err)
+			require.Len(t, page.Items, 1)
+			require.Equal(t, "unknown", page.Items[0].State)
+			require.Nil(t, page.Items[0].StartedAt)
+		})
+	}
+}
+
+func TestPoolHistoryReceiptPreservesOldWorkButDoesNotCallItCurrent(t *testing.T) {
+	snapshot := receiptSnapshot(t, false)
+	snapshot.LatestEntryID = 2
+	page, err := Project(snapshot)
+	require.NoError(t, err)
+	require.NotNil(t, page.Items[0].StartedAt)
+	require.False(t, page.Items[0].Current)
+	require.Equal(t, "unknown", page.Items[0].State)
+}
+
+func TestPoolHistoryReceiptFinishedRequiresBothNativeStopAndFinishedFact(t *testing.T) {
+	for _, mode := range []string{"正常终结", "缺少终结", "资源释放未确认", "native 行不是终结"} {
+		t.Run(mode, func(t *testing.T) {
+			snapshot := receiptSnapshot(t, true)
+			switch mode {
+			case "缺少终结":
+				snapshot.Events = snapshot.Events[:len(snapshot.Events)-1]
+			case "资源释放未确认":
+				for _, event := range snapshot.Events {
+					if event.EventType != runsmodels.PoolExecutionStopped {
+						continue
+					}
+					var stopped runsmodels.PoolExecutionStopReceipt
+					require.NoError(t, json.Unmarshal([]byte(event.Payload), &stopped))
+					stopped.ExecutionActivityReleased = false
+					encoded, err := json.Marshal(stopped)
+					require.NoError(t, err)
+					event.Payload = string(encoded)
+				}
+			case "native 行不是终结":
+				snapshot.Runs[0].Status = runsmodels.RunStatusClaimed
+			}
+			page, err := Project(snapshot)
+			require.NoError(t, err)
+			if mode == "正常终结" {
+				require.Equal(t, "ended", page.Items[0].State)
+				require.NotNil(t, page.Items[0].EndedAt)
+			} else {
+				require.Equal(t, "unknown", page.Items[0].State)
+				if mode == "资源释放未确认" {
+					require.NotNil(t, page.Items[0].StartedAt, "后续终结证据不完整不能抹掉已确认的开工事实")
+				}
+			}
+		})
+	}
+}
diff --git b/apps/backend/internal/task/poolhistory/execution_evidence.go b/apps/backend/internal/task/poolhistory/execution_evidence.go
new file mode 100644
index 0000000..2820cd0
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/execution_evidence.go
@@ -0,0 +1,77 @@
+package poolhistory
+
+import runsmodels "github.com/kandev/kandev/internal/runs/models"
+
+type executionEvidence struct {
+	Allocation  *runsmodels.PoolExecutionAllocation
+	Bound       *runsmodels.PoolExecutionIdentity
+	Work        *runsmodels.PoolWorkReceipt
+	WorkEvent   *runsmodels.RunEvent
+	Turn        *runsmodels.PoolTurnEndReceipt
+	TurnEvent   *runsmodels.RunEvent
+	Stop        *runsmodels.PoolExecutionStopReceipt
+	StopEvent   *runsmodels.RunEvent
+	Finish      *runsmodels.PoolExecutionFinishReceipt
+	FinishEvent *runsmodels.RunEvent
+}
+
+func readExecutionEvidence(snapshot *Snapshot, entry Entry, selection Selection, run *runsmodels.Run) (*executionEvidence, error) {
+	group, err := claimReceipts(snapshot, selection)
+	if err != nil {
+		return nil, err
+	}
+	evidence := &executionEvidence{}
+	if len(group) == 0 {
+		return evidence, nil
+	}
+	request, intentEvent, err := uniqueReceipt(group[runsmodels.PoolLaunchAdmitted], func(request runsmodels.PoolClaimStart) bool {
+		return intentMatches(request, snapshot, entry, selection, run)
+	})
+	if err != nil || request == nil {
+		return evidence, errReceiptUnverified
+	}
+	allocation, allocatedEvent, err := uniqueReceipt(group[runsmodels.PoolExecutionAllocated], func(allocation runsmodels.PoolExecutionAllocation) bool {
+		return allocation.ValidAllocationFor(*request) && allocation.AgentType != "" && len(allocation.AgentType) <= 256
+	})
+	if err != nil {
+		return evidence, err
+	}
+	if allocation == nil {
+		if len(group) != 1 {
+			return evidence, errReceiptUnverified
+		}
+		return evidence, nil
+	}
+	if allocatedEvent.Seq <= intentEvent.Seq {
+		return evidence, errReceiptUnverified
+	}
+	evidence.Allocation = allocation
+	if err := readWorkEvidence(group, evidence); err != nil {
+		return evidence, err
+	}
+	if err := readTurnEvidence(group, evidence); err != nil {
+		return evidence, err
+	}
+	if err := readStopEvidence(group, evidence); err != nil {
+		return evidence, err
+	}
+	if err := checkRecoveryControlEvidence(group, *request, *allocation, allocatedEvent, evidence); err != nil {
+		return evidence, err
+	}
+	return evidence, nil
+}
+
+func intentMatches(request runsmodels.PoolClaimStart, snapshot *Snapshot, entry Entry, selection Selection, run *runsmodels.Run) bool {
+	return request.Valid() && request.RunID == selection.RunID && request.ClaimID == selection.ClaimID &&
+		releaseMatchesEntry(request.Release, snapshot.TaskID, entry) && request.Release.MatchesRun(run)
+}
+
+func receiptActivity(identity runsmodels.PoolExecutionIdentity, agentType string, source runsmodels.PoolStartSource) runsmodels.PoolExecutionActivity {
+	activity := runsmodels.PoolExecutionActivity{TaskID: identity.TaskID, AgentProfileID: identity.AgentProfileID,
+		SessionID: identity.SessionID, ExecutionID: identity.ExecutionID, TurnID: identity.TurnID,
+		PromptGeneration: identity.PromptGeneration, AgentType: agentType, StartedSource: source}
+	if agentType == "codex-app-server" {
+		activity.OperationID = identity.OperationID
+	}
+	return activity
+}
diff --git b/apps/backend/internal/task/poolhistory/model.go b/apps/backend/internal/task/poolhistory/model.go
new file mode 100644
index 0000000..55239fc
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/model.go
@@ -0,0 +1,115 @@
+// Package poolhistory 只投影原生池事实，不拥有派发、领取或恢复状态。
+package poolhistory
+
+import (
+	"errors"
+	"time"
+
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+)
+
+const (
+	MaxItems     = 50
+	stateUnknown = "unknown"
+)
+
+var (
+	ErrInvalidQuery = errors.New("pool_history_invalid_query")
+	ErrUnavailable  = errors.New("pool_history_unavailable")
+)
+
+type Cursor struct {
+	Version   int        `json:"version"`
+	TaskID    string     `json:"task_id"`
+	EntryID   int64      `json:"entry_id"`
+	RunID     string     `json:"run_id,omitempty"`
+	ClaimID   string     `json:"claim_id,omitempty"`
+	ClaimedAt *time.Time `json:"claimed_at,omitempty"`
+}
+
+type Query struct {
+	Limit    int
+	Before   int64
+	Position *Cursor
+}
+
+type Page struct {
+	TaskID          string `json:"task_id"`
+	SnapshotVersion string `json:"snapshot_version"`
+	Items           []Item `json:"items"`
+	NextCursor      string `json:"next_cursor"`
+}
+
+type Item struct {
+	EntryID               int64      `json:"entry_id"`
+	RunID                 string     `json:"run_id"`
+	ClaimID               string     `json:"claim_id"`
+	State                 string     `json:"state"`
+	Reason                string     `json:"reason,omitempty"`
+	PlannedAgentProfileID string     `json:"planned_agent_profile_id"`
+	ClaimedAgentProfileID string     `json:"claimed_agent_profile_id"`
+	Current               bool       `json:"current"`
+	ReleasedAt            *time.Time `json:"released_at"`
+	QueuedAt              *time.Time `json:"queued_at"`
+	ClaimedAt             *time.Time `json:"claimed_at"`
+	StartedAt             *time.Time `json:"started_at"`
+	SessionID             string     `json:"session_id"`
+	ExecutionID           string     `json:"execution_id"`
+	ExecutionProfileID    string     `json:"execution_profile_id"`
+	TurnID                string     `json:"turn_id"`
+	OperationID           string     `json:"operation_id"`
+	OperationSource       string     `json:"operation_source"`
+	TurnEndedAt           *time.Time `json:"turn_ended_at"`
+	StoppedAt             *time.Time `json:"stopped_at"`
+	EndedAt               *time.Time `json:"ended_at"`
+	TurnOutcome           string     `json:"turn_outcome,omitempty"`
+}
+
+type Entry struct {
+	ID              int64     `db:"id"`
+	WorkflowID      string    `db:"workflow_id"`
+	StepID          string    `db:"step_id"`
+	ActorKind       string    `db:"actor_kind"`
+	ActorID         string    `db:"actor_id"`
+	ContractVersion int       `db:"contract_version"`
+	OccurredAt      time.Time `db:"occurred_at"`
+	PlannedProfile  string    `db:"planned_profile"`
+}
+
+// Snapshot 只含有界原生资料；Run 的提示和其他非身份字段不会被加载或返回。
+type Snapshot struct {
+	TaskID             string
+	WorkspaceID        string
+	Entries            []Entry
+	Runs               []*runsmodels.Run
+	Clearances         []runsmodels.PoolHistoryClearance
+	Selections         []Selection
+	ClaimCounts        []ClaimCount
+	LatestEntryID      int64
+	PolicyActivatedAt  time.Time
+	CurrentWorkflowID  string
+	CurrentStepID      string
+	Events             []*runsmodels.RunEvent
+	EvidenceIncomplete bool
+	HasMore            bool
+	Incomplete         bool
+}
+
+type Seed struct {
+	EntryID int64  `json:"entry_id"`
+	RunID   string `json:"run_id"`
+}
+
+type Selection struct {
+	EntryID     int64      `db:"entry_id"`
+	RunID       string     `db:"run_id"`
+	ClaimID     string     `db:"claim_id"`
+	WorkspaceID string     `db:"workspace_id"`
+	ClaimedAt   *time.Time `db:"claimed_at"`
+}
+
+type ClaimCount struct {
+	RunID          string `db:"run_id"`
+	Total          int    `db:"total"`
+	CurrentMatches int    `db:"current_matches"`
+}
diff --git b/apps/backend/internal/task/poolhistory/project.go b/apps/backend/internal/task/poolhistory/project.go
new file mode 100644
index 0000000..ffe5238
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/project.go
@@ -0,0 +1,113 @@
+package poolhistory
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+	"github.com/kandev/kandev/internal/steptelemetry"
+)
+
+func Project(snapshot *Snapshot) (*Page, error) {
+	if snapshot == nil {
+		return nil, ErrUnavailable
+	}
+	page := &Page{TaskID: snapshot.TaskID, Items: make([]Item, 0, len(snapshot.Entries))}
+	for _, selection := range snapshot.Selections {
+		page.Items = append(page.Items, projectSelection(snapshot, selection))
+	}
+	if snapshot.HasMore && len(snapshot.Selections) != 0 {
+		cursor, err := encodeCursor(snapshot.TaskID, snapshot.Selections[len(snapshot.Selections)-1])
+		if err != nil {
+			return nil, err
+		}
+		page.NextCursor = cursor
+	}
+	encoded, err := json.Marshal(page)
+	if err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256(encoded)
+	page.SnapshotVersion = hex.EncodeToString(digest[:])
+	return page, nil
+}
+
+func projectEntry(snapshot *Snapshot, entry Entry) Item {
+	item := Item{EntryID: entry.ID, State: stateUnknown, Reason: "binding_unverified"}
+	if !validEntry(entry) {
+		return item
+	}
+	item.ReleasedAt = &entry.OccurredAt
+	item.PlannedAgentProfileID = entry.PlannedProfile
+	if snapshot.Incomplete {
+		item.Reason = "history_evidence_limit"
+		return item
+	}
+	valid, invalid := runsForEntry(snapshot, entry)
+	if clearance, present := clearanceForEntry(snapshot, entry); present {
+		if clearance != nil && len(valid) == 0 && !invalid {
+			return projectClearance(item, clearance)
+		}
+		return item
+	}
+	if len(valid) == 0 && !invalid {
+		if !snapshot.PolicyActivatedAt.IsZero() && !entry.OccurredAt.After(snapshot.PolicyActivatedAt) {
+			item.Reason = "legacy_dispatch_unverified"
+			return item
+		}
+		item.State, item.Reason = "released", ""
+		return item
+	}
+	if len(valid) != 1 {
+		return item
+	}
+	run := valid[0]
+	item.RunID, item.PlannedAgentProfileID = run.ID, run.AgentProfileID
+	item.QueuedAt = &run.RequestedAt
+	if run.Status == "cancelled" {
+		return projectWithdrawal(snapshot, entry, run, item)
+	}
+	if run.Status == runsmodels.RunStatusQueued {
+		item.State, item.Reason = "queued", ""
+		for _, count := range snapshot.ClaimCounts {
+			if count.RunID == run.ID && count.Total != 0 {
+				return projectRequeuedPending(snapshot, entry, run, item)
+			}
+		}
+	} else {
+		item.Reason = "execution_evidence_not_loaded"
+	}
+	return item
+}
+
+func validEntry(entry Entry) bool {
+	return entry.ContractVersion == steptelemetry.ContractVersion && entry.ActorKind == "human" &&
+		entry.ActorID != "" && len(entry.ActorID) <= 256 && !entry.OccurredAt.IsZero()
+}
+
+func runsForEntry(snapshot *Snapshot, entry Entry) ([]*runsmodels.Run, bool) {
+	valid, invalid := make([]*runsmodels.Run, 0, 2), false
+	key, _ := (runsmodels.PoolReleaseSnapshot{WorkspaceID: snapshot.WorkspaceID, TaskID: snapshot.TaskID, EntryID: entry.ID}).DispatchKey()
+	for _, run := range snapshot.Runs {
+		if run == nil || run.IdempotencyKey == nil || *run.IdempotencyKey != key {
+			continue
+		}
+		var payload struct {
+			Release runsmodels.PoolReleaseSnapshot `json:"pool_release"`
+		}
+		if json.Unmarshal([]byte(run.Payload), &payload) != nil || !releaseMatchesEntry(payload.Release, snapshot.TaskID, entry) ||
+			!payload.Release.MatchesRun(run) || run.RequestedAt.IsZero() || len(run.ID) > 256 || len(run.AgentProfileID) > 256 {
+			invalid = true
+			continue
+		}
+		valid = append(valid, run)
+	}
+	return valid, invalid
+}
+
+func releaseMatchesEntry(release runsmodels.PoolReleaseSnapshot, taskID string, entry Entry) bool {
+	return release.TaskID == taskID && release.EntryID == entry.ID && release.WorkflowID == entry.WorkflowID &&
+		release.WorkflowStepID == entry.StepID && release.ActorID == entry.ActorID && release.ReleasedAt.Equal(entry.OccurredAt) &&
+		release.AgentProfileID != "" && len(release.AgentProfileID) <= 256
+}
diff --git b/apps/backend/internal/task/poolhistory/query.go b/apps/backend/internal/task/poolhistory/query.go
new file mode 100644
index 0000000..2113713
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/query.go
@@ -0,0 +1,52 @@
+package poolhistory
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+)
+
+func ParseQuery(taskID string, limit int, cursor string) (Query, error) {
+	query := Query{Limit: limit}
+	if taskID == "" || len(taskID) > 256 || limit < 0 || limit > MaxItems || len(cursor) > 1024 {
+		return Query{}, ErrInvalidQuery
+	}
+	if query.Limit == 0 {
+		query.Limit = MaxItems
+	}
+	if cursor == "" {
+		return query, nil
+	}
+	encoded, err := base64.RawURLEncoding.DecodeString(cursor)
+	if err != nil {
+		return Query{}, ErrInvalidQuery
+	}
+	var position Cursor
+	if json.Unmarshal(encoded, &position) != nil || !position.validFor(taskID) {
+		return Query{}, ErrInvalidQuery
+	}
+	canonical, err := json.Marshal(position)
+	if err != nil || !bytes.Equal(encoded, canonical) {
+		return Query{}, ErrInvalidQuery
+	}
+	query.Before = position.EntryID
+	query.Position = &position
+	return query, nil
+}
+
+func (position Cursor) validFor(taskID string) bool {
+	return position.Version == 1 && position.TaskID == taskID && position.EntryID > 0 &&
+		len(position.RunID) <= 256 && len(position.ClaimID) <= 256 &&
+		(position.ClaimID != "") == (position.ClaimedAt != nil) &&
+		(position.ClaimID == "" || position.RunID != "") &&
+		(position.ClaimedAt == nil || !position.ClaimedAt.IsZero())
+}
+
+func encodeCursor(taskID string, selection Selection) (string, error) {
+	encoded, err := json.Marshal(Cursor{Version: 1, TaskID: taskID, EntryID: selection.EntryID,
+		RunID: selection.RunID, ClaimID: selection.ClaimID, ClaimedAt: selection.ClaimedAt})
+	if err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(encoded), nil
+}
diff --git b/apps/backend/internal/task/poolhistory/receipts.go b/apps/backend/internal/task/poolhistory/receipts.go
new file mode 100644
index 0000000..deaf320
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/receipts.go
@@ -0,0 +1,79 @@
+package poolhistory
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"strings"
+
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+)
+
+var errReceiptUnverified = errors.New("pool_history_receipt_unverified")
+
+type receiptGroup map[string][]*runsmodels.RunEvent
+
+func claimReceipts(snapshot *Snapshot, selection Selection) (receiptGroup, error) {
+	if snapshot.EvidenceIncomplete {
+		return nil, errReceiptUnverified
+	}
+	group := make(receiptGroup)
+	for _, event := range snapshot.Events {
+		if event == nil || event.RunID != selection.RunID {
+			continue
+		}
+		var scope struct {
+			ClaimID string `json:"claim_id"`
+		}
+		if json.Unmarshal([]byte(event.Payload), &scope) != nil || scope.ClaimID == "" {
+			return nil, errReceiptUnverified
+		}
+		if scope.ClaimID != selection.ClaimID {
+			continue
+		}
+		if event.Seq < 0 || event.CreatedAt.IsZero() || !knownReceiptKind(string(event.EventType)) {
+			return nil, errReceiptUnverified
+		}
+		group[string(event.EventType)] = append(group[string(event.EventType)], event)
+	}
+	return group, nil
+}
+
+func knownReceiptKind(kind string) bool {
+	switch kind {
+	case runsmodels.PoolLaunchAdmitted, runsmodels.PoolExecutionAllocated, runsmodels.PoolExecutionBound,
+		runsmodels.PoolWorkObserved, runsmodels.PoolTurnEnded, runsmodels.PoolExecutionStopped, runsmodels.PoolExecutionFinished,
+		runsmodels.PoolRecoveryStopRequested, runsmodels.PoolRecoveryRequeued:
+		return true
+	default:
+		return false
+	}
+}
+
+func uniqueReceipt[T any](rows []*runsmodels.RunEvent, accept func(T) bool) (*T, *runsmodels.RunEvent, error) {
+	var chosen *T
+	var recorded *runsmodels.RunEvent
+	for _, row := range rows {
+		var value T
+		if !decodeReceipt(row.Payload, &value) || !accept(value) {
+			continue
+		}
+		if chosen != nil {
+			return nil, nil, errReceiptUnverified
+		}
+		chosen, recorded = &value, row
+	}
+	if len(rows) != 0 && chosen == nil {
+		return nil, nil, errReceiptUnverified
+	}
+	return chosen, recorded, nil
+}
+
+func decodeReceipt(payload string, target any) bool {
+	decoder := json.NewDecoder(strings.NewReader(payload))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(target) != nil {
+		return false
+	}
+	return decoder.Decode(new(any)) == io.EOF
+}
diff --git b/apps/backend/internal/task/poolhistory/recovery_control.go b/apps/backend/internal/task/poolhistory/recovery_control.go
new file mode 100644
index 0000000..c9c752d
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/recovery_control.go
@@ -0,0 +1,27 @@
+package poolhistory
+
+import runsmodels "github.com/kandev/kandev/internal/runs/models"
+
+// 恢复控制回执必须绑定原生分配，但绝不作为物理停止或开工的证据。
+
+func checkRecoveryControlEvidence(group receiptGroup, request runsmodels.PoolClaimStart, allocation runsmodels.PoolExecutionAllocation, allocated *runsmodels.RunEvent, evidence *executionEvidence) error {
+	for _, kind := range []string{runsmodels.PoolRecoveryStopRequested, runsmodels.PoolRecoveryRequeued} {
+		for _, event := range group[kind] {
+			var operation runsmodels.PoolRecoveryOperation
+			if !decodeReceipt(event.Payload, &operation) || !operation.ValidExecutionFor(request) ||
+				operation.Execution != allocation.PoolExecutionIdentity || event.Seq <= allocated.Seq ||
+				!controlKindMatches(kind, operation, event, evidence) {
+				return errReceiptUnverified
+			}
+		}
+	}
+	return nil
+}
+
+func controlKindMatches(kind string, operation runsmodels.PoolRecoveryOperation, event *runsmodels.RunEvent, evidence *executionEvidence) bool {
+	if kind == runsmodels.PoolRecoveryStopRequested {
+		return operation.Command.Action == "stop"
+	}
+	return operation.Command.Action == "retry" && evidence.FinishEvent != nil &&
+		operation.FinishedSeq == evidence.FinishEvent.Seq && operation.FinishedSeq < event.Seq
+}
diff --git b/apps/backend/internal/task/poolhistory/recovery_evidence.go b/apps/backend/internal/task/poolhistory/recovery_evidence.go
new file mode 100644
index 0000000..dafcb07
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/recovery_evidence.go
@@ -0,0 +1,51 @@
+package poolhistory
+
+import (
+	"encoding/json"
+	"strings"
+
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+)
+
+// projectWithdrawal 只呈现同一原生取消提交的回执，不把 cancelled 行推断为停止。
+func projectWithdrawal(snapshot *Snapshot, entry Entry, run *runsmodels.Run, item Item) Item {
+	item.Reason = "withdrawal_unverified"
+	if snapshot.EvidenceIncomplete || run.ClaimedAt != nil || run.SessionID != "" || run.Outcome != nil ||
+		run.FinishedAt == nil || run.CancelReason == nil || *run.CancelReason != "pool_withdrawn" {
+		return item
+	}
+	for _, count := range snapshot.ClaimCounts {
+		if count.RunID == run.ID && count.Total != 0 {
+			return item
+		}
+	}
+	var receipt *runsmodels.RunEvent
+	for _, event := range snapshot.Events {
+		if event == nil || event.RunID != run.ID {
+			continue
+		}
+		if receipt != nil || event.EventType != runsmodels.PoolRecoveryWithdrawn {
+			return item
+		}
+		receipt = event
+	}
+	if !validWithdrawalReceipt(receipt, snapshot, entry, run) {
+		return item
+	}
+	item.State, item.Reason, item.EndedAt = "withdrawn", "", &receipt.CreatedAt
+	item.Current = entry.ID == snapshot.LatestEntryID && entry.WorkflowID == snapshot.CurrentWorkflowID && entry.StepID == snapshot.CurrentStepID
+	return item
+}
+
+func validWithdrawalReceipt(event *runsmodels.RunEvent, snapshot *Snapshot, entry Entry, run *runsmodels.Run) bool {
+	if event == nil || event.Seq < 0 || event.CreatedAt.IsZero() || !event.CreatedAt.Equal(*run.FinishedAt) || event.CreatedAt.Before(run.RequestedAt) {
+		return false
+	}
+	var operation runsmodels.PoolRecoveryOperation
+	if json.Unmarshal([]byte(event.Payload), &operation) != nil {
+		return false
+	}
+	return operation.Command.Valid() && operation.Command.Action == "withdraw" && operation.Command.RunID == run.ID &&
+		operation.TaskID == snapshot.TaskID && operation.WorkspaceID == snapshot.WorkspaceID && operation.EntryID == entry.ID &&
+		operation.Result == "withdrawn" && operation.ActorID != "" && len(operation.ActorID) <= 256 && strings.TrimSpace(operation.ActorID) == operation.ActorID
+}
diff --git b/apps/backend/internal/task/poolhistory/render_evidence.go b/apps/backend/internal/task/poolhistory/render_evidence.go
new file mode 100644
index 0000000..74744c5
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/render_evidence.go
@@ -0,0 +1,78 @@
+package poolhistory
+
+import runsmodels "github.com/kandev/kandev/internal/runs/models"
+
+func projectExecutionEvidence(snapshot *Snapshot, entry Entry, selection Selection, run *runsmodels.Run, item Item) Item {
+	evidence, err := readExecutionEvidence(snapshot, entry, selection, run)
+	if evidence != nil && evidence.Allocation != nil {
+		identity := evidence.Allocation.PoolExecutionIdentity
+		item.SessionID, item.ExecutionID, item.ExecutionProfileID, item.TurnID = identity.SessionID, identity.ExecutionID, identity.ExecutionProfileID, identity.TurnID
+	}
+	if err != nil {
+		if evidence != nil {
+			item = projectWorkAndTurn(evidence, item)
+			if evidence.StopEvent != nil {
+				item.StoppedAt = &evidence.StopEvent.CreatedAt
+			}
+		}
+		item.State, item.Reason = stateUnknown, "receipt_unverified"
+		return item
+	}
+	if evidence.Allocation == nil {
+		if selectionIsRunCurrent(snapshot, selection, run) && run.SessionID != "" {
+			item.State, item.Reason = stateUnknown, "execution_binding_missing"
+		}
+		return item
+	}
+	if selectionIsRunCurrent(snapshot, selection, run) && run.SessionID != item.SessionID {
+		item.State, item.Reason = stateUnknown, "execution_binding_conflict"
+		return item
+	}
+	item = projectWorkAndTurn(evidence, item)
+	item = projectStopAndFinish(evidence, snapshot, selection, run, item)
+	return item
+}
+
+func projectWorkAndTurn(evidence *executionEvidence, item Item) Item {
+	if evidence.Bound != nil {
+		item.OperationID, item.OperationSource = evidence.Bound.OperationID, string(evidence.Bound.OperationSource)
+	}
+	if evidence.Work != nil {
+		item.StartedAt = &evidence.WorkEvent.CreatedAt
+		if item.Current {
+			item.State, item.Reason = "started", ""
+		}
+	}
+	if evidence.Turn != nil {
+		item.TurnEndedAt = &evidence.TurnEvent.CreatedAt
+		item.TurnOutcome = string(evidence.Turn.Outcome)
+		if item.Current {
+			item.State, item.Reason = "turn_ended", ""
+			if evidence.Turn.Outcome == runsmodels.PoolTurnFailed {
+				item.State = "turn_failed"
+			}
+		}
+	}
+	return item
+}
+
+func projectStopAndFinish(evidence *executionEvidence, snapshot *Snapshot, selection Selection, run *runsmodels.Run, item Item) Item {
+	if evidence.Stop != nil {
+		item.StoppedAt = &evidence.StopEvent.CreatedAt
+		item.State, item.Reason = "stopped", ""
+		if !evidence.Stop.ExecutionActivityReleased {
+			item.State, item.Reason = stateUnknown, "execution_release_unconfirmed"
+		}
+	}
+	if evidence.Finish != nil {
+		item.EndedAt = &evidence.FinishEvent.CreatedAt
+		item.State, item.Reason = "ended", ""
+		if selectionIsRunCurrent(snapshot, selection, run) && (run.Status != runsmodels.RunStatusFinished || run.FinishedAt == nil ||
+			!run.FinishedAt.Equal(evidence.FinishEvent.CreatedAt) || run.Outcome == nil || *run.Outcome != runsmodels.PoolOutcomeExecutionStopped) {
+			item.State, item.Reason = stateUnknown, "finish_state_conflict"
+		}
+	} else if selectionIsRunCurrent(snapshot, selection, run) && run.Status == runsmodels.RunStatusFinished {
+		item.State, item.Reason = stateUnknown, "finish_unverified"
+	}
+	return item
+}
diff --git b/apps/backend/internal/task/poolhistory/requeue_evidence.go b/apps/backend/internal/task/poolhistory/requeue_evidence.go
new file mode 100644
index 0000000..8b8f686
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/requeue_evidence.go
@@ -0,0 +1,78 @@
+package poolhistory
+
+import (
+	"encoding/json"
+
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+)
+
+func requeueCause(snapshot *Snapshot, entry Entry, run *runsmodels.Run, event *runsmodels.RunEvent) bool {
+	if event == nil || event.EventType != runsmodels.PoolRecoveryRequeued || event.Seq < 0 || event.CreatedAt.IsZero() {
+		return false
+	}
+	var operation runsmodels.PoolRecoveryOperation
+	if !decodeReceipt(event.Payload, &operation) {
+		return false
+	}
+	var release struct {
+		Release runsmodels.PoolReleaseSnapshot `json:"pool_release"`
+	}
+	// 原生运行载荷还含任务和代理信封，不使用严格控制回执解码器。
+	if json.Unmarshal([]byte(run.Payload), &release) != nil {
+		return false
+	}
+	request := runsmodels.PoolClaimStart{RunID: run.ID, ClaimID: operation.ClaimID, Release: release.Release}
+	return operation.ValidExecutionFor(request) && operation.Command.Action == "retry" && operation.FinishedSeq < event.Seq &&
+		releaseMatchesEntry(request.Release, snapshot.TaskID, entry) && request.Release.MatchesRun(run)
+}
+
+// queueCauseForClaim 以事件先后关系核对本轮排队，不使用领取时间或 UUID 猜测重试。
+func queueCauseForClaim(snapshot *Snapshot, entry Entry, run *runsmodels.Run, selection Selection, item Item) Item {
+	first, intent, previous := -1, -1, (*runsmodels.RunEvent)(nil)
+	for _, event := range snapshot.Events {
+		if event == nil || event.RunID != run.ID || event.EventType != runsmodels.PoolLaunchAdmitted {
+			continue
+		}
+		if first < 0 || event.Seq < first {
+			first = event.Seq
+		}
+		var request runsmodels.PoolClaimStart
+		if decodeReceipt(event.Payload, &request) && request.ClaimID == selection.ClaimID {
+			intent = event.Seq
+		}
+	}
+	if intent < 0 {
+		return item
+	}
+	if intent == first {
+		item.QueuedAt = &run.RequestedAt
+		return item
+	}
+	for _, event := range snapshot.Events {
+		if event != nil && event.RunID == run.ID && event.Seq < intent && (previous == nil || event.Seq > previous.Seq) {
+			previous = event
+		}
+	}
+	if !requeueCause(snapshot, entry, run, previous) {
+		item.State, item.Reason, item.QueuedAt = stateUnknown, "queue_cause_unverified", nil
+		return item
+	}
+	item.QueuedAt = &previous.CreatedAt
+	return item
+}
+
+func projectRequeuedPending(snapshot *Snapshot, entry Entry, run *runsmodels.Run, item Item) Item {
+	var last *runsmodels.RunEvent
+	for _, event := range snapshot.Events {
+		if event != nil && event.RunID == run.ID && (last == nil || event.Seq > last.Seq) {
+			last = event
+		}
+	}
+	if snapshot.EvidenceIncomplete || !requeueCause(snapshot, entry, run, last) {
+		item.State, item.Reason = stateUnknown, "queue_cause_unverified"
+		return item
+	}
+	item.QueuedAt, item.State, item.Reason = &last.CreatedAt, "queued", ""
+	item.Current = entry.ID == snapshot.LatestEntryID && entry.WorkflowID == snapshot.CurrentWorkflowID && entry.StepID == snapshot.CurrentStepID
+	return item
+}
diff --git b/apps/backend/internal/task/poolhistory/selection.go b/apps/backend/internal/task/poolhistory/selection.go
new file mode 100644
index 0000000..d2376c4
--- /dev/null
+++ b/apps/backend/internal/task/poolhistory/selection.go
@@ -0,0 +1,83 @@
+package poolhistory
+
+import runsmodels "github.com/kandev/kandev/internal/runs/models"
+
+// SelectionSeeds 仅让已核对的唯一运行进入领取查询，不透传冲突行的标识。
+func SelectionSeeds(snapshot *Snapshot) []Seed {
+	seeds := make([]Seed, 0, len(snapshot.Entries))
+	for _, entry := range snapshot.Entries {
+		seed := Seed{EntryID: entry.ID}
+		if validEntry(entry) && !snapshot.Incomplete {
+			valid, _ := runsForEntry(snapshot, entry)
+			if len(valid) == 1 {
+				seed.RunID = valid[0].ID
+			}
+			if clearance, present := clearanceForEntry(snapshot, entry); present {
+				seed.RunID = ""
+				if clearance != nil && len(valid) == 0 {
+					seed.RunID = clearance.RunID
+				}
+			}
+		}
+		seeds = append(seeds, seed)
+	}
+	return seeds
+}
+
+func projectSelection(snapshot *Snapshot, selection Selection) Item {
+	var entry Entry
+	for _, candidate := range snapshot.Entries {
+		if candidate.ID == selection.EntryID {
+			entry = candidate
+			break
+		}
+	}
+	item := projectEntry(snapshot, entry)
+	if item.RunID == "" || item.RunID != selection.RunID || selection.ClaimID == "" ||
+		selection.ClaimedAt == nil || selection.ClaimedAt.IsZero() || len(selection.ClaimID) > 256 {
+		return item
+	}
+	if clearance, present := clearanceForEntry(snapshot, entry); present {
+		if clearance != nil && item.Reason == "history_cleaned" && selection.WorkspaceID == clearance.WorkspaceID {
+			release, _ := clearance.Release()
+			item.ClaimID, item.ClaimedAt = selection.ClaimID, selection.ClaimedAt
+			item.ClaimedAgentProfileID = release.AgentProfileID
+		}
+		return item
+	}
+	valid, _ := runsForEntry(snapshot, entry)
+	if len(valid) != 1 || selection.WorkspaceID != valid[0].WorkspaceID {
+		item.State, item.Reason = stateUnknown, "claim_unverified"
+		return item
+	}
+	run := valid[0]
+	item.ClaimID, item.ClaimedAt = selection.ClaimID, selection.ClaimedAt
+	item.ClaimedAgentProfileID = run.AgentProfileID
+	item.State, item.Reason = stateUnknown, "historical_outcome_unverified"
+	item.Current = selectionIsCurrent(snapshot, entry, selection, run)
+	if item.Current && run.Status == runsmodels.RunStatusClaimed {
+		item.State, item.Reason = "claimed", ""
+	}
+	item = projectExecutionEvidence(snapshot, entry, selection, run, item)
+	return queueCauseForClaim(snapshot, entry, run, selection, item)
+}
+
+func selectionIsCurrent(snapshot *Snapshot, entry Entry, selection Selection, run *runsmodels.Run) bool {
+	if entry.ID != snapshot.LatestEntryID || entry.WorkflowID != snapshot.CurrentWorkflowID ||
+		entry.StepID != snapshot.CurrentStepID {
+		return false
+	}
+	return selectionIsRunCurrent(snapshot, selection, run)
+}
+
+func selectionIsRunCurrent(snapshot *Snapshot, selection Selection, run *runsmodels.Run) bool {
+	if run.ClaimedAt == nil || selection.ClaimedAt == nil || !run.ClaimedAt.Equal(*selection.ClaimedAt) {
+		return false
+	}
+	for _, count := range snapshot.ClaimCounts {
+		if count.RunID == run.ID {
+			return count.CurrentMatches == 1
+		}
+	}
+	return false
+}
