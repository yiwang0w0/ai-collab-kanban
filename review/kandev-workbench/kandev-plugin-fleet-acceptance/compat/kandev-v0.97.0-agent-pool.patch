+}
+
+// @covers AC-TASKS-AGENT-POOL-005.4
+func TestPoolRecoveryWithdrawalManagementOwnerAndVersion(t *testing.T) {
+	for _, mode := range []string{"plugin", "other-human", "released-after-confirmation"} {
