+import { describe, expect, it } from "vitest";
+import { poolRecoveryCommand, matchesPoolRecoveryResult } from "./task-pool-recovery";
+import type { PoolRecoveryContext, PoolRecoveryResult } from "./types/task-pool-recovery";
+
+export const recoveryContext: PoolRecoveryContext = {
+  task_id: "task",
+  run_id: "run",
+  entry_id: 1,
+  claim_id: "",
+  task_version: "2026-10-20T01:02:03.123456789Z",
+  run_version: "a".repeat(64),
+  management_version: "native-version",
+  actions: { withdraw: true, stop: false, retry: false },
+};
+const operationId = "bfa6649f-bbd2-4f84-924b-b0790dfe0afd";
+
+describe("恢复确认凭据", () => {
+  it("保留全部原生比较版本，不舍入纳秒或构造停止事实", () => {
+    expect(poolRecoveryCommand(recoveryContext, "withdraw", operationId)).toEqual({
+      action: "withdraw",
+      operation_id: operationId,
+      run_id: "run",
+      expected_claim_id: "",
+      expected_task_version: recoveryContext.task_version,
+      expected_run_version: recoveryContext.run_version,
+      expected_management_version: "native-version",
+      confirm: true,
+      confirm_cli_quota: false,
+    });
+  });
+  it.each([
+    { ...recoveryContext, task_version: "0" },
+    { ...recoveryContext, task_version: "2026-02-30T00:00:00Z" },
+    { ...recoveryContext, run_version: "unknown" },
+    { ...recoveryContext, claim_id: "already-claimed" },
+    { ...recoveryContext, actions: { withdraw: false, stop: false, retry: false } },
+  ])("不确定或不适用的上下文不能生成动作", (state) => {
+    expect(poolRecoveryCommand(state, "withdraw", operationId)).toBeNull();
+  });
+  it("停止及重试都须原生 claim，只有重试确认额度", () => {
+    const state = {
+      ...recoveryContext,
+      claim_id: "native-claim",
+      actions: { withdraw: false, stop: true, retry: true },
+    };
+    expect(poolRecoveryCommand(state, "stop", operationId)?.confirm_cli_quota).toBe(false);
+    expect(poolRecoveryCommand(state, "retry", operationId)?.confirm_cli_quota).toBe(true);
+    expect(poolRecoveryCommand({ ...state, claim_id: "" }, "retry", operationId)).toBeNull();
+  });
+  it("成功结果须绑定同任务、run、claim 和操作，时间来自合法原生回执", () => {
+    const command = poolRecoveryCommand(recoveryContext, "withdraw", operationId)!;
+    const result: PoolRecoveryResult = {
+      task_id: "task",
+      run_id: "run",
+      claim_id: "",
+      operation_id: operationId,
+      action: "withdraw",
+      result: "withdrawn",
+      event_seq: 0,
+      recorded_at: "2026-10-20T01:03:00.123456789Z",
+    };
+    expect(matchesPoolRecoveryResult(result, "task", command)).toBe(true);
+    for (const patch of [
+      { task_id: "other" },
+      { run_id: "other" },
+      { claim_id: "other" },
+      { operation_id: "other" },
+      { event_seq: -1 },
+      { recorded_at: "0" },
+      { result: "stop_requested" },
+    ]) {
+      expect(
+        matchesPoolRecoveryResult({ ...result, ...patch } as PoolRecoveryResult, "task", command),
+      ).toBe(false);
+    }
+  });
+});
diff --git b/apps/web/lib/task-pool-recovery.ts b/apps/web/lib/task-pool-recovery.ts
new file mode 100644
index 0000000..079f033
--- /dev/null
+++ b/apps/web/lib/task-pool-recovery.ts
@@ -0,0 +1,76 @@
+import type {
+  PoolRecoveryAction,
+  PoolRecoveryCommand,
+  PoolRecoveryContext,
+  PoolRecoveryResult,
+} from "./types/task-pool-recovery";
+import { parseTurnTimestamp } from "./state/slices/session/turn-actions";
+
+function identifier(value: unknown, empty = false): value is string {
+  return (
+    typeof value === "string" &&
+    (empty || value.length > 0) &&
+    value.length <= 256 &&
+    value.trim() === value
+  );
+}
+
+export function validPoolRecoveryOperationId(value: unknown): value is string {
+  return (
+    typeof value === "string" &&
+    /^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/.test(value) &&
+    value !== "00000000-0000-0000-0000-000000000000"
+  );
+}
+
+export function poolRecoveryCommand(
+  context: PoolRecoveryContext,
+  action: PoolRecoveryAction,
+  operationId: string,
+): PoolRecoveryCommand | null {
+  if (
+    !context?.actions?.[action] ||
+    !validPoolRecoveryOperationId(operationId) ||
+    !identifier(context.task_id) ||
+    !identifier(context.run_id) ||
+    !identifier(context.claim_id, action === "withdraw") ||
+    !identifier(context.management_version, true) ||
+    !Number.isSafeInteger(context.entry_id) ||
+    context.entry_id <= 0 ||
+    parseTurnTimestamp(context.task_version) === null ||
+    !/^[0-9a-f]{64}$/.test(context.run_version) ||
+    (action === "withdraw" && context.claim_id !== "")
+  )
+    return null;
+  return {
+    action,
+    operation_id: operationId,
+    run_id: context.run_id,
+    expected_claim_id: context.claim_id,
+    expected_task_version: context.task_version,
+    expected_run_version: context.run_version,
+    expected_management_version: context.management_version,
+    confirm: true,
+    confirm_cli_quota: action === "retry",
+  };
+}
+
+export function matchesPoolRecoveryResult(
+  result: PoolRecoveryResult,
+  taskId: string,
+  command: PoolRecoveryCommand,
+): boolean {
+  const outcomes = { withdraw: "withdrawn", stop: "stop_requested", retry: "requeued" };
+  return (
+    !!result &&
+    result.task_id === taskId &&
+    result.run_id === command.run_id &&
+    result.claim_id === command.expected_claim_id &&
+    result.operation_id === command.operation_id &&
+    result.action === command.action &&
+    result.result === outcomes[command.action] &&
+    Number.isSafeInteger(result.event_seq) &&
+    result.event_seq >= 0 &&
+    parseTurnTimestamp(result.recorded_at) !== null
+  );
+}
diff --git b/apps/web/lib/task-pool-release.test.ts b/apps/web/lib/task-pool-release.test.ts
