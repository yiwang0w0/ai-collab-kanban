+	_, _, err = f.publisher.QueuePoolRunAndReturn(ctx, f.task.ID, entry)
+	var busy *runsmodels.PoolTaskBusyError
+	if !errors.As(err, &busy) || busy.RunID != first.ID {
+		t.Fatalf("冲突应指向当前占用运行: %v", err)
+	}
