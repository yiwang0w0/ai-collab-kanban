-	return &keyedRWMutex{locks: make(map[string]*sync.RWMutex)}
-}
-
-func (k *keyedRWMutex) lockFor(key string) *sync.RWMutex {
-	k.mu.Lock()
-	defer k.mu.Unlock()
-	lock, ok := k.locks[key]
-	if !ok {
-		lock = &sync.RWMutex{}
-		k.locks[key] = lock
-	}
-	return lock
-}
