+    }
+    if (/^KANDEV_AGENTCTL_(?:LINUX_BINARY|(?:LINUX|DARWIN)_(?:AMD64|ARM64)_BINARY)$/i.test(key)) {
+      delete cleaned[key];
+    }
+    if (key.toUpperCase() === "PATH") delete cleaned[key];
+  }
+  return cleaned;
