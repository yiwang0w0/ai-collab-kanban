@@ -0,0 +1,76 @@
+package sqlite
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+// HasPoolActivityCandidate 让普通非池流只做原生索引读取，不获得任务写锁。
+func (r *Repository) HasPoolActivityCandidate(ctx context.Context, activity models.PoolExecutionActivity) (bool, error) {
+	var found bool
+	err := r.ro.GetContext(ctx, &found, r.ro.Rebind(`SELECT EXISTS (SELECT 1 FROM runs
+		WHERE agent_profile_id = ? AND status = 'claimed' AND session_id = ? AND idempotency_key LIKE ?)`),
+		activity.AgentProfileID, activity.SessionID, models.PoolDispatchKeyPrefix+"%")
+	return found, err
+}
+
+// AppendPoolActivityTx 在当前领取与已分配执行匹配后，原子追加绑定和首个开工。
+func (r *Repository) AppendPoolActivityTx(ctx context.Context, tx *sqlx.Tx, activity models.PoolExecutionActivity) (*models.RunEvent, error) {
+	allocation, err := r.poolSignalAllocationTx(ctx, tx, activity)
+	if err != nil || allocation == nil {
+		return nil, err
+	}
+	identity, matches := activity.ReceiptIdentity(*allocation)
+	if !matches || !validPoolIdentity(identity) {
+		return nil, ErrPoolReceiptConflict
+	}
+	if err := r.lockPoolClaim(ctx, tx, identity); err != nil {
+		return nil, err
+	}
+	if _, err := r.writePoolReceipt(ctx, tx, identity, ""); err != nil {
+		return nil, err
+	}
+	return r.writePoolReceipt(ctx, tx, identity, activity.StartedSource)
+}
+
+// poolSignalAllocationTx 对所有协议证据使用同一份有界领取和分配核验。
+func (r *Repository) poolSignalAllocationTx(ctx context.Context, tx *sqlx.Tx, activity models.PoolExecutionActivity) (*models.PoolExecutionAllocation, error) {
+	var runs []*models.Run
+	if err := tx.SelectContext(ctx, &runs, tx.Rebind(`SELECT * FROM runs WHERE agent_profile_id = ?
+		AND status = 'claimed' AND session_id = ? AND idempotency_key LIKE ? LIMIT 2`),
+		activity.AgentProfileID, activity.SessionID, models.PoolDispatchKeyPrefix+"%"); err != nil {
+		return nil, err
+	}
+	if len(runs) == 0 {
+		return nil, nil
+	}
+	if len(runs) != 1 {
+		return nil, ErrPoolReceiptUnknown
+	}
+	run := runs[0]
+	claimID, err := currentPoolClaimID(ctx, tx, run)
+	if err != nil {
+		return nil, err
+	}
+	request, err := (&models.ClaimedRun{Run: run, ClaimID: claimID}).PoolStartRequest()
+	if err != nil {
+		return nil, err
+	}
+	if err := requirePoolLaunchAdmissionTx(ctx, tx, request); err != nil {
+		return nil, err
+	}
+	allocated, err := poolClaimEventsTx(ctx, tx, run.ID, claimID, models.PoolExecutionAllocated)
+	if err != nil {
+		return nil, err
+	}
+	var allocation models.PoolExecutionAllocation
+	if len(allocated) != 1 || json.Unmarshal([]byte(allocated[0].Payload), &allocation) != nil ||
+		!allocation.PoolExecutionIdentity.ValidAllocationFor(request) || allocation.SessionID != run.SessionID {
+		return nil, ErrPoolReceiptUnknown
+	}
+	return &allocation, nil
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_claim.go b/apps/backend/internal/runs/repository/sqlite/pool_claim.go
new file mode 100644
index 0000000..e7a774b
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_claim.go
@@ -0,0 +1,53 @@
+package sqlite
+
+import (
+	"context"
+	"strings"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+// ResolveCurrentPoolClaim 只读重建当前领取；未知不意味着可以重新派发。
+func (r *Repository) ResolveCurrentPoolClaim(ctx context.Context, runID string) (*models.ClaimedRun, error) {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return nil, ErrPoolReceiptUnknown
+	}
+	tx, err := r.ro.BeginTxx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = tx.Rollback() }()
+	run, err := r.GetRunByIDTx(ctx, tx, runID)
+	if err != nil {
+		return nil, err
+	}
+	if run.Status != models.RunStatusClaimed || run.IdempotencyKey == nil ||
+		!strings.HasPrefix(*run.IdempotencyKey, models.PoolDispatchKeyPrefix) {
+		return nil, ErrPoolReceiptConflict
+	}
+	claimID, err := currentPoolClaimID(ctx, tx, run)
+	if err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	return &models.ClaimedRun{Run: run, ClaimID: claimID}, nil
+}
+
+func currentPoolClaimID(ctx context.Context, tx *sqlx.Tx, run *models.Run) (string, error) {
+	if run.ClaimedAt == nil {
+		return "", ErrPoolReceiptUnknown
+	}
+	var ids []string
+	if err := tx.SelectContext(ctx, &ids, tx.Rebind(`SELECT id FROM office_launch_ledger WHERE run_id = ? AND claimed_at = ? LIMIT 2`), run.ID, *run.ClaimedAt); err != nil {
+		return "", err
+	}
+	if len(ids) != 1 {
+		return "", ErrPoolReceiptUnknown
+	}
+	return ids[0], nil
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_claim_queue_cause.go b/apps/backend/internal/runs/repository/sqlite/pool_claim_queue_cause.go
new file mode 100644
index 0000000..a930f41
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_claim_queue_cause.go
@@ -0,0 +1,60 @@
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+
+	"github.com/jmoiron/sqlx"
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+func checkPoolClaimQueueCauseTx(ctx context.Context, tx *sqlx.Tx, run *models.Run, request models.PoolClaimStart) error {
+	hasPrior, err := poolHasPriorClaimTx(ctx, tx, run.ID, request.ClaimID)
+	if err != nil {
+		return err
+	}
+	var last models.RunEvent
+	err = tx.GetContext(ctx, &last, tx.Rebind(`SELECT * FROM run_events WHERE run_id=? AND event_type LIKE 'pool.%' ORDER BY seq DESC LIMIT 1`), run.ID)
+	if errors.Is(err, sql.ErrNoRows) && !hasPrior {
+		return nil
+	}
+	if err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return ErrPoolReceiptUnknown
+		}
+		return err
+	}
+	var operation models.PoolRecoveryOperation
+	if !hasPrior || last.EventType != models.PoolRecoveryRequeued || json.Unmarshal([]byte(last.Payload), &operation) != nil {
+		return ErrPoolReceiptUnknown
+	}
+	prior := models.PoolClaimStart{RunID: run.ID, ClaimID: operation.ClaimID, Release: request.Release}
+	if operation.Command.Action != "retry" || !operation.ValidExecutionFor(prior) || operation.ClaimID == request.ClaimID || operation.FinishedSeq >= last.Seq {
+		return ErrPoolReceiptUnknown
+	}
+	if _, err := poolFinishAllocationTx(ctx, tx, run, operation.Execution); err != nil {
+		return err
+	}
+	finished, err := poolClaimEventsTx(ctx, tx, run.ID, operation.ClaimID, models.PoolExecutionFinished)
+	if err != nil {
+		return err
+	}
+	var receipt models.PoolExecutionFinishReceipt
+	if len(finished) != 1 || finished[0].Seq != operation.FinishedSeq || json.Unmarshal([]byte(finished[0].Payload), &receipt) != nil || receipt.PoolExecutionIdentity != operation.Execution {
+		return ErrPoolReceiptUnknown
+	}
+	return nil
+}
+
+// PoolHasPriorClaimTx 只能在同事务原生准入已核对因果回执后用于选择候选资格，不能单独授权重试。
+func (r *Repository) PoolHasPriorClaimTx(ctx context.Context, tx *sqlx.Tx, runID, claimID string) (bool, error) {
+	return poolHasPriorClaimTx(ctx, tx, runID, claimID)
+}
+
+func poolHasPriorClaimTx(ctx context.Context, tx *sqlx.Tx, runID, claimID string) (bool, error) {
+	var prior bool
+	err := tx.GetContext(ctx, &prior, tx.Rebind(`SELECT EXISTS (SELECT 1 FROM office_launch_ledger WHERE run_id=? AND id<>?)`), runID, claimID)
+	return prior, err
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_claim_test.go b/apps/backend/internal/runs/repository/sqlite/pool_claim_test.go
new file mode 100644
index 0000000..e21e052
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_claim_test.go
@@ -0,0 +1,93 @@
+package sqlite_test
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/kandev/kandev/internal/runs/models"
+	runssqlite "github.com/kandev/kandev/internal/runs/repository/sqlite"
+)
+
+type claimWithIdentity interface {
+	ClaimNextEligibleRunWithClaim(context.Context) (*models.ClaimedRun, error)
+}
+
+type currentPoolClaimReader interface {
+	ResolveCurrentPoolClaim(context.Context, string) (*models.ClaimedRun, error)
+}
+
+// @covers AC-TASKS-AGENT-POOL-002.3
+func TestPoolClaimReconstructionRequiresUniqueLedger(t *testing.T) {
+	repo, writer, _, identity := poolReceiptFixture(t)
+	ctx := context.Background()
+	reconstructed := runssqlite.NewWithDB(writer, repo.Reader())
+	reader, ok := any(reconstructed).(currentPoolClaimReader)
+	if !ok {
+		t.Fatal("缺少仅按唯一当前账本重建领取的只读入口")
+	}
+	claim, err := reader.ResolveCurrentPoolClaim(ctx, identity.RunID)
+	if err != nil || claim == nil || claim.ClaimID != identity.ClaimID {
+		t.Fatalf("重建领取 = %+v, %v", claim, err)
+	}
+	if _, err := writer.Exec(`INSERT INTO office_launch_ledger
+		(id, run_id, workspace_id, causation_id, routine_id, human_rooted, claimed_at)
+		SELECT 'ambiguous-claim', run_id, workspace_id, causation_id, routine_id, human_rooted, claimed_at
+		FROM office_launch_ledger WHERE id = ?`, identity.ClaimID); err != nil {
+		t.Fatal(err)
+	}
+	if claim, err := reader.ResolveCurrentPoolClaim(ctx, identity.RunID); !errors.Is(err, runssqlite.ErrPoolReceiptUnknown) || claim != nil {
+		t.Fatalf("多解不得选最大 ID 猜测: %+v, %v", claim, err)
+	}
+	if _, err := writer.Exec(`DELETE FROM office_launch_ledger WHERE run_id = ?`, identity.RunID); err != nil {
+		t.Fatal(err)
+	}
+	if claim, err := reader.ResolveCurrentPoolClaim(ctx, identity.RunID); !errors.Is(err, runssqlite.ErrPoolReceiptUnknown) || claim != nil {
+		t.Fatalf("缺失账本不得补造: %+v, %v", claim, err)
+	}
+	if run := mustGetRun(t, repo, identity.RunID); run.Status != models.RunStatusClaimed || run.ClaimedAt == nil {
+		t.Fatalf("重建查询不得重新派发: %+v", run)
+	}
+}
+
+// @covers AC-TASKS-AGENT-POOL-002.1
+func TestPoolClaimReturnsCommittedLedgerIdentity(t *testing.T) {
+	repo, writer := newTestRepoWithDB(t)
+	claimer, ok := any(repo).(claimWithIdentity)
+	if !ok {
+		t.Fatal("领取入口未返回同事务写入的账本身份")
+	}
+	seedClaimAgent(t, repo, "pool-agent")
+	run := queueRunAt(t, repo, "pool-run", "pool-agent", time.Now().UTC())
+	ctx := context.Background()
+	first, err := claimer.ClaimNextEligibleRunWithClaim(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ledgerID string
+	if err := writer.Get(&ledgerID, `SELECT id FROM office_launch_ledger WHERE run_id = ? AND claimed_at = ?`, run.ID, *first.ClaimedAt); err != nil {
+		t.Fatal(err)
+	}
+	if first.ClaimID == "" || first.ClaimID != ledgerID || first.ID != run.ID {
+		t.Fatalf("领取身份 = %+v，账本 = %q", first, ledgerID)
+	}
+	if changed, err := repo.RequeueClaimedRun(ctx, run.ID); err != nil || !changed {
+		t.Fatalf("重入队 = %v, %v", changed, err)
+	}
+	second, err := claimer.ClaimNextEligibleRunWithClaim(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if second.ClaimID == "" || second.ClaimID == first.ClaimID || second.RetryCount != first.RetryCount {
+		t.Fatalf("新领取必须有不同身份且不依赖重试计数: first=%+v second=%+v", first, second)
+	}
+	var ledgerCount int
+	if err := writer.Get(&ledgerCount, `SELECT COUNT(*) FROM office_launch_ledger WHERE run_id = ?`, run.ID); err != nil || ledgerCount != 2 {
+		t.Fatalf("历史领取数 = %d, %v", ledgerCount, err)
+	}
+	if empty, err := claimer.ClaimNextEligibleRunWithClaim(ctx); !errors.Is(err, sql.ErrNoRows) || empty != nil {
+		t.Fatalf("无资格工作时不得返回账本身份: %+v, %v", empty, err)
+	}
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_event_namespace_test.go b/apps/backend/internal/runs/repository/sqlite/pool_event_namespace_test.go
new file mode 100644
index 0000000..4108035
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_event_namespace_test.go
@@ -0,0 +1,41 @@
+package sqlite_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+// @covers AC-TASKS-AGENT-POOL-002.1 AC-TASKS-AGENT-POOL-002.2
+func TestPoolEvidenceCannotBeWrittenThroughGenericRunEvents(t *testing.T) {
+	repo, _, receipts, identity := poolReceiptFixture(t)
+	ctx := context.Background()
+	mustCreateRun(t, repo, &models.Run{ID: "ordinary-event-run", AgentProfileID: identity.AgentProfileID,
+		WorkspaceID: claimTestWorkspace(identity.AgentProfileID), Status: models.RunStatusQueued, Payload: "{}"})
+	for _, runID := range []string{identity.RunID, "ordinary-event-run"} {
+		for _, kind := range []string{models.PoolLaunchAdmitted, models.PoolExecutionBound, models.PoolWorkObserved, "pool.future-proof.v2"} {
+			event, err := repo.AppendRunEvent(ctx, runID, kind, "info", `{"forged":true}`)
+			if !errors.Is(err, models.ErrReservedPoolEventType) || event != nil {
+				t.Fatalf("普通事件入口不能签发宿主池证据: run=%s type=%s event=%+v err=%v", runID, kind, event, err)
+			}
+		}
+		events, err := repo.ListRunEvents(ctx, runID, -1, 10)
+		if err != nil || len(events) != 0 {
+			t.Fatalf("被拒绝的保留事件不能持久化: events=%+v err=%v", events, err)
+		}
+		ordinary, err := repo.AppendRunEvent(ctx, runID, "step", "", `{"event_type":"pool.work-observed.v1"}`)
+		if err != nil || ordinary == nil || ordinary.EventType != "step" || ordinary.Seq != 0 {
+			t.Fatalf("普通事件及原序号不能被池命名空间门禁改变: %+v %v", ordinary, err)
+		}
+	}
+	bound, err := receipts.AppendPoolExecutionBinding(ctx, identity)
+	if err != nil || bound.Seq != 1 {
+		t.Fatalf("专用宿主绑定方法仍应工作: %+v %v", bound, err)
+	}
+	work, err := receipts.AppendPoolWorkObserved(ctx, identity, models.PoolStartTool)
+	if err != nil || work.Seq != 2 {
+		t.Fatalf("专用宿主工作回执仍应工作: %+v %v", work, err)
+	}
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_execution_allocation.go b/apps/backend/internal/runs/repository/sqlite/pool_execution_allocation.go
new file mode 100644
index 0000000..2643af4
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_execution_allocation.go
@@ -0,0 +1,77 @@
+package sqlite
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+// AppendPoolExecutionAllocationTx 与任务原生校验共享同一事务；记录不等于工作活动。
+func (r *Repository) AppendPoolExecutionAllocationTx(ctx context.Context, tx *sqlx.Tx, request models.PoolClaimStart, allocation models.PoolExecutionAllocation) (*models.RunEvent, error) {
+	identity := allocation.PoolExecutionIdentity
+	if !identity.ValidAllocationFor(request) || allocation.AgentType == "" {
+		return nil, models.ErrPoolClaimStartConflict
+	}
+	if err := r.lockPoolClaim(ctx, tx, identity); err != nil {
+		return nil, err
+	}
+	run, err := r.GetRunByIDTx(ctx, tx, request.RunID)
+	if err != nil {
+		return nil, err
+	}
+	if !request.Release.MatchesRun(run) {
+		return nil, models.ErrPoolClaimStartConflict
+	}
+	if err := requirePoolLaunchAdmissionTx(ctx, tx, request); err != nil {
+		return nil, err
+	}
+	previous, err := poolClaimEventsTx(ctx, tx, identity.RunID, identity.ClaimID, models.PoolExecutionAllocated)
+	if err != nil {
+		return nil, err
+	}
+	if len(previous) == 1 {
+		var stored models.PoolExecutionAllocation
+		if json.Unmarshal([]byte(previous[0].Payload), &stored) != nil || stored != allocation || run.SessionID != identity.SessionID {
+			return nil, ErrPoolReceiptConflict
+		}
+		return &previous[0], nil
+	}
+	if run.SessionID != "" {
+		return nil, ErrPoolReceiptConflict
+	}
+	encoded, err := json.Marshal(allocation)
+	if err != nil {
+		return nil, err
+	}
+	if _, err := tx.ExecContext(ctx, tx.Rebind(`UPDATE runs SET session_id = ? WHERE id = ?`), identity.SessionID, identity.RunID); err != nil {
+		return nil, err
+	}
+	return insertPoolEvent(ctx, tx, identity.RunID, models.PoolExecutionAllocated, string(encoded))
+}
+
+func requirePoolLaunchAdmissionTx(ctx context.Context, tx *sqlx.Tx, request models.PoolClaimStart) error {
+	events, err := poolClaimEventsTx(ctx, tx, request.RunID, request.ClaimID, models.PoolLaunchAdmitted)
+	if err != nil {
+		return err
+	}
+	var stored models.PoolClaimStart
+	if len(events) != 1 || json.Unmarshal([]byte(events[0].Payload), &stored) != nil || stored != request {
+		return ErrPoolReceiptUnknown
+	}
+	return nil
+}
+
+func poolClaimEventsTx(ctx context.Context, tx *sqlx.Tx, runID, claimID, kind string) ([]models.RunEvent, error) {
+	var events []models.RunEvent
+	if err := tx.SelectContext(ctx, &events, tx.Rebind(`SELECT * FROM run_events WHERE run_id = ? AND event_type = ?
+		AND json_extract(payload, '$.claim_id') = ? ORDER BY seq LIMIT 2`), runID, kind, claimID); err != nil {
+		return nil, err
+	}
+	if len(events) > 1 {
+		return nil, ErrPoolReceiptUnknown
+	}
+	return events, nil
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_execution_finish.go b/apps/backend/internal/runs/repository/sqlite/pool_execution_finish.go
new file mode 100644
index 0000000..016e2f0
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_execution_finish.go
@@ -0,0 +1,68 @@
+package sqlite
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+// FinalizeStoppedPoolRunTx 仅供持有原生资源与任务屏障的服务调用；当前领取和全部持久证据仍在此重查。
+func (r *Repository) FinalizeStoppedPoolRunTx(ctx context.Context, tx *sqlx.Tx, identity models.PoolExecutionIdentity) (*models.RunEvent, error) {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return nil, models.ErrPoolAdmissionUnavailable
+	}
+	if err := r.LockPoolTaskTx(ctx, tx, identity.TaskID); err != nil {
+		return nil, err
+	}
+	run, stopped, err := r.poolFinishEvidenceTx(ctx, tx, identity)
+	if err != nil {
+		return nil, err
+	}
+	receipt := models.PoolExecutionFinishReceipt{PoolExecutionIdentity: identity, StoppedSeq: stopped.Seq}
+	previous, err := poolClaimEventsTx(ctx, tx, identity.RunID, identity.ClaimID, models.PoolExecutionFinished)
+	if err != nil {
+		return nil, err
+	}
+	if len(previous) == 1 {
+		return replayPoolExecutionFinish(run, previous[0], receipt)
+	}
+	if run.Status != models.RunStatusClaimed || run.FinishedAt != nil || run.Outcome != nil {
+		return nil, ErrPoolReceiptConflict
+	}
+	encoded, err := json.Marshal(receipt)
+	if err != nil {
+		return nil, err
+	}
+	event, err := insertPoolEvent(ctx, tx, identity.RunID, models.PoolExecutionFinished, string(encoded))
+	if err != nil {
+		return nil, err
+	}
+	result, err := tx.ExecContext(ctx, tx.Rebind(`UPDATE runs SET status='finished',outcome=?,finished_at=?
+		WHERE id=? AND status='claimed' AND claimed_at=? AND session_id=?`),
+		models.PoolOutcomeExecutionStopped, event.CreatedAt, identity.RunID, *run.ClaimedAt, identity.SessionID)
+	if err != nil {
+		return nil, err
+	}
+	count, err := result.RowsAffected()
+	if err != nil {
+		return nil, err
+	}
+	if count != 1 {
+		return nil, ErrPoolReceiptConflict
+	}
+	return event, nil
+}
+
+func replayPoolExecutionFinish(run *models.Run, event models.RunEvent, expected models.PoolExecutionFinishReceipt) (*models.RunEvent, error) {
+	var stored models.PoolExecutionFinishReceipt
+	if json.Unmarshal([]byte(event.Payload), &stored) != nil || stored != expected ||
+		run.Status != models.RunStatusFinished || run.FinishedAt == nil || !run.FinishedAt.Equal(event.CreatedAt) ||
+		run.Outcome == nil || *run.Outcome != models.PoolOutcomeExecutionStopped {
+		return nil, ErrPoolReceiptConflict
+	}
+	return &event, nil
+}
diff --git b/apps/backend/internal/runs/repository/sqlite/pool_execution_finish_evidence.go b/apps/backend/internal/runs/repository/sqlite/pool_execution_finish_evidence.go
new file mode 100644
index 0000000..4b6ef89
--- /dev/null
+++ b/apps/backend/internal/runs/repository/sqlite/pool_execution_finish_evidence.go
@@ -0,0 +1,70 @@
+package sqlite
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/jmoiron/sqlx"
+
+	"github.com/kandev/kandev/internal/runs/models"
+)
+
+func (r *Repository) poolFinishEvidenceTx(ctx context.Context, tx *sqlx.Tx, identity models.PoolExecutionIdentity) (*models.Run, *models.RunEvent, error) {
+	run, err := r.GetRunByIDTx(ctx, tx, identity.RunID)
+	if err != nil {
+		return nil, nil, err
+	}
+	if run.Status != models.RunStatusClaimed && run.Status != models.RunStatusFinished || run.SessionID != identity.SessionID {
+		return nil, nil, ErrPoolReceiptConflict
+	}
+	claimID, err := currentPoolClaimID(ctx, tx, run)
+	if err != nil {
+		return nil, nil, err
+	}
+	if claimID != identity.ClaimID {
+		return nil, nil, ErrPoolReceiptConflict
+	}
+	allocation, err := poolFinishAllocationTx(ctx, tx, run, identity)
+	if err != nil {
+		return nil, nil, err
+	}
+	stopped, err := poolClaimEventsTx(ctx, tx, identity.RunID, identity.ClaimID, models.PoolExecutionStopped)
+	if err != nil {
+		return nil, nil, err
+	}
+	var receipt models.PoolExecutionStopReceipt
+	if len(stopped) != 1 || json.Unmarshal([]byte(stopped[0].Payload), &receipt) != nil {
+		return nil, nil, ErrPoolReceiptUnknown
+	}
+	activity := models.PoolExecutionActivity{TaskID: identity.TaskID, AgentProfileID: identity.AgentProfileID,
+		SessionID: identity.SessionID, ExecutionID: identity.ExecutionID, TurnID: identity.TurnID,
+		PromptGeneration: identity.PromptGeneration, AgentType: allocation.AgentType}
+	expected, trusted := activity.StoppedReceipt(*allocation, receipt.Source, receipt.RuntimeInstanceID, true)
+	if !trusted || receipt != expected {
+		return nil, nil, ErrPoolReceiptUnknown
+	}
+	return run, &stopped[0], nil
+}
+
+func poolFinishAllocationTx(ctx context.Context, tx *sqlx.Tx, run *models.Run, identity models.PoolExecutionIdentity) (*models.PoolExecutionAllocation, error) {
+	intents, err := poolClaimEventsTx(ctx, tx, identity.RunID, identity.ClaimID, models.PoolLaunchAdmitted)
+	if err != nil {
+		return nil, err
+	}
+	var request models.PoolClaimStart
+	if len(intents) != 1 || json.Unmarshal([]byte(intents[0].Payload), &request) != nil ||
+		request.RunID != identity.RunID || request.ClaimID != identity.ClaimID ||
+		!request.Release.MatchesRun(run) || !identity.ValidAllocationFor(request) {
+		return nil, ErrPoolReceiptUnknown
+	}
+	allocations, err := poolClaimEventsTx(ctx, tx, identity.RunID, identity.ClaimID, models.PoolExecutionAllocated)
+	if err != nil {
+		return nil, err
+	}
+	var allocation models.PoolExecutionAllocation
+	if len(allocations) != 1 || json.Unmarshal([]byte(allocations[0].Payload), &allocation) != nil ||
+		allocation.PoolExecutionIdentity != identity || allocation.AgentType == "" {
+		return nil, ErrPoolReceiptUnknown
+	}
+	return &allocation, nil
+}
