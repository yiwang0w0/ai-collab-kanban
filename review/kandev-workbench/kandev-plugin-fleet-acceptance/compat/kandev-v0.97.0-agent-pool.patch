+	require.NoError(t, err)
+	loaded, err := svc.GetTaskStatusSummaries(f.ctx, []string{task.ID})
+	require.NoError(t, err)
+	summaries, err := svc.ReconcileTaskStatusSummaries(f.ctx, []*models.Task{task}, nil, nil, loaded)
