+// @covers AC-TASKS-AGENT-POOL-002.3 AC-TASKS-AGENT-POOL-004.3
+func TestPoolProjectionHTTPDoesNotLoseUnfinishedClaimWhenNativeStageChanges(t *testing.T) {
