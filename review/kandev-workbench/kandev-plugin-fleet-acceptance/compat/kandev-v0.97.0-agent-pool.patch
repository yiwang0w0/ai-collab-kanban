+				t.Fatalf("不能把前置未完成、缺失或已归档解释为无依赖: %s %+v %v", outcome, run, err)
+			}
+			var edges int
+			if err := f.runs.Reader().Get(&edges, `SELECT COUNT(*) FROM task_blockers WHERE task_id = ?`, f.task.ID); err != nil || edges != 1 {
+				t.Fatalf("读取资格不得删除依赖边: %d %v", edges, err)
+			}
+		})
+	}
