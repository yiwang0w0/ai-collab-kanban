-func failingLaunchRepositoryIdentity(
-	req *LaunchAgentRequest,
-	launchErr error,
-) (repositoryID, taskRepositoryID string) {
-	if req == nil {
-		return "", ""
-	}
-	if len(req.Repositories) == 0 {
-		return req.RepositoryID, req.TaskRepositoryID
