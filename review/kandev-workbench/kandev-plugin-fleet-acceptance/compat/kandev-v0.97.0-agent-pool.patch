-				break
-			}
-		}
-		var sessionCount *int
-		if n := len(sessions); n > 0 {
-			sessionCount = &n
-		}
-		si := extractSessionInfo(primarySessionInfoMap[task.ID])
-		taskDTO := dto.FromTaskWithSessionInfo(
-			task,
-			primarySessionID,
-			sessionCount,
-			si.reviewStatus,
-			si.executorID,
-			si.executorProfileID,
-			si.executorType,
-			si.executorName,
-			si.agentName,
-			si.agentProfileID,
