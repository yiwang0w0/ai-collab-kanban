+		{"token_not_human_confirmation", func(ctx context.Context, _ *models.PoolReleaseIntent) context.Context {
+			return authn.WithIdentity(ctx, authn.Identity{UserID: "pool-human", TokenID: "pat", Role: authn.RoleAdmin})
