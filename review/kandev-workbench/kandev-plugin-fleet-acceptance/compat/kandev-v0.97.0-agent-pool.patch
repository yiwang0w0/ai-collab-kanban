+package sqlite_test
+
+import (
+	"context"
+	"testing"
+
+	officesqlite "github.com/kandev/kandev/internal/office/repository/sqlite"
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+	tasksqlite "github.com/kandev/kandev/internal/task/repository/sqlite"
+	"github.com/kandev/kandev/internal/testutil"
+	"github.com/stretchr/testify/require"
+)
+
+// @covers AC-TASKS-AGENT-POOL-002.3 AC-TASKS-AGENT-POOL-005.2
+func TestPoolFailureMutationIsolation(t *testing.T) {
+	assertPoolFailureMutationIsolation(t, newTestRepo(t))
+}
+
+func TestPoolFailureMutationIsolationPostgres(t *testing.T) {
+	db := testutil.OpenIsolatedPostgres(t, testutil.PostgresDSNFromEnv(t))
+	_, err := tasksqlite.NewWithDB(db, db, nil)
+	require.NoError(t, err)
+	repo, err := officesqlite.NewWithDB(db, db, nil)
+	require.NoError(t, err)
+	assertPoolFailureMutationIsolation(t, repo)
+}
+
+func assertPoolFailureMutationIsolation(t *testing.T, repo *officesqlite.Repository) {
+	t.Helper()
+	ctx := context.Background()
+	for _, suffix := range []string{"entry", ""} {
+		key := runsmodels.PoolDispatchKeyPrefix + suffix
+		run := &runsmodels.Run{ID: "pool-failure-" + suffix, AgentProfileID: "fixed-cli",
+			Status: runsmodels.RunStatusClaimed, SessionID: "bound-session", IdempotencyKey: &key}
+		require.NoError(t, repo.CreateRun(ctx, run))
+		before, err := repo.GetRun(ctx, run.ID)
+		require.NoError(t, err)
+		wrote, err := repo.MarkRunFailed(ctx, run.ID, "late-unfenced-failure")
+		require.NoError(t, err)
+		require.False(t, wrote, "通用失败不能替代池的身份与停止核验")
+		after, err := repo.GetRun(ctx, run.ID)
+		require.NoError(t, err)
+		require.Equal(t, before, after)
+	}
+	ordinary := &runsmodels.Run{ID: "ordinary-failure", AgentProfileID: "ordinary-cli", Status: runsmodels.RunStatusClaimed}
+	require.NoError(t, repo.CreateRun(ctx, ordinary))
+	wrote, err := repo.MarkRunFailed(ctx, ordinary.ID, "ordinary-failure")
+	require.NoError(t, err)
+	require.True(t, wrote, "同一入口必须仍能记录普通运行失败")
+}
diff --git b/apps/backend/internal/office/repository/sqlite/pool_history_schema.go b/apps/backend/internal/office/repository/sqlite/pool_history_schema.go
new file mode 100644
index 0000000..e2c1ffe
--- /dev/null
+++ b/apps/backend/internal/office/repository/sqlite/pool_history_schema.go
@@ -0,0 +1,46 @@
+package sqlite
+
+import (
+	"context"
+	"time"
+
+	"github.com/kandev/kandev/internal/db/dialect"
+)
+
+// migratePoolHistorySchema 由既有 schema 所有者原子安装，不在迁移时猜测已丢失的历史。
+func (r *Repository) migratePoolHistorySchema() error {
+	if dialect.IsPostgres(r.db.DriverName()) {
+		return nil
+	}
+	tx, err := r.db.BeginTxx(context.Background(), nil)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = tx.Rollback() }()
+	for _, statement := range []string{
+		`CREATE TABLE IF NOT EXISTS run_pool_history_clearances (
+			dispatch_key TEXT PRIMARY KEY,
+			run_id TEXT NOT NULL UNIQUE,
+			format_version INTEGER NOT NULL CHECK(format_version=1),
+			workspace_id TEXT NOT NULL,
+			task_id TEXT NOT NULL,
+			entry_id INTEGER NOT NULL,
+			release_json TEXT NOT NULL,
+			requested_at TIMESTAMP NOT NULL,
+			cleared_at TIMESTAMP NOT NULL
+		)`,
+		`CREATE TABLE IF NOT EXISTS run_pool_history_policy (
+			version INTEGER PRIMARY KEY CHECK(version=1),
+			activated_at TIMESTAMP NOT NULL
+		)`,
+	} {
+		if _, err := tx.Exec(statement); err != nil {
+			return err
+		}
+	}
+	if _, err := tx.Exec(tx.Rebind(`INSERT INTO run_pool_history_policy(version,activated_at)
+		VALUES(1,?) ON CONFLICT(version) DO NOTHING`), time.Now().UTC()); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
diff --git b/apps/backend/internal/office/repository/sqlite/pool_routing_isolation_test.go b/apps/backend/internal/office/repository/sqlite/pool_routing_isolation_test.go
new file mode 100644
index 0000000..47323f0
--- /dev/null
+++ b/apps/backend/internal/office/repository/sqlite/pool_routing_isolation_test.go
@@ -0,0 +1,72 @@
+package sqlite_test
+
+import (
+	"context"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/kandev/kandev/internal/office/repository/sqlite"
+	runsmodels "github.com/kandev/kandev/internal/runs/models"
+)
+
+// @covers AC-TASKS-AGENT-POOL-005.2 AC-TASKS-AGENT-POOL-002.3
+func TestPoolRoutingRecoveryIsolation(t *testing.T) {
+	for _, action := range []string{"park", "next-candidate", "workspace-unpark"} {
+		for _, key := range []string{"", "office:pool-dispatch:v1:ordinary", runsmodels.PoolDispatchKeyPrefix, runsmodels.PoolDispatchKeyPrefix + "entry"} {
+			t.Run(action+"/"+key, func(t *testing.T) {
+				repo, db := newTestRepoWithDB(t)
+				seedAgentProfile(t, db, "profile", "workspace")
+				run := &runsmodels.Run{ID: "run", AgentProfileID: "profile", Reason: "task_assigned",
+					Payload: `{}`, Status: "claimed", SessionID: "original-session", CoalescedCount: 1}
+				if key != "" {
+					run.IdempotencyKey = &key
+				}
+				ctx := context.Background()
+				if err := repo.CreateRun(ctx, run); err != nil {
+					t.Fatal(err)
+				}
+				claimed := time.Date(2026, 10, 20, 1, 0, 0, 0, time.UTC)
+				if _, err := db.Exec(`UPDATE runs SET claimed_at=?, routing_blocked_status='waiting_for_provider_capacity', earliest_retry_at=?, scheduled_retry_at=? WHERE id=?`,
+					claimed, claimed.Add(time.Hour), claimed.Add(time.Hour), run.ID); err != nil {
+					t.Fatal(err)
+				}
+				before, err := repo.GetRunByID(ctx, run.ID)
+				if err != nil {
+					t.Fatal(err)
+				}
+				applyPoolRoutingAction(t, repo, action, claimed.Add(2*time.Hour))
+				after, err := repo.GetRunByID(ctx, run.ID)
+				if err != nil {
+					t.Fatal(err)
+				}
+				protected := key == runsmodels.PoolDispatchKeyPrefix || key == runsmodels.PoolDispatchKeyPrefix+"entry"
+				if protected && !reflect.DeepEqual(before, after) {
+					t.Fatalf("旧路由 %s 不得重排池领取：before=%+v after=%+v", action, before, after)
+				}
+				if !protected && (after.Status != "queued" || reflect.DeepEqual(before, after)) {
+					t.Fatalf("相同入口应继续重排普通运行：%+v", after)
+				}
+			})
+		}
+	}
+}
+
+func applyPoolRoutingAction(t *testing.T, repo *sqlite.Repository, action string, retryAt time.Time) {
+	t.Helper()
+	ctx := context.Background()
+	var err error
+	switch action {
+	case "park":
+		err = repo.ParkRunForProviderCapacity(ctx, "run", "provider_degraded", retryAt)
+	case "next-candidate":
+		err = repo.RequeueRunForNextCandidate(ctx, "run")
+	case "workspace-unpark":
+		err = repo.ClearAllParkedRoutingForWorkspace(ctx, "workspace")
+	default:
+		t.Fatalf("未知路由动作：%s", action)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+}
