+// The home page's words outside the browser. The panel keeps them in one pure block of
+// core/panel.html, between the home-model markers — no DOM, no globals, no clock; tests/hometest.mjs
+// runs it the same way. cli/status.mjs slices that block out, so the terminal says exactly what the
+// home page says (same alerts, same merging, same next steps) and there is one copy of the words.
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { CODE_ROOT } from "./env.mjs";
+
+const B0 = "// ── home-model(pure;tests/hometest.mjs)──", B1 = "// ── /home-model ──";
+export function loadHomeModel(file = join(CODE_ROOT, "core", "panel.html")) {
+  const src = readFileSync(file, "utf8"), a = src.indexOf(B0), b = src.indexOf(B1);
+  if (a < 0 || b < a) throw new Error(`${file} 里找不到首页模型(home-model 标记)`);
+  return new Function(src.slice(src.indexOf("\n", a) + 1, b) + ";return { homeStatus, homeName };")();
+}
