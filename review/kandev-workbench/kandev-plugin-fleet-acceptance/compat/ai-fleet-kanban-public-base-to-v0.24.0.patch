+// Optional sign-in start for the board on Windows (cli/autostart.mjs). One Task Scheduler task of
+// the operator's own account — no administrator rights, no service — that runs exactly
+// `node cli/start.mjs --background` from this folder 30 s after the operator signs in. With the board
+// already answering, start --background does nothing; the board keeps its tasks and results either
+// way. Same task shape as the node bundle (core/node-startup.mjs): logon trigger for this user,
+// interactive token, least privilege, never a second instance.
+import { spawnSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { join } from "node:path";
+import { CODE_ROOT } from "./env.mjs";
